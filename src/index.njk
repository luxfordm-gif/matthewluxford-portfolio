}
.phone__screen{
  width:100%;height:100%;border-radius:26px;
  padding:30px 14px 14px;display:flex;flex-direction:column;gap:8px;
  background:linear-gradient(180deg,#fff,#f8f8f5);
}
.phone__screen.dk{background:linear-gradient(180deg,#1a1a1a,#0a0a0a);color:#fff}
.phone__screen.dk .mock-line{background:#27272a}
.phone__screen.dk .mock-line.d{background:#fff}

.proj__caption{
  display:flex;justify-content:space-between;align-items:baseline;
  gap:1rem;padding:0 .25rem;
}
.proj__name{
