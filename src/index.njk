  }
  /* lead sits closer to the title and is bigger so it breaks up the body */
  .about__intro{
    margin-bottom:clamp(2.25rem,6vw,3.5rem);
    gap:clamp(1.25rem,4vw,2rem);
  }
  .about__lead{
    font-size:clamp(1.4rem,1rem + 1.6vw,1.7rem);
