<script>
(() => {
  // pagination dots for the work rail (mobile)
  const workRail = document.querySelector(".work__rail");
  const workDots = document.querySelector(".work__dots");
  if (workRail && workDots) {
    const projs = [...workRail.querySelectorAll(".proj")];
    projs.forEach((_, i) => {
      const b = document.createElement("button");
      b.className = "work__dot";
      b.type = "button";
      b.setAttribute("aria-label", `Go to slide ${i + 1}`);
      b.addEventListener("click", () => {
        projs[i]?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
      });
      workDots.appendChild(b);
    });
    const dots = [...workDots.querySelectorAll(".work__dot")];
    const updateDots = () => {
      const r = workRail.getBoundingClientRect();
      const center = r.left + r.width / 2;
      let best = 0, dist = Infinity;
      projs.forEach((p, i) => {
        const pr = p.getBoundingClientRect();
        const d = Math.abs(pr.left + pr.width / 2 - center);
        if (d < dist) { dist = d; best = i; }
      });
      dots.forEach((d, i) => d.classList.toggle("is-active", i === best));
    };
    workRail.addEventListener("scroll", updateDots, { passive: true });
    window.addEventListener("resize", updateDots);
    updateDots();
  }

  // prev/next arrows for the work rail (desktop) — elastic, staggered step.
  // Drag, wheel and touch scrolling keep their native scroll-snap behaviour;
  // only the arrow buttons trigger the spring/lag animation.
  const prevBtn = document.querySelector(".work__arrow--prev");
  const nextBtn = document.querySelector(".work__arrow--next");
  if (workRail && prevBtn && nextBtn) {
    const projsForArrows = [...workRail.querySelectorAll(".proj")];
    const mqElastic = window.matchMedia("(min-width: 761px) and (prefers-reduced-motion: no-preference)");
    let busy = false;

    const stepSize = () => {
      const card = workRail.querySelector(".proj");
      if (!card) return 0;
      const style = getComputedStyle(workRail);
      const gap = parseFloat(style.columnGap || style.gap || "0") || 0;
      return card.getBoundingClientRect().width + gap;
    };

    let updateArrows;

    const elasticStep = async (dir) => {
      if (busy) return;
      const step = stepSize();
      if (!step) return;

      // Reduced motion or below the desktop breakpoint → native smooth scroll.
      if (!mqElastic.matches) {
        workRail.scrollBy({ left: dir * step, behavior: "smooth" });
        return;
      }

      // Only animate cards in (or just outside) the viewport — they're the
      // ones the eye sees moving. Off-screen cards stay put and reappear
      // correctly once scrollLeft is committed at the end.
      const railRect = workRail.getBoundingClientRect();
      const active = projsForArrows.filter((p) => {
        const r = p.getBoundingClientRect();
        return r.right > railRect.left - step && r.left < railRect.right + step;
      });
      if (!active.length) {
        workRail.scrollBy({ left: dir * step, behavior: "smooth" });
        return;
      }

      busy = true;

      const STAGGER = 45;
      const DURATION = 520;
      const EASE = "cubic-bezier(.22, .9, .32, 1.08)";

      // Capture target snap index from the *current* (pre-animation) scroll
      // position, and freeze snapping for the duration of the animation.
      // With scroll-snap-type: x mandatory, Chrome re-snaps to whichever
      // card's transformed start-edge is closest to the rail's start, so a
      // -step translate on every visible card drags scrollLeft backwards by
      // ~one step mid-animation. (First click stays at 0 because scrollLeft
      // can't go negative, which masked the bug.) Removing snap during the
      // animation lets scrollLeft stay put until we commit it ourselves.
      const beforeIdx = Math.round(workRail.scrollLeft / step);
      const targetIdx = Math.max(0, Math.min(projsForArrows.length - 1, beforeIdx + dir));
      // Clamp the target to what the rail can actually scroll to. At the
      // right edge the last "step" is smaller than `step` (cards' overflow
      // is less than a full card-width), so animating by a full -step would
      // slide cards past the real landing point and reveal an empty gap.
      const maxScroll = Math.max(0, workRail.scrollWidth - workRail.clientWidth);
      const targetScroll = Math.max(0, Math.min(maxScroll, targetIdx * step));
      const delta = targetScroll - workRail.scrollLeft;
      if (!delta) { busy = false; return; }
      const prevSnap = workRail.style.scrollSnapType;
      workRail.style.scrollSnapType = "none";

      // Belt-and-braces: cancel any leftover finished animations from a
      // previous step that may still be holding a fill on these cards.
      active.forEach((el) => {
        el.getAnimations().forEach((a) => {
          if (a.id === "work-rail-step") a.cancel();
        });
      });

      // WAAPI gives us a per-card `finished` promise, so we commit
      // scrollLeft exactly when the last card lands — no setTimeout slop,
      // no forced reflow, and no will-change toggling (which was creating
      // and destroying compositor layers on every click).
      const animations = active.map((el, i) => {
        // dir > 0 (next): rightmost card leads, leftmost lags behind.
        // dir < 0 (prev): leftmost leads, rightmost lags.
        const order = dir > 0 ? active.length - 1 - i : i;
        const anim = el.animate(
          [
            { transform: "translate3d(0,0,0)" },
            { transform: `translate3d(${-delta}px, 0, 0)` },
          ],
          {
            duration: DURATION,
            delay: order * STAGGER,
            easing: EASE,
            fill: "forwards",
          }
        );
        anim.id = "work-rail-step";
        return anim;
      });

      try {
        await Promise.all(animations.map((a) => a.finished));
      } catch (e) {
        /* a cancel raced in — fall through to cleanup */
      }

      // Commit scrollLeft and drop the fill in the same task so the next
      // frame paints the final state directly — no "untranslated + old
      // scrollLeft" flash in between. Restore snap after, so drag/wheel/
      // touch scrolling still gets the mandatory-snap feel.
      workRail.scrollLeft = targetScroll;
      animations.forEach((a) => a.cancel());
      workRail.style.scrollSnapType = prevSnap;

      busy = false;
      updateArrows();
    };

    prevBtn.addEventListener("click", () => elasticStep(-1));
    nextBtn.addEventListener("click", () => elasticStep(1));

    updateArrows = () => {
      if (busy) return;
      const atStart = workRail.scrollLeft <= 1;
      const atEnd = workRail.scrollLeft + workRail.clientWidth >= workRail.scrollWidth - 1;
      prevBtn.toggleAttribute("disabled", atStart);
      nextBtn.toggleAttribute("disabled", atEnd);
    };
    workRail.addEventListener("scroll", updateArrows, { passive: true });
    window.addEventListener("resize", updateArrows);
    updateArrows();
  }

  // drag-to-scroll on the work rail
  // (vertical wheel is left alone so it scrolls the page; trackpad horizontal swipes
  //  and shift+wheel still scroll the rail natively.)
  document.querySelectorAll(".work__rail").forEach((rail) => {
    let down = false, sx = 0, sl = 0, moved = false;
    rail.addEventListener("pointerdown", (e) => {
      if (e.target.closest("a,button")) { /* allow link clicks */ }
      down = true; moved = false; sx = e.clientX; sl = rail.scrollLeft;
      rail.style.cursor = "grabbing";
    });
    rail.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 4) moved = true;
      rail.scrollLeft = sl - dx;
    });
    rail.addEventListener("click", (e) => {
      if (moved) { e.preventDefault(); e.stopPropagation(); }
    }, true);
    const up = () => { down = false; rail.style.cursor = ""; };
    rail.addEventListener("pointerup", up);
    rail.addEventListener("pointercancel", up);
    rail.addEventListener("pointerleave", up);
  });

  // nav: hide on scroll-down, show w/ blur on scroll-up
  const nav = document.querySelector(".nav");
  const darkZones = [...document.querySelectorAll("[data-nav-dark]")];
  let lastY = window.scrollY, ticking = false;

  // Jumping to an in-page anchor moves the page down, which the delta check
  // below would read as a scroll-down and hide the nav — right after the user
  // reached for it. Hold it visible until the jump settles; it should only
  // hide when the user scrolls down themselves.
  let anchorHold = 0;
  // Same deal arriving from another page (a case study's nav links point at
  // index.html#work): the browser's jump to the hash would read as a
  // scroll-down and hide the nav the moment the page opens.
  if (location.hash && document.querySelector(location.hash)) {
    anchorHold = performance.now() + 900;
  }
  document.addEventListener("click", (e) => {
    const link = e.target.closest?.('a[href*="#"]');
    if (!link) return;
    const url = new URL(link.getAttribute("href"), location.href);
    if (url.pathname !== location.pathname || !url.hash) return;
    if (!document.querySelector(url.hash)) return;
    anchorHold = performance.now() + 900;
  });

  // while the phone timeline is pinned to the screen, scrolling up is
  // travelling forward through the years, not reaching for the nav, and the
  // nav coming back would shove the timeline down: keep it away until the
  // timeline lets go of the screen
  const tlHoldsScreen = () => {
    const tl = document.querySelector(".tl.is-pinned");
    if (!tl) return false;
    const r = tl.getBoundingClientRect();
    return r.top <= 1 && r.bottom >= innerHeight - 1;
  };
  const updateNav = () => {
    const y = window.scrollY;
    const delta = y - lastY;
    const holding = performance.now() < anchorHold;
    if (y < 24) {
      nav.classList.remove("is-floating", "is-hidden");
      nav.classList.add("is-pinned");
    } else if ((delta > 6 || tlHoldsScreen()) && !holding) {
      nav.classList.add("is-hidden");
      nav.classList.remove("is-floating", "is-pinned");
    } else if (delta < -6 || holding) {
      nav.classList.remove("is-hidden", "is-pinned");
      nav.classList.add("is-floating");
    }
    // invert the bar wherever it overlaps a dark section
    const probe = nav.getBoundingClientRect().bottom - 2;
    nav.classList.toggle("is-on-dark", darkZones.some((z) => {
      const r = z.getBoundingClientRect();
      return r.top <= probe && r.bottom >= probe;
    }));
    lastY = y;
    ticking = false;
  };
  window.addEventListener("scroll", () => {
    if (!ticking) { requestAnimationFrame(updateNav); ticking = true; }
  }, { passive: true });
  updateNav();

  // active nav underline
  const links = document.querySelectorAll(".nav__links a");
  const sections = [...links].map((a) => document.querySelector(a.getAttribute("href")));
  const setActive = () => {
    const y = window.scrollY + 140;
    let i = -1;
    sections.forEach((s, idx) => { if (s && s.offsetTop <= y) i = idx; });
    links.forEach((l, idx) => l.classList.toggle("is-active", idx === i));
  };
  let activeQueued = false;
  window.addEventListener("scroll", () => {
    if (activeQueued) return;
    activeQueued = true;
    requestAnimationFrame(() => { activeQueued = false; setActive(); });
  }, { passive: true });
  setActive();

  // testimonials: inject 5 stars at the top of each, then fade + stagger-in on scroll
  const tCards = [...document.querySelectorAll(".testimonial")];
  tCards.forEach((card) => {
    const stars = document.createElement("div");
    stars.className = "testimonial__stars";
    stars.setAttribute("aria-hidden", "true");
    for (let i = 0; i < 5; i++) {
      const s = document.createElement("span");
      s.className = "testimonial__star";
      s.style.setProperty("--i", i);
      s.textContent = "★";
      stars.appendChild(s);
    }
    card.insertBefore(stars, card.firstChild);
  });
  if ("IntersectionObserver" in window && tCards.length) {
    const tIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            tIO.unobserve(e.target);
          }
        });
      },
      { threshold: 0.18 }
    );
    tCards.forEach((c) => tIO.observe(c));
  } else {
    tCards.forEach((c) => c.classList.add("is-visible"));
  }

  // testimonials: "Read them all" reveals hidden ones (mobile only)
  const tMore = document.querySelector(".testimonials__more");
  tMore?.addEventListener("click", () => {
    document.querySelector(".testimonials")?.classList.add("is-expanded");
  });

  // scroll reveals: masked section headings + gentle caption/lead fade-ups.
  // A [data-reveal] section gets .is-revealed as it scrolls into view; the CSS
  // (.reveal-h / .reveal-up) handles the motion. Same pattern as testimonials.
  const revealSections = document.querySelectorAll("[data-reveal]");
  if (revealSections.length) {
    // per-card stagger index for the work captions (inherited by name + crumb)
    document.querySelectorAll(".work .proj").forEach((p, i) => p.style.setProperty("--i", i));
    if ("IntersectionObserver" in window) {
      const rIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-revealed");
              rIO.unobserve(e.target);
            }
          });
        },
        { threshold: 0, rootMargin: "0px 0px -30% 0px" }
      );
      revealSections.forEach((s) => rIO.observe(s));
    } else {
      revealSections.forEach((s) => s.classList.add("is-revealed"));
    }
  }

  // Sound effects, synthesised from filtered noise so there are no files to
  // load. Browsers only allow sound after the visitor has clicked or pressed
  // a key somewhere, so until then every call is silent.
  //  - pop: a soft, short paper puff, a timeline row's photos popping up
  //  - folder: a low card-stock slide with a soft tap as it lands
  //  - fan: a quick riffle of three flicks, the deck breathing out on hover
  //  - lift: a light, airy flick, a card picked up off the table
  //  - tick: a lens focus-ring detent, tiny and dry
  //  - pluck: a polaroid picked up off the pile; thud: one bumping the edge
  //  - detent: the timeline's dial, a notch per month (lower and woodier than
  //    the lens tick) and a firmer double notch on a new year
  //  - shutter: a camera shutter, two quick clicks (open, close)
  const sfx = (() => {
    const AC = window.AudioContext || window.webkitAudioContext;
    const quiet = { pop() {}, folder() {}, fan() {}, lift() {}, tick() {}, detent() {}, shutter() {}, pluck() {}, thud() {} };
    if (!AC) return quiet;
    let ctx = null;
    const unlock = () => {
      ctx = ctx || new AC();
      if (ctx.state === "suspended") ctx.resume();
    };
    addEventListener("pointerdown", unlock, { passive: true });
    addEventListener("keydown", unlock);
    const ready = () => ctx && ctx.state === "running";
    // one burst of noise through a filter chain, shaped by a gain envelope
    const burst = ({ at = 0, len, grain = 1, filters, attack, peak }) => {
      const t = ctx.currentTime + at;
      const n = Math.floor(ctx.sampleRate * len);
      const buf = ctx.createBuffer(1, n, ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let k = 0; k < n; k++) d[k] = (Math.random() * 2 - 1) * (Math.random() < grain ? 1 : 0.3);
      const src = ctx.createBufferSource();
      src.buffer = buf;
      let node = src;
      filters.forEach(([type, freq, q = 0.7, to]) => {
        const f = ctx.createBiquadFilter();
        f.type = type;
        f.frequency.setValueAtTime(freq, t);
        if (to) f.frequency.exponentialRampToValueAtTime(to, t + len);
        f.Q.value = q;
        node = node.connect(f);
      });
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(peak, t + attack);
      g.gain.exponentialRampToValueAtTime(0.0001, t + len);
      node.connect(g).connect(ctx.destination);
      src.start(t);
    };
    return {
      pop() {
        if (!ready()) return;
        // a soft paper puff, low and short: filtered noise like the others,
        // under a tenth of a second so hovering down the rows doesn't drone
        burst({
          len: 0.05, attack: 0.005, peak: 0.045,
          filters: [["bandpass", 950 + Math.random() * 200, 1.2, 520], ["lowpass", 2200]],
        });
      },
      folder() {
        if (!ready()) return;
        // the slide: smooth hiss swept upward through the low mids
        burst({
          len: 0.17, attack: 0.04, peak: 0.07,
          filters: [["bandpass", 700 + Math.random() * 150, 0.9, 1900], ["lowpass", 3200]],
        });
        // the landing: a short, dull tap
        burst({ at: 0.13, len: 0.06, attack: 0.004, peak: 0.09, filters: [["lowpass", 420, 0.8]] });
      },
      fan() {
        if (!ready()) return;
        // three soft flicks, each a touch higher and quieter, the cards
        // spreading one after another
        [0, 0.035, 0.07].forEach((at, i) => burst({
          at, len: 0.035, attack: 0.003, peak: 0.032 - i * 0.007,
          filters: [["highpass", 1200], ["bandpass", 2000 + i * 500 + Math.random() * 200, 1.6]],
        }));
      },
      lift() {
        if (!ready()) return;
        // short hiss swept downward through the upper mids, no landing
        burst({
          len: 0.09, attack: 0.012, peak: 0.04,
          filters: [["highpass", 900], ["bandpass", 2600 + Math.random() * 500, 1.1, 1300]],
        });
      },
      tick() {
        if (!ready()) return;
        burst({ len: 0.012, attack: 0.001, peak: 0.035, filters: [["highpass", 2500], ["bandpass", 4600 + Math.random() * 800, 3]] });
      },
      pluck() {
        if (!ready()) return;
        burst({ len: 0.07, attack: 0.006, peak: 0.045, filters: [["highpass", 700], ["bandpass", 1900 + Math.random() * 300, 1.2, 3200]] });
      },
      thud() {
        if (!ready()) return;
        burst({ len: 0.07, attack: 0.003, peak: 0.07, filters: [["lowpass", 380 + Math.random() * 80, 0.9]] });
      },
      detent(year) {
        if (!ready()) return;
        burst({ len: 0.016, attack: 0.001, peak: year ? 0.06 : 0.04, filters: [["highpass", 1200], ["bandpass", 2300 + Math.random() * 400, 2.5]] });
        if (year) burst({ at: 0.045, len: 0.02, attack: 0.001, peak: 0.055, filters: [["bandpass", 1500 + Math.random() * 200, 2]] });
      },
      shutter() {
        if (!ready()) return;
        [[0, 0.11], [0.065, 0.08]].forEach(([at, peak]) => {
          burst({ at, len: 0.018, attack: 0.001, peak, filters: [["bandpass", 2600 + Math.random() * 300, 1.4]] });
          burst({ at, len: 0.03, attack: 0.002, peak: peak * 0.6, filters: [["lowpass", 650, 0.8]] });
        });
      },
    };
  })();

  // Beyond the screen: the pinned snake. The shape is described in the CSS
  // note; here we build the text from the hidden paragraph, lay a wavy path
  // under it, park the polaroids on their own slower layer, and run a frame
  // loop while the section is on screen that slides the snake with scroll
  // and keeps the curve itself rippling — the bends travel along the body
  // slower than the words, so the copy visibly flows through them, and a
  // slow time-based drift keeps it alive when the page is still.
  const beyond = document.querySelector(".beyond");
  if (beyond) {
    const frame = beyond.querySelector(".beyond__frame");
    const stage = beyond.querySelector(".beyond__stage");
    const snake = stage.querySelector(".beyond__snake");
    const path = stage.querySelector("#beyond-path");
    const textPath = stage.querySelector("textPath");
    const polsLayer = stage.querySelector(".beyond__pols");
    const pols = [...polsLayer.querySelectorAll(".beyond__pol")];
    const source = beyond.querySelector(".beyond__sr");
    const NS = "http://www.w3.org/2000/svg";
    const SPINE = 5; // degrees the snake's spine drops, left to right
    const RAD = (SPINE * Math.PI) / 180;
    const BEND_DRIFT = 0.45; // how fast the bends travel with scroll, relative to the words
    const IDLE_DRIFT = 0.035; // px of phase per ms when the page is still
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    beyond.querySelectorAll(".beyond__skip").forEach((btn) => {
      const target = btn.dataset.go === "prev" ? beyond.previousElementSibling : beyond.nextElementSibling;
      if (!target) return;
      btn.addEventListener("click", () => {
        target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      });
    });

    // one tspan per word; <b> marks the key word of each line
    const words = [];
    const addWords = (text, key, parent) => {
      text.split(/\s+/).filter(Boolean).forEach((w) => {
        const t = document.createElementNS(NS, "tspan");
        t.setAttribute("class", key ? "w is-key" : "w");
        t.textContent = w + " ";
        parent.appendChild(t);
        words.push(t);
      });
    };
    source.childNodes.forEach((n) => {
      if (n.nodeType === 3) addWords(n.textContent, false, textPath);
      else if (n.nodeType === 1 && n.tagName === "A") {
        // a link in the copy is a real link on the curve too; the hidden
        // paragraph's copy is the one keyboards and screen readers get
        const a = document.createElementNS(NS, "a");
        a.setAttribute("href", n.getAttribute("href"));
        a.setAttribute("tabindex", "-1");
        a.setAttribute("class", "beyond__link");
        textPath.appendChild(a);
        addWords(n.textContent, false, a);
      } else if (n.nodeType === 1) addWords(n.textContent, n.tagName === "B", textPath);
    });
    // near polaroids drift a little faster than their layer, far ones slower
    const speed = pols.map((pol) => ({ near: 1.2, far: 0.85 }[pol.dataset.depth] || 1));

    let geo = null;
    // the wave: a long main swell plus a smaller, faster ripple, both with a
    // travelling phase. y = A·sin(kx + φ) + A/4·sin(2.3kx − .6φ + 1)
    const waveY = (x, ph) => geo.A * Math.sin(geo.k * x + ph) + geo.A * 0.25 * Math.sin(2.3 * geo.k * x - 0.6 * ph + 1);
    const waveDy = (x, ph) => geo.A * geo.k * Math.cos(geo.k * x + ph) + geo.A * 0.25 * 2.3 * geo.k * Math.cos(2.3 * geo.k * x - 0.6 * ph + 1);
    const buildPath = (ph) => {
      const step = 30;
      let d = "";
      for (let x = 0; x <= geo.X; x += step) {
        const y = waveY(x, ph), dy = waveDy(x, ph);
        if (!d) { d = `M0 ${y.toFixed(1)}`; continue; }
        const px = x - step, py = waveY(px, ph), pdy = waveDy(px, ph);
        d += ` C${(px + step / 3).toFixed(1)} ${(py + (pdy * step) / 3).toFixed(1)} ${(x - step / 3).toFixed(1)} ${(y - (dy * step) / 3).toFixed(1)} ${x} ${y.toFixed(1)}`;
      }
      path.setAttribute("d", d);
    };
    const measure = () => {
      const w = stage.clientWidth, h = stage.clientHeight;
      // measure word advances on a straight path
      path.setAttribute("d", "M0 0 H 100000");
      let cum = 0;
      const wordMid = [];
      words.forEach((t) => {
        const l = t.getComputedTextLength();
        wordMid.push(cum + l / 2);
        cum += l;
      });
      const textLen = cum;
      // long and tall enough that the text dives and climbs, with roughly
      // one bend on screen at a time and the steepest stretch around 50°,
      // so it flows rather than zigzags. Arc length is always ≥ x, so a
      // path as long as the text in x is long enough for the text.
      const lam = Math.min(Math.max(w * 1.05, 700), 1500);
      const A = Math.min(h * 0.24, lam * 0.17);
      geo = { A, k: (2 * Math.PI) / lam, X: textLen + 30 };
      buildPath(0);
      // from the stage centre to where the spine leaves it, plus a margin
      const enter = Math.min(w / 2 / Math.cos(RAD), h / 2 / Math.sin(RAD)) + 80;
      const endX = path.getPointAtLength(textLen).x;
      // the opener is already on screen when you arrive (it starts a little
      // right of centre rather than off the edge), and the last word leaves
      // fully before the section unpins
      const start = enter * 0.4;
      Object.assign(geo, {
        enter: start,
        travel: endX + enter + start,
        read: enter * 0.35, // words ink in once past this spine-x
        // arc-to-x ratio is near-constant for the wave, so word positions
        // can be approximated without walking the path every frame
        wordX: wordMid.map((s) => (s * endX) / textLen),
      });
      // polaroids: one every ~40% of the viewport along their own layer,
      // alternating above and below the band the text sweeps through, with
      // a fixed (not random, so it's stable) scatter — just clear of the
      // text but inside the soft edges
      const polH = pols[0] ? pols[0].offsetHeight : 180;
      const gap = w * 0.5;
      // desktop keeps them further in from the top and bottom edges
      const edge = w > 880 ? 95 : 70;
      const lift = Math.min(A * 1.25 + polH / 2 - 30, h / 2 - polH / 2 - edge);
      pols.forEach((pol, i) => {
        const j1 = ((i * 7919) % 100) / 100 - 0.5, j2 = ((i * 104729) % 100) / 100 - 0.5;
        pol.style.setProperty("--x", i * gap + j1 * gap * 0.35 + "px");
        pol.style.setProperty("--y", (i % 2 ? 1 : -1) * (lift + j2 * 30) + "px");
      });
      geo.ptravel = (pols.length - 1) * gap + enter + start;
      stage.style.setProperty("--th", -SPINE + "deg");
      // ~0.7px of scroll per px of travel, never shorter than two screens
      beyond.style.setProperty("--runway", Math.max(geo.travel * 0.7, window.innerHeight * 2) + "px");
    };

    // pointer focus: a polaroid near the pointer sharpens and straightens
    let ptr = null;
    stage.addEventListener("pointermove", (e) => { ptr = { x: e.clientX, y: e.clientY }; });
    stage.addEventListener("pointerleave", () => { ptr = null; });
    const focusPols = () => {
      pols.forEach((pol) => {
        let f = pol.dataset.pin ? 1 : 0;
        if (ptr && !f) {
          const r = pol.getBoundingClientRect();
          const d = Math.hypot(ptr.x - (r.left + r.width / 2), ptr.y - (r.top + r.height / 2));
          f = Math.max(0, Math.min(1, 1 - (d - r.width * 0.5) / 200));
        }
        if (f || pol.dataset.f) {
          pol.style.setProperty("--focus", f.toFixed(2));
          pol.classList.toggle("is-focus", f > 0.5);
          if (f) pol.dataset.f = "1"; else delete pol.dataset.f;
        }
      });
    };
    // The polaroids can be handled: a tap pins one in focus (a tap elsewhere
    // lets it go), a press and drag picks it up and a flick throws it. It
    // coasts with a little friction, bumps off the edges of the stage and
    // stays where it lands, still riding the layer as you scroll. Offsets go
    // on the `translate` property, which sits outside the card's own
    // transform; pointer deltas are turned by -SPINE into the layer's frame.
    const cosS = Math.cos(RAD), sinS = Math.sin(RAD);
    const toLayer = (dx, dy) => [dx * cosS + dy * sinS, -dx * sinS + dy * cosS];
    const flying = new Map();
    pols.forEach((pol) => { pol.__tx = 0; pol.__ty = 0; });
    const placePol = (pol) => { pol.style.translate = `${pol.__tx.toFixed(1)}px ${pol.__ty.toFixed(1)}px`; };
    const pinPol = (pol, on) => {
      pols.forEach((q) => { if (q !== pol) delete q.dataset.pin; });
      if (on) pol.dataset.pin = "1"; else delete pol.dataset.pin;
    };
    const stopFly = (pol) => { const id = flying.get(pol); if (id) { cancelAnimationFrame(id); flying.delete(pol); } };
    const fly = (pol, vx, vy) => {
      let prev = performance.now();
      const step = (t) => {
        const dt = Math.min(48, t - prev);
        prev = t;
        pol.__tx += vx * dt;
        pol.__ty += vy * dt;
        const k = Math.pow(0.994, dt);
        vx *= k; vy *= k;
        // the edges, inset from the stage's fade so it never vanishes: a fast
        // card bumps off them with a thud, a slow one (or one dropped past
        // them) eases back inside
        const r = pol.getBoundingClientRect(), st = stage.getBoundingClientRect();
        const L = st.left + st.width * 0.08, R = st.right - st.width * 0.08, T = st.top + st.height * 0.06, B = st.bottom - st.height * 0.06;
        const ox = r.left < L ? L - r.left : r.right > R ? R - r.right : 0;
        const oy = r.top < T ? T - r.top : r.bottom > B ? B - r.bottom : 0;
        const fast = Math.hypot(vx, vy) > 0.15;
        if (ox) { if (fast) { pol.__tx += ox; vx = Math.sign(ox) * Math.abs(vx) * 0.55; } else pol.__tx += ox * 0.18; }
        if (oy) { if (fast) { pol.__ty += oy; vy = Math.sign(oy) * Math.abs(vy) * 0.55; } else pol.__ty += oy * 0.18; }
        if ((ox || oy) && fast) sfx.thud();
        placePol(pol);
        if (Math.hypot(vx, vy) > 0.02 || Math.abs(ox) > 0.5 || Math.abs(oy) > 0.5) flying.set(pol, requestAnimationFrame(step));
        else flying.delete(pol);
      };
      flying.set(pol, requestAnimationFrame(step));
    };
    let held = null;
    pols.forEach((pol) => {
      pol.addEventListener("pointerdown", (e) => {
        if (e.button || held) return;
        e.preventDefault();
        stopFly(pol);
        held = { pol, x0: e.clientX, y0: e.clientY, lx: e.clientX, ly: e.clientY, lt: e.timeStamp, vx: 0, vy: 0, moved: false, wasPinned: !!pol.dataset.pin };
        pol.setPointerCapture(e.pointerId);
      });
      pol.addEventListener("pointermove", (e) => {
        if (!held || held.pol !== pol) return;
        if (!held.moved) {
          if (Math.hypot(e.clientX - held.x0, e.clientY - held.y0) < 6) return;
          held.moved = true;
          pol.classList.add("is-held");
          pinPol(pol, true);
          sfx.pluck();
        }
        const dt = Math.max(1, e.timeStamp - held.lt);
        const [lx, ly] = toLayer(e.clientX - held.lx, e.clientY - held.ly);
        pol.__tx += lx; pol.__ty += ly;
        placePol(pol);
        held.vx = held.vx * 0.5 + (lx / dt) * 0.5;
        held.vy = held.vy * 0.5 + (ly / dt) * 0.5;
        held.lx = e.clientX; held.ly = e.clientY; held.lt = e.timeStamp;
      });
      const release = (e) => {
        if (!held || held.pol !== pol) return;
        const h = held;
        held = null;
        pol.classList.remove("is-held");
        if (!h.moved) { pinPol(pol, !h.wasPinned); return; } // a tap: sharpen, or let go
        // a flick throws it; a card held still before letting go just drops
        // (and eases back in if it was left past the edge)
        const stale = e.timeStamp - h.lt > 80;
        if (!reduce) fly(pol, stale ? 0 : h.vx, stale ? 0 : h.vy);
      };
      pol.addEventListener("pointerup", release);
      pol.addEventListener("pointercancel", release);
    });
    stage.addEventListener("pointerdown", (e) => {
      if (!e.target.closest(".beyond__pol")) pols.forEach((q) => delete q.dataset.pin);
    });

    let lastTx = null, vb = 0, idle = 0, lastT = 0;
    // a lens click as each word lights up (or goes dark, scrolling back), a
    // shutter on the key words; never
    // on the paints that come from load or resize (silent), and the small
    // clicks are capped so a fast scroll doesn't buzz
    let lastTick = 0;
    const click = (el) => {
      // one shutter per key phrase ("the gym" is two words)
      if (el.classList.contains("is-key")) {
        const prev = el.previousSibling;
        return prev && prev.classList && prev.classList.contains("is-key") ? undefined : sfx.shutter();
      }
      const now = performance.now();
      if (now - lastTick > 45) { lastTick = now; sfx.tick(); }
    };
    const paint = (p, dt, silent) => {
      const tx = geo.enter - p * geo.travel;
      const cx = stage.clientWidth / 2, cy = stage.clientHeight / 2;
      // the curve: bends drift with scroll at a fraction of the words' speed,
      // and keep creeping when the page is still
      if (!reduce) idle += dt * IDLE_DRIFT;
      buildPath(-geo.k * ((1 - BEND_DRIFT) * (geo.enter - tx) + idle));
      snake.setAttribute("transform", `translate(${cx} ${cy}) rotate(${SPINE}) translate(${tx} 0)`);
      const ptx = geo.enter - p * geo.ptravel;
      polsLayer.style.transform = `rotate(${SPINE}deg) translateX(${ptx}px)`;
      pols.forEach((pol, i) => { if (speed[i] !== 1) pol.style.setProperty("--dx", ptx * (speed[i] - 1) + "px"); });
      const readX = geo.read - tx;
      words.forEach((el, i) => {
        const on = geo.wordX[i] < readX;
        if (on === el.classList.contains("is-on")) return;
        el.classList.toggle("is-on", on);
        if (!silent) click(el);
      });
      // motion blur on the polaroids: bumped by how far the snake moved this
      // frame, decayed frame by frame so it clears the moment you stop
      if (lastTx !== null && !reduce) vb = Math.max(vb * 0.78, Math.min(2.5, Math.abs(tx - lastTx) * 0.04));
      if (vb < 0.05) vb = 0;
      stage.style.setProperty("--vb", vb.toFixed(2) + "px");
      lastTx = tx;
      focusPols();
    };
    const progress = () => {
      const span = beyond.offsetHeight - frame.offsetHeight;
      const p = span > 0 ? -beyond.getBoundingClientRect().top / span : 1;
      return Math.max(0, Math.min(1, p));
    };
    // the frame loop runs only while the section is on screen
    let running = false, raf = 0;
    const tick = (t) => {
      if (!running) return;
      const dt = lastT ? Math.min(50, t - lastT) : 0;
      lastT = t;
      if (geo) paint(progress(), dt);
      raf = requestAnimationFrame(tick);
    };
    const start = () => { if (running) return; running = true; lastT = 0; raf = requestAnimationFrame(tick); };
    const stop = () => { running = false; cancelAnimationFrame(raf); };
    const refresh = () => { measure(); if (geo) paint(reduce ? 0.45 : progress(), 0, true); };
    window.addEventListener("resize", refresh);
    refresh();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(refresh);
    if (!reduce) {
      if ("IntersectionObserver" in window) {
        new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.isIntersecting ? start() : stop()));
        }).observe(beyond);
      } else start();
    }
  }

  // Case study deck: the fan of overlapping cards. One card is "active" (in
  // front); every card carries --o, its offset from the active one, which
  // the CSS transform turns into position, depth and tilt. Dragging sets the
  // stack's --shift so the whole fan follows the pointer; past the threshold
  // it moves on, otherwise it springs back. A short press opens the card.
  // The deck loops: past the last card comes the first again.
  const deck = document.querySelector(".deck");
  if (deck) {
    const stack = deck.querySelector(".deck__cards");
    const prevBtn = deck.querySelector(".deck__arrow--prev");
    const nextBtn = deck.querySelector(".deck__arrow--next");
    const cards = [...stack.querySelectorAll(".deck__card")];
    const dotsWrap = deck.querySelector(".deck__dots");
    const n = cards.length;
    let active = 0;
    const dots = cards.map((c, i) => {
      const d = document.createElement("button");
      d.type = "button";
      d.className = "deck__bar";
      d.setAttribute("aria-label", "Show " + c.querySelector(".deck__brand").childNodes[1].textContent.trim());
      d.addEventListener("click", () => go(i));
      dotsWrap.appendChild(d);
      return d;
    });
    // offsets wrap round the loop, so each card has many possible --o values
    // (o, o ± n, …). Pick the one nearest the middle of the move about to
    // happen (d = 1 towards the next card, -1 back, 0 at rest): a card
    // leaving fades out on its own side and the one arriving comes in from
    // the side it's dealt from, rather than sweeping across behind the fan.
    const wrap = (i, d = 0) => {
      let o = ((i - active) % n + n) % n;
      if (o - d / 2 > n / 2) o -= n;
      return o;
    };
    // place every card at its loop offset for a move of d without animating,
    // so only cards hidden off the ends of the fan change side
    const settle = (d) => {
      const moved = cards.filter((c, i) => {
        const o = wrap(i, d);
        if (+c.style.getPropertyValue("--o") === o) return false;
        c.style.transition = "none";
        c.style.setProperty("--o", o);
        return true;
      });
      if (!moved.length) return;
      void stack.offsetWidth;
      moved.forEach((c) => c.style.removeProperty("transition"));
    };
    const render = (d = 0) => {
      cards.forEach((c, i) => {
        const o = wrap(i + d, d) - d;
        c.style.setProperty("--o", o);
        c.style.zIndex = 10 - Math.abs(o);
        c.classList.toggle("is-active", o === 0);
        c.setAttribute("aria-hidden", o === 0 ? "false" : "true");
        c.tabIndex = o === 0 ? 0 : -1;
      });
      dots.forEach((d, i) => {
        d.classList.toggle("is-active", i === active);
        d.setAttribute("aria-current", i === active ? "true" : "false");
      });
      dotsWrap.style.setProperty("--active-c", cards[active].style.getPropertyValue("--c") || "");
    };
    // the first hover on the fan (the CSS breathes it out) gets a riffle;
    // it plays again only once the pointer has left the cards
    const fanHover = matchMedia("(hover:hover) and (min-width:761px)");
    let fanned = false;
    stack.addEventListener("pointerover", (e) => {
      if (e.pointerType !== "mouse" || fanned || !fanHover.matches || stack.classList.contains("is-dragging") || !e.target.closest(".deck__card")) return;
      fanned = true;
      sfx.fan();
    });
    stack.addEventListener("pointerout", (e) => {
      if (!(e.relatedTarget && e.relatedTarget.closest && e.relatedTarget.closest(".deck__card"))) fanned = false;
    });
    // move one card along: d is 1 (next) or -1 (back)
    const step = (d) => {
      sfx.folder();
      learned = true;
      clearTimeout(idle);
      stopNudge();
      settle(d);
      active = (active + d + n) % n;
      render(d);
    };
    // go to any card the short way round. A jump of more than one deals the
    // cards one at a time in quick succession, so every card still leaves
    // and arrives from the right side.
    let riffle;
    const go = (i) => {
      clearTimeout(riffle);
      let d = ((i - active) % n + n) % n;
      if (d > n / 2) d -= n;
      const tick = () => {
        if (!d) return;
        const s = Math.sign(d);
        step(s);
        d -= s;
        if (d) riffle = setTimeout(tick, 150);
      };
      tick();
    };
    prevBtn.addEventListener("click", () => go(active - 1));
    nextBtn.addEventListener("click", () => go(active + 1));
    stack.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { go(active + 1); e.preventDefault(); }
      if (e.key === "ArrowLeft") { go(active - 1); e.preventDefault(); }
    });

    // drag: horizontal movement past a few px becomes a drag (vertical stays
    // a page scroll, see touch-action). The front card follows the pointer
    // and, past the crossover, dips behind the neighbour sliding in to
    // replace it.
    let down = null, dragged = false;
    const width = () => cards[active].offsetWidth || 1;
    stack.addEventListener("pointerdown", (e) => {
      if (e.button) return;
      clearTimeout(riffle);
      stopNudge();
      down = { x: e.clientX, y: e.clientY };
      dragged = false;
    });
    stack.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - down.x, dy = e.clientY - down.y;
      if (!dragged) {
        if (Math.abs(dx) < 6 || Math.abs(dx) < Math.abs(dy)) return;
        dragged = true;
        stack.classList.add("is-dragging");
        stack.setPointerCapture(e.pointerId);
      }
      const shift = Math.max(-1, Math.min(1, dx / width()));
      const d = shift < 0 ? 1 : -1;
      settle(d);
      stack.style.setProperty("--shift", shift);
      // the card coming in rides above the rest of the fan; past the
      // crossover the card on its way out slips behind it
      cards.forEach((c, i) => { c.style.zIndex = 10 - Math.abs(wrap(i, d)); });
      cards[(active + d + n) % n].style.zIndex = 11;
      cards[active].style.zIndex = Math.abs(shift) > 0.4 ? 9 : 12;
    });
    const release = (e) => {
      if (!down) return;
      const dx = e.clientX - down.x;
      down = null;
      if (!dragged) return;
      // transitions back on first, so the fan eases from where it was left
      stack.classList.remove("is-dragging");
      stack.style.removeProperty("--shift");
      if (dx < -width() * 0.2) step(1);
      else if (dx > width() * 0.2) step(-1);
      else render();
      // the click that follows a drag must not open the card
      setTimeout(() => { dragged = false; }, 0);
    };
    stack.addEventListener("pointerup", release);
    stack.addEventListener("pointercancel", release);
    stack.addEventListener("click", (e) => {
      const card = e.target.closest(".deck__card");
      if (!card) return;
      if (dragged) { e.preventDefault(); e.stopPropagation(); return; }
      // a card behind comes to the front instead of opening
      if (!card.classList.contains("is-active")) {
        e.preventDefault(); e.stopPropagation();
        go(cards.indexOf(card));
      }
    }, true);

    // the hint that the cards can be dragged: once the deck is all but fully
    // on screen, the front card is pulled a little to the left, swings over
    // to the right, and springs back to the middle. It goes again after
    // every 5s left alone, until the deck has actually been moved on (drag,
    // arrows, bars or keys). Never while a card is under the pointer, never
    // with reduced motion; any press on the stack cancels it.
    let nudgeTimers = [], idle, inView = false, learned = false;
    const NUDGE = ["is-nudging-left", "is-nudging-right", "is-nudging-back"];
    // [--shift, class, ms until the next move]
    const SWING = [[-0.05, NUDGE[0], 420], [0.05, NUDGE[1], 480], [0, NUDGE[2], 850]];
    const later = (fn, ms) => nudgeTimers.push(setTimeout(fn, ms));
    function stopNudge() {
      nudgeTimers.forEach(clearTimeout);
      nudgeTimers = [];
      if (!stack.className.includes("is-nudging")) return;
      stack.classList.remove(...NUDGE);
      if (!down) stack.style.removeProperty("--shift");
    }
    const queue = (ms = 5000) => {
      clearTimeout(idle);
      if (!learned) idle = setTimeout(nudge, ms);
    };
    function nudge() {
      if (learned || !inView) return;
      if (down || document.hidden || stack.matches(":has(.deck__card:hover)")) return queue();
      let t = 0;
      SWING.forEach(([shift, cls, ms]) => {
        later(() => {
          stack.classList.remove(...NUDGE);
          stack.classList.add(cls);
          if (shift) { settle(shift < 0 ? 1 : -1); stack.style.setProperty("--shift", shift); }
          else stack.style.removeProperty("--shift");
        }, t);
        t += ms;
      });
      later(() => { stopNudge(); queue(); }, t);
    }
    // a press or a key restarts the 5s
    stack.addEventListener("pointerdown", () => queue());
    stack.addEventListener("keydown", () => queue());
    if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion:reduce)").matches) {
      new IntersectionObserver((entries) => {
        const was = inView;
        inView = entries[0].intersectionRatio >= 0.9;
        if (inView && !was) queue(350);
        if (!inView) clearTimeout(idle);
      }, { threshold: [0, 0.9, 1] }).observe(stack);
    }

    render();
  }

  // work-card videos: no autoplay or poster in the markup, since either makes
  // the browser download them even inside the parked (hidden) rail. Start
  // them here only when they're actually on the page.
  document.querySelectorAll(".proj__video").forEach((v) => {
    if (v.closest("[hidden]")) return;
    v.poster = v.dataset.poster || "";
    v.preload = "auto";
    v.play().catch(() => {});
  });

  // secret footer reveal: trigger when within 40vh of document end
  const secretEl = document.querySelector(".secret-footer");
  if (secretEl) {
    const checkReveal = () => {
      const docH = document.documentElement.scrollHeight;
      const winH = window.innerHeight;
      const remaining = docH - winH - window.scrollY;
      secretEl.classList.toggle("is-revealed", remaining < winH * 0.18);
    };
    let revealQueued = false;
    window.addEventListener("scroll", () => {
      if (revealQueued) return;
      revealQueued = true;
      requestAnimationFrame(() => { revealQueued = false; checkReveal(); });
    }, { passive: true });
    window.addEventListener("resize", checkReveal);
    checkReveal();
  }

  // live clock
  const clock = document.getElementById("clock");
  if (clock) {
    const tick = () => {
      const d = new Date();
      const h = d.getHours() % 12 || 12;
      const m = String(d.getMinutes()).padStart(2,"0");
      const s = String(d.getSeconds()).padStart(2,"0");
      const ap = d.getHours() >= 12 ? "PM" : "AM";
      clock.textContent = `${h}:${m}:${s} ${ap}`;
    };
    tick(); setInterval(tick, 1000);
  }

  // Phones: while the hero's on screen and left alone (no scroll or touch
  // for a few seconds), a random card gives a little wiggle every few
  // seconds, like the deck's nudge further down. Stops for good once a
  // card has been tapped. Never with reduced motion.
  {
    const mql = matchMedia("(max-width:760px)");
    const cards = [...document.querySelectorAll(".fan .fcard")];
    const heroEl = document.querySelector(".hero");
    let idleSince = performance.now(), inView = false, learned = false, lastCard = null, timer = 0;
    const poke = () => { idleSince = performance.now(); };
    addEventListener("scroll", poke, { passive: true });
    addEventListener("touchstart", poke, { passive: true });
    cards.forEach((c) => {
      c.addEventListener("click", () => { learned = true; });
      c.addEventListener("animationend", (e) => { if (e.animationName === "fcWiggle") c.classList.remove("is-wiggling"); });
    });
    const wiggle = () => {
      timer = setTimeout(wiggle, 3200 + Math.random() * 2600);
      if (learned || !inView || !mql.matches || document.hidden) return;
      if (performance.now() - idleSince < 2500) return;
      if (scrollY > 40) return; // the profile card is mid-slide once you scroll
      // never the profile card: it slides down the page straight, so a
      // wiggle would look wrong
      const pool = cards.filter((c) => c !== lastCard && !c.classList.contains("is-popped") && !c.classList.contains("fcard--me"));
      const c = pool[Math.floor(Math.random() * pool.length)];
      if (!c) return;
      lastCard = c;
      c.classList.remove("is-wiggling");
      void c.offsetWidth;
      c.classList.add("is-wiggling");
    };
    if (cards.length && heroEl && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion:reduce)").matches) {
      new IntersectionObserver((es) => { inView = es[0].intersectionRatio > 0.4; }, { threshold: [0, 0.4, 1] }).observe(heroEl);
      timer = setTimeout(wiggle, 4200);
    }
  }

  // Mobile tap-to-pop for the fanned hero cards. On phones (≤640px) the
  // cards are stacked vertically; tapping a card lifts it above the others
  // (.is-popped), tapping again — or tapping outside — drops it back.
  // For the two link cards, only the designated child element follows the
  // link; taps elsewhere on the card just toggle the pop state.
  {
    const mql = window.matchMedia("(max-width:640px)");
    const cards = [...document.querySelectorAll(".fan .fcard")];
    if (cards.length) {
      const linkTarget = (card) => {
        if (card.classList.contains("fcard--2")) return card.querySelector(".pill");
        if (card.classList.contains("fcard--5")) return card.querySelector(".mu-disc-wrap");
        if (card.classList.contains("fcard--me")) return card.querySelector(".me__connect");
        return null;
      };
      const reset = () => cards.forEach((c) => c.classList.remove("is-popped"));
      cards.forEach((card) => {
        // a light flick as a card lifts (the deck has the heavier folder
        // sound): on mouse hover, or the tap that pops it on a phone (below)
        card.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") sfx.lift(); });
        card.addEventListener("click", (e) => {
          if (!mql.matches) return;
          const target = linkTarget(card);
          if (target && target.contains(e.target)) return; // let the link follow
          e.preventDefault();
          const wasPopped = card.classList.contains("is-popped");
          reset();
          if (!wasPopped) { card.classList.add("is-popped"); sfx.lift(); }
        });
      });
      document.addEventListener("click", (e) => {
        if (!mql.matches) return;
        if (e.target.closest(".fan .fcard")) return;
        reset();
      });
    }
  }

  // Profile card: once its centre has scrolled up to just above the middle
  // of the screen, it travels down with the page for half a screen (so it
  // holds still), straightening and (not on phones) growing a touch, then
  // stops and the page carries on: it lands on top of the About
  // intro, which gets exactly enough top padding (--land) to hold it.
  // Skipped for reduced motion and the "Card beside copy" layout.
  {
    const card = document.querySelector(".fcard--me");
    const hero = document.querySelector(".hero");
    const fanIn = document.querySelector(".fan__inner");
    const hello = document.querySelector(".hello");
    const html = document.documentElement;
    const reduce = matchMedia("(prefers-reduced-motion:reduce)");
    if (card && hero && fanIn && hello) {
      const HOLD_AT = 0.42; // where on screen its centre holds, from the top
      const phone = matchMedia("(max-width:640px)");
      let k = 1, start = 0, travel = 0, on = false, GROW = 0.3, r = 0, dx = 0;
      const active = () => !reduce.matches && html.dataset.prefIntro !== "beside" && hero.offsetParent !== null;
      const measure = () => {
        on = active();
        card.style.translate = card.style.rotate = card.style.scale = "";
        hello.style.removeProperty("--land");
        if (!on) return;
        // fan__inner may be scaled (transform-origin top centre), so its top
        // is real but the card's offsets need multiplying by the scale
        k = new DOMMatrix(getComputedStyle(fanIn).transform).a || 1;
        GROW = phone.matches ? 0 : 0.3;
        r = parseFloat(getComputedStyle(card).getPropertyValue("--r")) || 0;
        travel = innerHeight / 2;
        // how far its slot sits off the centre line (20px right on phones);
        // it drifts back to the middle as it travels
        dx = card.offsetLeft + card.offsetWidth / 2 - fanIn.offsetWidth / 2;
        const top = fanIn.getBoundingClientRect().top + scrollY + card.offsetTop * k;
        const h = card.offsetHeight * k;
        start = Math.max(hero.getBoundingClientRect().top + scrollY, top + h / 2 - innerHeight * HOLD_AT);
        // only make room when the intro sits straight under the hero
        let next = hero.nextElementSibling;
        while (next && getComputedStyle(next).display === "none") next = next.nextElementSibling;
        if (next !== hello) return;
        const bottom = top + h / 2 + travel + (h * (1 + GROW)) / 2;
        const helloTop = hello.getBoundingClientRect().top + scrollY;
        // breathing room between the landed card and the copy; more on
        // phones, where the copy starts right under it
        const gap = phone.matches ? 96 : 56;
        hello.style.setProperty("--land", Math.max(0, Math.round(bottom - helloTop + gap)) + "px");
      };
      const update = () => {
        if (!on) return;
        const y = Math.min(travel, Math.max(0, scrollY - start));
        const p = travel ? y / travel : 0;
        card.style.translate = `${(-dx * p).toFixed(1)}px ${(y / k).toFixed(1)}px`;
        card.style.rotate = `${(-r * p).toFixed(2)}deg`;
        card.style.scale = (1 + GROW * p).toFixed(3);
      };
      let raf = 0;
      addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); }, { passive: true });
      const refresh = () => { measure(); update(); };
      addEventListener("resize", refresh);
      addEventListener("load", refresh);
      new MutationObserver(refresh).observe(html, { attributes: true, attributeFilter: ["data-pref-intro"] });
      refresh();
    }
  }

  // Work life timeline: start at the recent end, and let a mouse drag scrub
  // it sideways (touch and trackpads already scroll natively).
  const tlScroller = document.querySelector(".tl__scroller");
  if (tlScroller) {
    // again once the DOM's settled: moving a section (the review panel can)
    // resets its scroll
    const toNow = () => { if (!matchMedia("(max-width:760px)").matches) tlScroller.scrollLeft = tlScroller.scrollWidth; }; // trimmed to today below once the needle's measured
    toNow();
    addEventListener("DOMContentLoaded", toNow);
    let tlDrag = null;
    tlScroller.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button) return;
      tlDrag = { x: e.clientX, left: tlScroller.scrollLeft, moved: false };
    });
    addEventListener("pointermove", (e) => {
      if (!tlDrag) return;
      const dx = e.clientX - tlDrag.x;
      if (!tlDrag.moved && Math.abs(dx) < 4) return;
      tlDrag.moved = true;
      tlScroller.classList.add("is-dragging");
      tlScroller.scrollLeft = tlDrag.left - dx;
    });
    addEventListener("pointerup", () => {
      tlDrag = null;
      tlScroller.classList.remove("is-dragging");
    });

    // Phones: the timeline pins to the screen and your scroll travels back
    // through the years. The section becomes a tall runway with a sticky,
    // full-screen pin; how far you are through the runway sets a target
    // (how far along the years, how far the staircase has risen) and what's
    // drawn springs towards it every frame. All transforms, riding on the
    // phone's own scroll momentum. A sideways swipe drives the same page
    // scroll and coasts when you let go.
    const phone = matchMedia("(max-width:760px)");
    const tlSection = tlScroller.closest(".tl");
    const pin = tlSection.querySelector(".tl__pin");
    const track = tlScroller.querySelector(".tl__track");
    const rows = tlScroller.querySelector(".tl__rows");
    const rowEls = [...rows.querySelectorAll(".tl__row")];
    const navEl = document.querySelector(".nav");
    const still = matchMedia("(prefers-reduced-motion:reduce)");
    const RATIO = 1.15; // px of page scroll per px of travel along the years

    // the needle: placed over the scroller, reading the month and year
    // where it stands. Only touches the DOM when the month changes. On
    // phones it stands 70% of the way across; on desktop it sits over to the
    // right, just inside the scroller's faded right edge.
    const needleX = () => {
      const cw = tlScroller.clientWidth;
      return phone.matches ? cw * 0.7 : Math.max(cw * 0.7, cw - 130);
    };
    const needle = tlSection.querySelector(".tl__needle");
    const needleLabel = needle.querySelector(".tl__needle-label");
    const axisEl = track.querySelector(".tl__axis");
    const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const today = new Date();
    const NOW = today.getFullYear() + today.getMonth() / 12;
    let padL = 0, hold = 0, shown = "";
    // the first year on the axis: where the journey back in time ends
    const FIRST = Math.min(...[...axisEl.children].map((li) => parseFloat(li.style.getPropertyValue("--y"))).filter((n) => !isNaN(n)));
    // the "now" bar runs to today, not to the end of the axis
    tlScroller.querySelectorAll(".tl__bar--now").forEach((b) => b.style.setProperty("--e", NOW.toFixed(3)));
    // the axis, as the CSS draws it: --yr0 a year up to --brk, --yr after
    let g = { yr: 150, yr0: 40, early: 2007, brk: 2015, to: 2027 };
    const xAt = (y) => (Math.min(Math.max(y, g.early), g.brk) - g.early) * g.yr0 + (Math.max(y, g.brk) - g.brk) * g.yr;
    const yearAt = (x) => {
      const b = (g.brk - g.early) * g.yr0;
      return x < b ? g.early + x / g.yr0 : g.brk + (x - b) / g.yr;
    };
    // the track's side room is set so the needle sits on today when the
    // scroller is at its far right, and on FIRST at its far left. Going
    // back, the years stop once FIRST is a little in from the left edge
    // (scroll position `hold`); past that the needle walks the rest.
    // On a screen wide enough to show every year at once, the years stretch
    // so 2007 starts at the left edge and today lands on the needle: the
    // track never moves, only the needle does, and there's no empty right.
    const pad = () => {
      tlSection.style.removeProperty("--yr");
      const cs = getComputedStyle(tlSection), cw = tlScroller.clientWidth;
      const num = (k, d) => parseFloat(cs.getPropertyValue(k)) || d;
      g = { yr: num("--yr", 150), yr0: num("--yr0", 46), early: num("--early", 2007), brk: num("--brk", 2015), to: num("--to", 2027) };
      const gutter = parseFloat(getComputedStyle(tlSection.querySelector(".tl__head")).paddingLeft) || 20;
      const edge = gutter + 24;
      if (!phone.matches) {
        const fit = (needleX() - edge - (g.brk - g.early) * g.yr0) / (NOW - g.brk);
        if (fit > g.yr) { g.yr = fit; tlSection.style.setProperty("--yr", fit.toFixed(2) + "px"); }
      }
      const w = xAt(g.to);
      padL = Math.max(edge, needleX() - xAt(FIRST));
      hold = padL - edge;
      track.style.setProperty("--pad-l", padL + "px");
      track.style.setProperty("--pad-r", Math.max(gutter, cw - needleX() - (w - xAt(NOW))) + "px");
      track.style.setProperty("--stick", cw - edge - w + "px");
    };
    // with the years held at the edge, the needle stands left of its rest.
    // The pill and hairline move on their own (--walk): a transform on the
    // needle itself would make it a layer, and the axis would paint over the pill
    const walk = (pos) => { needle.style.setProperty("--walk", (pos < hold ? (pos - hold).toFixed(2) : 0) + "px"); };
    const placeNeedle = () => {
      pad();
      needle.style.left = needleX() + "px";
      // from where the axis actually sits (its top margin collapses into the
      // track, so offsetTop can't be trusted); the wrapper moves with the
      // scroller, so this holds when the pinned header grows for the nav
      const base = needle.offsetParent.getBoundingClientRect();
      const ax = axisEl.getBoundingClientRect(), sc = tlScroller.getBoundingClientRect();
      needle.style.top = ax.top - base.top + "px";
      needle.style.height = sc.bottom - ax.top + "px";
    };
    const posAt = (year) => padL + xAt(year) - needleX();
    // the needle clicks like a dial as it passes each month, a firmer double
    // notch on a new year; month clicks are capped so a fast scrub doesn't
    // buzz. Silent on the paints that come from load or resize.
    let lastDetent = 0;
    const setNeedle = (pos, silent) => {
      const yr = Math.min(NOW, Math.max(FIRST, yearAt(pos + needleX() - padL)));
      const m = Math.min(11, Math.floor((yr % 1) * 12 + 0.5));
      const text = MONTHS[m] + " " + Math.floor(yr);
      if (text === shown) return;
      const newYear = shown && text.slice(-4) !== shown.slice(-4);
      needleLabel.textContent = shown = text;
      if (silent) return;
      const now = performance.now();
      if (newYear) { lastDetent = now; sfx.detent(true); }
      else if (now - lastDetent > 45) { lastDetent = now; sfx.detent(false); }
    };
    let range = 0, runway = 0, depthAt = () => 0, cur = null, loop = 0, lastT = 0, visible = false;

    // a smooth curve through the steps of the staircase (monotone cubic,
    // Fritsch–Carlson), so the rise eases into and out of each role
    // instead of kinking at it, and never overshoots between them
    const monotone = (pts) => {
      const n = pts.length;
      if (n < 2) return () => (n ? pts[0].y : 0);
      const d = [], m = [];
      for (let i = 0; i < n - 1; i++) d.push((pts[i + 1].y - pts[i].y) / (pts[i + 1].x - pts[i].x || 1));
      m.push(d[0]);
      for (let i = 1; i < n - 1; i++) m.push(d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2);
      m.push(d[n - 2]);
      for (let i = 0; i < n - 1; i++) {
        if (!d[i]) { m[i] = m[i + 1] = 0; continue; }
        const a = m[i] / d[i], b = m[i + 1] / d[i], h = Math.hypot(a, b);
        if (h > 3) { m[i] = (3 * a * d[i]) / h; m[i + 1] = (3 * b * d[i]) / h; }
      }
      return (x) => {
        if (x <= pts[0].x) return pts[0].y;
        if (x >= pts[n - 1].x) return pts[n - 1].y;
        let i = 0;
        while (x > pts[i + 1].x) i++;
        const w = pts[i + 1].x - pts[i].x, t = (x - pts[i].x) / w, t2 = t * t, t3 = t2 * t;
        return (2 * t3 - 3 * t2 + 1) * pts[i].y + (t3 - 2 * t2 + t) * w * m[i] + (-2 * t3 + 3 * t2) * pts[i + 1].y + (t3 - t2) * w * m[i + 1];
      };
    };

    const navRoom = () => {
      const out = navEl && !navEl.classList.contains("is-hidden") && !navEl.classList.contains("is-pinned");
      tlSection.style.setProperty("--tl-top", out ? navEl.offsetHeight + "px" : "0px");
    };
    if (navEl) new MutationObserver(navRoom).observe(navEl, { attributes: true, attributeFilter: ["class"] });
    navRoom();

    const measure = () => {
      const on = phone.matches;
      tlSection.classList.toggle("is-pinned", on);
      track.style.transform = rows.style.transform = "";
      cur = null;
      if (!on) { tlSection.style.removeProperty("height"); return; }
      tlScroller.scrollLeft = 0;
      pad();
      range = Math.max(0, posAt(NOW) - posAt(FIRST));
      runway = range * RATIO;
      tlSection.style.height = pin.offsetHeight + runway + "px";
      // each step of the staircase: where its bar starts along the track,
      // how far down it sits. Rows that start later but sit lower (the
      // holidays) never become the top one, so they're left out.
      const t0 = track.getBoundingClientRect().left;
      const pts = rowEls
        .map((row) => ({ x: row.querySelector(".tl__bar").getBoundingClientRect().left - t0, y: row.offsetTop - rowEls[0].offsetTop }))
        .sort((a, b) => a.x - b.x)
        .filter((pt, i, all) => all.slice(0, i).every((q) => pt.y < q.y));
      // the staircase rises a row per role, as far as it takes to bring the
      // last role to just above the bottom of the screen (measured with the
      // nav away), then holds: by then every older role is on screen below,
      // and the journey ends on Ten London rather than on rows of nothing
      const rise = monotone(pts);
      const navNow = parseFloat(tlSection.style.getPropertyValue("--tl-top")) || 0;
      const last = rowEls[rowEls.length - 1];
      const firstTop = rowEls[0].getBoundingClientRect().top - pin.getBoundingClientRect().top - navNow;
      const lastBottom = last.offsetTop - rowEls[0].offsetTop + last.offsetHeight;
      const maxRise = Math.max(0, lastBottom - (pin.clientHeight - firstTop - 24));
      depthAt = (x) => Math.min(maxRise, rise(x));
    };

    const frame = (t) => {
      loop = 0;
      if (!tlSection.classList.contains("is-pinned")) return;
      const dt = lastT ? Math.min(64, t - lastT) : 16;
      lastT = t;
      const p = runway ? Math.min(1, Math.max(0, -tlSection.getBoundingClientRect().top / runway)) : 0;
      const x = posAt(FIRST) + range * (1 - p); // today at the top, FIRST at the end
      const y = depthAt(x + needleX());
      if (!cur || still.matches) cur = { x, y };
      else {
        const k = 1 - Math.exp(-dt / 110); // ~110ms spring, frame-rate independent
        cur.x += (x - cur.x) * k;
        cur.y += (y - cur.y) * k;
      }
      track.style.transform = `translate3d(${-Math.max(cur.x, hold).toFixed(2)}px,0,0)`;
      walk(cur.x);
      setNeedle(cur.x);
      rows.style.transform = `translate3d(0,${-cur.y.toFixed(2)}px,0)`;
      const settled = Math.abs(x - cur.x) < 0.1 && Math.abs(y - cur.y) < 0.1;
      if (visible || !settled) loop = requestAnimationFrame(frame);
      else lastT = 0;
    };
    const kick = () => { if (!loop) loop = requestAnimationFrame(frame); };
    addEventListener("scroll", kick, { passive: true });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (visible) kick(); }).observe(tlSection);
    } else visible = true;

    // sideways swipes on the pinned timeline drive the page scroll, with a
    // coast when you let go; vertical ones are left to the browser
    let swipe = null, coast = 0;
    const stopCoast = () => { cancelAnimationFrame(coast); coast = 0; };
    pin.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse" || !tlSection.classList.contains("is-pinned")) return;
      stopCoast();
      swipe = { x: e.clientX, y: e.clientY, lx: e.clientX, lt: e.timeStamp, v: 0, on: false };
    });
    pin.addEventListener("pointermove", (e) => {
      if (!swipe) return;
      const dx = e.clientX - swipe.x, dy = e.clientY - swipe.y;
      if (!swipe.on) {
        if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) { swipe = null; return; }
        if (Math.abs(dx) < 8) return;
        swipe.on = true;
      }
      const step = e.clientX - swipe.lx, dt = Math.max(1, e.timeStamp - swipe.lt);
      swipe.v = swipe.v * 0.6 + (step / dt) * 0.4; // px per ms, smoothed
      swipe.lx = e.clientX;
      swipe.lt = e.timeStamp;
      scrollBy({ top: step * RATIO, behavior: "instant" });
    });
    const endSwipe = () => {
      if (!swipe || !swipe.on) { swipe = null; return; }
      let v = swipe.v, prev = performance.now();
      swipe = null;
      const glide = (t) => {
        const dt = Math.min(48, t - prev);
        prev = t;
        v *= Math.pow(0.94, dt / 16);
        if (Math.abs(v) < 0.02) { coast = 0; return; }
        scrollBy({ top: v * dt * RATIO, behavior: "instant" });
        coast = requestAnimationFrame(glide);
      };
      if (!still.matches) coast = requestAnimationFrame(glide);
    };
    pin.addEventListener("pointerup", endSwipe);
    pin.addEventListener("pointercancel", () => { swipe = null; });
    addEventListener("wheel", stopCoast, { passive: true });

    let openedOnToday = false;
    const remeasure = () => {
      measure(); placeNeedle();
      if (!tlSection.classList.contains("is-pinned") && !openedOnToday) { tlScroller.scrollLeft = posAt(NOW); openedOnToday = true; }
      const pos = tlSection.classList.contains("is-pinned") ? (cur ? cur.x : posAt(NOW)) : tlScroller.scrollLeft;
      walk(pos); setNeedle(pos, true); kick();
    };
    tlScroller.addEventListener("scroll", () => {
      if (tlSection.classList.contains("is-pinned")) return;
      walk(tlScroller.scrollLeft); setNeedle(tlScroller.scrollLeft);
    }, { passive: true });
    addEventListener("resize", remeasure);
    phone.addEventListener?.("change", remeasure);
    addEventListener("load", remeasure);
    remeasure();
  }

  // Work life fan: a short pop as the cards come out.
  const tlBars = document.querySelectorAll(".tl__bar");
  // .is-open shows a bar's fan: mouse hover (in and out), keyboard focus,
  // and on touch a tap toggles it, a tap elsewhere closes it. Each opening
  // plays the pop.
  const openBar = (bar) => {
    if (bar.classList.contains("is-open")) return;
    tlBars.forEach((b) => b.classList.toggle("is-open", b === bar));
    sfx.pop();
  };
  const closeBars = () => tlBars.forEach((b) => b.classList.remove("is-open"));
  tlBars.forEach((bar) => {
    bar.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") openBar(bar); });
    bar.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") bar.classList.remove("is-open"); });
    // a tap focuses the bar before its click lands, so while a touch is in
    // flight focus and blur leave the fan alone and the click decides
    bar.addEventListener("focus", () => { if (!bar.dataset.touched) openBar(bar); });
    bar.addEventListener("blur", () => { if (!bar.dataset.touched) bar.classList.remove("is-open"); });
    bar.addEventListener("pointerdown", (e) => { if (e.pointerType !== "mouse") bar.dataset.touched = "1"; });
    bar.addEventListener("click", () => {
      if (!bar.dataset.touched) return;
      const wasOpen = bar.classList.contains("is-open");
      bar.blur();
      delete bar.dataset.touched;
      if (wasOpen) closeBars(); else openBar(bar);
    });
  });
  document.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "mouse" && !e.target.closest(".tl__bar")) closeBars();
  }, { passive: true });

  // GA4: case study card clicks
  document.querySelectorAll("a.proj[href]").forEach((a) => {
    a.addEventListener("click", () => {
      if (typeof gtag !== "function") return;
      const project = (a.getAttribute("href") || "").replace(/\.html$/, "");
      gtag("event", "case_study_view", { project });
    });
  });
})();
</script>
{% endblock %}
