/* ========================================================== beyond the screen
   A pinned, full-width passage between About and the testimonials. One long
   line of copy is laid along a tall, wavy SVG path — the snake — with the
   polaroids tucked inside its bends. Scrolling the page through the
   section's runway slides the whole snake through the viewport: later words
   arrive from the right, dive and climb across the screen, and dissolve out
   on the left. Words ink in as they cross the reading line. The copy itself
   lives once, in a visually hidden paragraph the snake is generated from, so
   screen readers and search get real text. JS builds the path from the
   measured text, places the polaroids, drives the transforms, and sets
   --runway (pinned scroll distance) on the section. */
.beyond{
  position:relative;z-index:2;
  background:var(--bg);
  --runway:300vh;
  height:calc(100vh + var(--runway));
}
/* the page's dotted background meets the solid stage here — fade the dots
   out above and back in below rather than cutting them off */
.beyond::before,
.beyond::after{
  content:"";position:absolute;left:0;right:0;height:clamp(90px,14vh,160px);
  pointer-events:none;
}
.beyond::before{bottom:100%;background:linear-gradient(to bottom,transparent,var(--bg))}
.beyond::after{top:100%;background:linear-gradient(to bottom,var(--bg),transparent)}
.beyond__frame{
  position:sticky;top:0;
  height:100vh;height:100svh;
  overflow:hidden;
}
.beyond__stage{
  position:absolute;inset:0;overflow:hidden;
  --th:0deg;
  /* the fade: a long dissolve on the right where the words arrive, a
     slightly shorter one on the left where they leave, soft top and bottom */
  -webkit-mask:linear-gradient(90deg,transparent 6%,#000 32% 58%,transparent 94%),linear-gradient(180deg,transparent,#000 5% 95%,transparent);
  -webkit-mask-composite:source-in;
  mask:linear-gradient(90deg,transparent 6%,#000 32% 58%,transparent 94%),linear-gradient(180deg,transparent,#000 5% 95%,transparent);
  mask-composite:intersect;
}
.beyond__sr{
  position:absolute;width:1px;height:1px;margin:-1px;padding:0;border:0;
  overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;
}
.beyond__svg{
  position:absolute;inset:0;width:100%;height:100%;
  overflow:visible;
  /* the words sit over the polaroids; let taps and drags through to them */
  pointer-events:none;
}
.beyond__link{pointer-events:auto}
.beyond__text{
  font-family:var(--sans);font-weight:700;
  font-size:clamp(2.2rem,1.3rem + 3.6vw,5.2rem);
  letter-spacing:-.035em;
  dominant-baseline:middle;
  white-space:pre;
  fill:var(--dot);
}
.beyond__text .w{transition:fill .35s var(--ease)}
.beyond__text .w.is-on{fill:var(--ink)}
.beyond__link{cursor:pointer}
.beyond__link .w.is-on{fill:#ffe600}
.beyond__link:hover .w.is-on{fill:#ffd900}
.beyond__text .w.is-key{
  font-family:var(--serif-2);font-style:italic;font-weight:400;
  font-size:1.14em;letter-spacing:-.01em;
}
/* polaroids — an HTML layer on the snake's spine that travels slower than
   the text, so a handful of photos last the whole passage with two or three
   in view at a time. They sit in bands above and below the text's reach. JS
   sets each one's --x/--y, a per-frame --dx for the near/far ones so they
   drift at their own speed, and --vb (a touch of blur while scrolling,
   cleared when it stops). Counter-rotated so they sit upright with a tilt
   (--r). data-depth="near" is bigger and softer, "far" smaller and further
   back. */
.beyond__pols{
  position:absolute;left:50%;top:50%;width:0;height:0;
  transform-origin:0 0;
  will-change:transform;
}
/* --focus (0–1, set by JS from how near the pointer is) brings a polaroid
   into focus: it sharpens, loses its tilt and lifts a touch */
@property --focus{syntax:"<number>";inherits:false;initial-value:0}
.beyond__pol{
  position:absolute;left:calc(var(--x,0px) + var(--dx,0px));top:var(--y,0px);
  width:clamp(160px,14vw,240px);
  margin:0;padding:8px 8px 36px;
  background:var(--paper);border-radius:4px;
  box-shadow:0 0 0 1px var(--line),0 26px 46px -18px rgba(0,0,0,.22),0 6px 14px -4px rgba(0,0,0,.07);
  --focus:0;
  /* --pop: how much a card grows in focus (hover a little, a tap/pin a lot) */
  --pop:.1;
  transform:translate(-50%,-50%) rotate(calc(var(--th) + var(--r,0deg) * (1 - var(--focus)))) scale(calc(var(--s,1) + var(--focus) * var(--pop)));
  filter:blur(calc((var(--b,0px) + var(--vb,0px)) * (1 - var(--focus))));
  transition:--focus .45s var(--ease);
  /* tap to sharpen, press and drag to pick up and throw (JS); none, so a
     drag is ours on touch too */
  pointer-events:auto;touch-action:none;cursor:grab;
  user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;
}
.beyond__pol img{pointer-events:none;-webkit-user-drag:none}
.beyond__pol.is-focus{z-index:3}
.beyond__pol[data-pin]{--pop:.28;z-index:4}
.beyond__pol.is-held{
  z-index:6;cursor:grabbing;
  box-shadow:0 0 0 1px var(--line),0 40px 70px -20px rgba(0,0,0,.35),0 10px 24px -6px rgba(0,0,0,.12);
}
.beyond__pol[data-depth="near"]{--s:1.15;--b:1px;z-index:2}
.beyond__pol[data-depth="far"]{--s:.78;--b:.5px;opacity:.94}
/* desktop: the plain and far cards a touch (8%) bigger; the near ones are
   big enough already */
@media (min-width:881px){
  .beyond__pol{--s:1.08}
  .beyond__pol[data-depth="far"]{--s:.84}
}
.beyond__pol img,
.beyond__pol__ph{
  /* height:auto so the img's height attribute doesn't beat aspect-ratio */
  display:block;width:100%;height:auto;aspect-ratio:1;
  object-fit:cover;border-radius:2px;
}
.beyond__pol__ph{
  background:
    repeating-linear-gradient(45deg,var(--dot) 0 2px,transparent 2px 10px),
    var(--line);
}
.beyond__pol figcaption{
  position:absolute;left:0;right:0;bottom:8px;
  font-family:var(--hand);font-weight:600;
  font-size:1.2rem;line-height:1;
  text-align:center;color:var(--ink-2);
}
/* a quiet way past (or back out of) the passage: sits bottom-right while
   the frame is pinned */
.beyond__nav{
  position:absolute;right:var(--pad);bottom:clamp(1.25rem,3vw,2.25rem);
  z-index:5;display:flex;gap:.5rem;
}
.beyond__skip{
  display:inline-flex;align-items:center;gap:.45em;
  font:600 .8rem/1 var(--sans);letter-spacing:.06em;text-transform:uppercase;
  color:var(--ink);background:rgba(255,255,255,.7);
  border:1px solid var(--line);border-radius:999px;
  /* all caps, no descenders: a touch more on top sits the glyphs on centre */
  padding:.78em 1em .62em;cursor:pointer;
  backdrop-filter:blur(6px);
  transition:background .25s var(--ease),border-color .25s var(--ease),transform .25s var(--ease);
}
.beyond__skip:hover{background:#fff;border-color:var(--dot);transform:translateY(-1px)}
.beyond__skip:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
@media (max-width:880px){
  .beyond__text{font-size:clamp(1.9rem,1rem + 4.4vw,2.8rem)}
  .beyond__pol{width:clamp(124px,34vw,170px);padding:6px 6px 28px}
  /* phones: next to no depth blur, the cards are small enough already;
     scale and opacity carry the depth, a tap pops one sharp and big */
  .beyond__pol[data-depth="near"]{--b:.35px}
  .beyond__pol[data-depth="far"]{--b:.25px}
  .beyond__pol figcaption{font-size:1rem;bottom:5px}
}
@media (prefers-reduced-motion:reduce){
  .beyond{height:auto}
  .beyond__frame{position:static;height:70vh;height:70svh}
  .beyond__text .w{fill:var(--ink);transition:none}
}

/* ===================================================== testimonials */
.testimonials{
  position:relative;z-index:2;
  padding:clamp(2rem,4vw,3rem) 0;
}
.testimonials__shell{
  background:#0a0a0a;color:#fff;
  position:relative;
  padding:clamp(4rem,8vw,7rem) 0;
  clip-path:inset(0 40px round 32px);
  animation:expandCard linear both;
  animation-timeline:view();
  animation-range:entry 30% cover 25%;
}
@keyframes expandCard{
  to{clip-path:inset(0 0 round 0)}
}
@media (max-width:880px){
  .testimonials__shell{clip-path:inset(0 20px round 28px)}
}
.testimonials__card{
  position:relative;z-index:1;
  max-width:1900px;margin:0 auto;
  padding:0 clamp(2rem,5vw,5rem);
  display:grid;
  /* the head column needs a floor — otherwise the 1000px quote column
     starves it at ~1280px and the title wraps to a ragged three lines */
  grid-template-columns:minmax(min(100%,22rem),1fr) minmax(0,1000px);
  gap:clamp(2.5rem,6vw,6rem);
  align-items:start;
}
@media (max-width:880px){
  .testimonials__card{grid-template-columns:1fr;gap:clamp(2rem,5vw,3rem)}
}
.testimonials__head{
  align-self:stretch;
  display:block;
}
.testimonials__head-inner{
  position:sticky;
  top:clamp(4rem,8vw,7rem);
  display:flex;flex-direction:column;
}
@media (max-width:880px){
  .testimonials__head-inner{position:static;top:auto;margin-bottom:2rem}
}
.testimonials__gif{
  width:170px;height:auto;
  border-radius:12px;
  margin-bottom:1.5rem;
  display:block;
  filter:grayscale(.15) contrast(1.05);
  box-shadow:0 16px 32px -10px rgba(0,0,0,.6);
}
.testimonials__title{
  font-family:var(--sans);font-weight:700;
  font-size:var(--h2);
  letter-spacing:-.035em;line-height:1.05;
  margin:0;color:#fff;
  text-wrap:balance;
}
.testimonials__title sup{
  color:#ffe600;
  font-size:.65em;
  font-weight:600;
  top:-.45em;
}
.testimonials__sub{
  font-size:16px;
  color:#999;
  font-family:var(--serif);font-style:italic;
  margin:1rem 0 0;line-height:1.45;
  white-space:nowrap;
}
.testimonials__list{
  column-count:2;
  column-gap:clamp(2rem,3.5vw,3.75rem);
}
@media (max-width:680px){
  .testimonials__list{column-count:1}
  .testimonials__title{font-size:var(--h2)}
  .testimonials__sub{font-size:1.1rem;color:#bdbdbd;line-height:1.5}
  .testimonial__stars{font-size:18.5px;gap:4px;margin-bottom:18px}
  .testimonial__quote{font-size:1.12rem;line-height:1.6;color:#e2e2e2;margin:0 0 1.5rem}
  .testimonial__by strong{font-size:1.05rem}
  .testimonial__by span{font-size:.95rem}
}
.testimonial{
  break-inside:avoid;
  margin-bottom:clamp(2.5rem,3.5vw,3.25rem);
  padding-bottom:clamp(1.5rem,3vw,2rem);
  border-bottom:1px solid rgba(255,255,255,.08);
}
/* fade each testimonial in once as it enters the viewport (IntersectionObserver-driven) */
.testimonial{
  opacity:0;transform:translateY(24px);
  transition:opacity 1s var(--ease) .25s, transform 1s var(--ease) .25s;
}
.testimonial.is-visible{opacity:1;transform:translateY(0)}
@media (prefers-reduced-motion:reduce){
  .testimonial{opacity:1;transform:none;transition:none}
}

/* 5-star row above each testimonial — staggers in after the testimonial fades */
.testimonial__stars{
  display:flex;gap:3px;
  margin-bottom:14px;
  font-size:16.2px;line-height:1;
  color:#fde047;
}
.testimonial__star{
  display:inline-block;
  opacity:0;transform:scale(.4) rotate(-25deg);
  transition:opacity .45s cubic-bezier(.34,1.6,.64,1), transform .45s cubic-bezier(.34,1.6,.64,1);
}
.testimonial.is-visible .testimonial__star{
  opacity:1;transform:scale(1) rotate(0);
  transition-delay:calc(.7s + var(--i, 0) * .14s);
}
@media (prefers-reduced-motion:reduce){
  .testimonial__star{opacity:1;transform:none;transition:none}
}

.testimonial:last-child{border-bottom:0;padding-bottom:0;margin-bottom:0}
.testimonial__quote{
  font-size:clamp(.92rem,.88rem + .15vw,1rem);
  line-height:1.55;
  color:#d4d4d4;
  margin:0 0 1.4rem;
}
.testimonial__quote p{margin:0 0 .85rem}
.testimonial__quote p:last-child{margin-bottom:0}
.testimonial__by{
  font-size:.85rem;
  color:#888;line-height:1.4;
}
.testimonial__by strong{color:#fff;font-weight:600;display:block;letter-spacing:-.005em;font-size:.95rem}
.testimonial__by span{font-family:var(--serif);font-style:italic}

.testimonials__more{display:none}
@media (max-width:680px){
  .testimonial.is-extra{display:none}
  .testimonials.is-expanded .testimonial.is-extra{display:block}
  .testimonials__more{
    display:inline-flex;align-items:center;gap:8px;
    width:auto;justify-self:start;
    margin-top:1.5rem;
    padding:14px 22px;border-radius:999px;
    background:#fff;color:#000;border:0;
    font-family:var(--sans);font-weight:600;font-size:.92rem;
    cursor:pointer;
    transition:transform .25s var(--ease),background .25s var(--ease);
  }
  .testimonials__more:hover{transform:translateY(-2px);background:#ffe600}
  .testimonials.is-expanded .testimonials__more{display:none}
}

/* @shared: secret-footer */
/* ===================================================== secret footer */
.secret-footer{
  position:fixed;left:0;right:0;bottom:0;
  height:62vh;z-index:1;
  background:#070707;
  background-image:
    linear-gradient(to right, rgba(255,255,255,.015) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,.015) 1px, transparent 1px);
  background-size:32px 32px;
  color:#fff;overflow:hidden;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:6vh var(--pad);
  cursor:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><circle cx='16' cy='16' r='13' fill='%23fde047' stroke='%23000' stroke-width='1.6'/><circle cx='12' cy='13' r='1.6' fill='%23000'/><circle cx='20' cy='13' r='1.6' fill='%23000'/><path d='M10.5 18.5 Q16 24 21.5 18.5' stroke='%23000' stroke-width='1.8' fill='none' stroke-linecap='round'/></svg>") 16 16, default;
}
.secret-footer *{
  cursor:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><circle cx='16' cy='16' r='13' fill='%23fde047' stroke='%23000' stroke-width='1.6'/><circle cx='12' cy='13' r='1.6' fill='%23000'/><circle cx='20' cy='13' r='1.6' fill='%23000'/><path d='M10.5 18.5 Q16 24 21.5 18.5' stroke='%23000' stroke-width='1.8' fill='none' stroke-linecap='round'/></svg>") 16 16, pointer;
}
.secret-footer__eyebrow{
  position:absolute;top:9vh;left:50%;
  width:max-content;max-width:90vw;
  margin-left:auto;
  font-size:.85rem;font-weight:500;
  letter-spacing:.08em;
  color:rgba(255,255,255,.6);
  text-align:center;margin:0;line-height:1.4;
  transform:translateX(-50%) translateY(-15px) scale(.85);
}
.secret-footer__head{
  font-family:var(--serif);
  font-weight:400;font-style:italic;
  font-size:clamp(2.6rem,1.4rem + 7vw,8rem);
  line-height:1;letter-spacing:-.01em;
  margin:0;position:relative;text-align:center;
  opacity:0;transform:scale(.55);
}
.secret-footer__head em{font-style:italic;color:#fff}
.secret-footer__head .nonit{font-style:normal;font-weight:400;font-family:var(--serif)}
.secret-footer.is-revealed .secret-footer__head{
  animation:
    headReveal 1s cubic-bezier(.34,1.5,.64,1) forwards,
    headBounce 4.5s ease-in-out 1.05s infinite;
}
@keyframes headReveal{
  to{opacity:1;transform:scale(1)}
}
@keyframes headBounce{
  0%,100%{transform:scale(1) translateY(0)}
  50%{transform:scale(1) translateY(-10px)}
}
.secret-pill{
  position:absolute;
  display:inline-flex;align-items:center;
  padding:7px 14px;border-radius:999px;
  background:#070707;border:1px solid rgba(255,255,255,.3);
  color:#fff;
  font-family:var(--sans);font-size:.72rem;font-weight:600;letter-spacing:.06em;
  text-transform:uppercase;white-space:nowrap;
  opacity:0;
}
.secret-pill--cmon{top:-30%;left:6%}
.secret-pill--just{top:-12%;left:14%;bottom:auto}
.secret-footer.is-revealed .secret-pill--cmon{
  animation:
    pillIn .6s cubic-bezier(.34,1.6,.64,1) .55s forwards,
    floatA 3.4s ease-in-out 1.2s infinite;
}
.secret-footer.is-revealed .secret-pill--just{
  animation:
    pillIn .6s cubic-bezier(.34,1.6,.64,1) .7s forwards,
    floatB 3.8s ease-in-out 1.35s infinite;
}
@keyframes pillIn{
  from{opacity:0;transform:scale(.4) rotate(0deg)}
  to{opacity:1;transform:scale(1) rotate(var(--pill-r))}
}
.secret-pill--cmon{--pill-r:-9deg}
.secret-pill--just{--pill-r:6deg}
@keyframes floatA{
  0%,100%{transform:translateY(0) rotate(-9deg)}
  50%{transform:translateY(-10px) rotate(-13deg)}
}
@keyframes floatB{
  0%,100%{transform:translateY(0) rotate(6deg)}
  50%{transform:translateY(-7px) rotate(10deg)}
}

.secret-footer__bottom{
  position:absolute;bottom:8vh;left:50%;
  transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:.85rem;
  width:max-content;max-width:90vw;
  text-align:center;
}
.secret-footer__cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:14px 26px;border-radius:999px;
  background:#fff;color:#000;
  text-decoration:none;font-weight:600;font-size:.95rem;
  transition:transform .55s cubic-bezier(.34,1.5,.64,1), background .35s var(--ease), padding .55s cubic-bezier(.34,1.5,.64,1);
  opacity:0;transform:translateY(20px) scale(.85);
}
.secret-footer.is-revealed .secret-footer__cta{
  animation:elemIn .8s cubic-bezier(.34,1.5,.64,1) .55s forwards;
}
.secret-footer__cta:hover{
  transform:translateY(-6px) scale(1.14) rotate(-1deg)!important;
  background:#fde047;
  padding:16px 32px;
  box-shadow:0 18px 40px -12px rgba(253,224,71,.55);
}
.secret-footer__cta:active{
  transform:translateY(-2px) scale(1.06) rotate(0deg)!important;
  transition:transform .12s var(--ease);
}
.secret-footer__cta .arr{
  display:inline-block;
  transition:transform .55s cubic-bezier(.34,1.5,.64,1);
}
.secret-footer__cta:hover .arr{transform:translate(4px,-4px) rotate(8deg)}

.secret-footer__tag{
  font-size:14px;color:rgba(255,255,255,.55);
  margin:0;line-height:1.4;font-family:var(--sans);
  white-space:nowrap;
  opacity:0;transform:translateY(15px);
}
.secret-footer.is-revealed .secret-footer__tag{
  animation:elemIn .8s var(--ease) .8s forwards;
}

.secret-footer__eyebrow{opacity:0}
.secret-footer.is-revealed .secret-footer__eyebrow{
  animation:eyebrowIn .8s cubic-bezier(.34,1.5,.64,1) .35s forwards;
}
@keyframes eyebrowIn{
  from{opacity:0;transform:translateX(-50%) translateY(-15px) scale(.85)}
  to{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}
}

@keyframes elemIn{
  to{opacity:1;transform:translateY(0) scale(1)}
}

/* secret footer mobile fixes */
@media (max-width:720px){
  body{padding-bottom:54vh}
  .secret-footer{
    height:54vh;
    padding:4vh 1rem;
  }
  .secret-footer__eyebrow{
    top:4vh;
    font-size:.7rem;
    letter-spacing:.06em;
    line-height:1.4;
  }
  .secret-footer__head{
    font-size:clamp(1.55rem,7vw,2.4rem);
    line-height:1.1;
    padding:0 1.25rem;
    max-width:100%;
    overflow-wrap:break-word;
  }
  /* faster, snappier reveal so it doesn't sit on a black void */
  .secret-footer.is-revealed .secret-footer__head{
    animation:
      headReveal .55s cubic-bezier(.34,1.6,.64,1) forwards,
      headBounce 4.5s ease-in-out .6s infinite;
  }
  .secret-footer.is-revealed .secret-footer__eyebrow{
    animation:eyebrowIn .5s cubic-bezier(.34,1.6,.64,1) .15s forwards;
  }
  .secret-footer.is-revealed .secret-footer__cta{
    animation:elemIn .55s cubic-bezier(.34,1.6,.64,1) .3s forwards;
  }
  .secret-footer.is-revealed .secret-footer__tag{
    animation:elemIn .55s var(--ease) .45s forwards;
  }
  /* keep the floating pills on mobile for the magic — just reposition
     so they sit clear of the headline */
  .secret-pill{
    display:inline-flex;
    font-size:.62rem;
    padding:6px 12px;
  }
  .secret-pill--cmon{top:-58%;left:4%}
  .secret-pill--just{top:-30%;left:18%;bottom:auto;right:auto}
  .secret-footer.is-revealed .secret-pill--cmon{
    animation:
      pillIn .5s cubic-bezier(.34,1.6,.64,1) .3s forwards,
      floatA 3.4s ease-in-out .85s infinite;
  }
  .secret-footer.is-revealed .secret-pill--just{
    animation:
      pillIn .5s cubic-bezier(.34,1.6,.64,1) .42s forwards,
      floatB 3.8s ease-in-out 1s infinite;
  }
  .secret-footer__bottom{
    bottom:calc(env(safe-area-inset-bottom, 0px) + 36px);
    width:100%;left:0;right:0;transform:none;
    max-width:none;
    align-items:center;
  }
  .secret-footer__cta{
    padding:13px 24px;font-size:.9rem;
  }
  .secret-footer__tag{
    font-size:.7rem;
    white-space:nowrap;text-align:center;
  }
}
/* @end-shared */

