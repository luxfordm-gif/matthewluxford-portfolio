/* ============================================================ hello */
/* the nav's About link lands here; same fixed-nav allowance as #work */
#hello{scroll-margin-top:calc(var(--nav-h) + var(--anchor-gap))}
/* the About intro. Default: the hero's profile card slides down and lands
   here, so this is a single centred column with --land of room on top (JS
   measures it). Layout panel → About intro → "Card beside copy" brings back
   the first take: its own photo card on the left, copy on the right. */
.hello{
  position:relative;z-index:2;
  padding:clamp(2rem,4vw,4rem) var(--pad) clamp(5rem,9vw,8rem);
}
.hello__inner{
  max-width:1180px;margin:0 auto;
  display:grid;grid-template-columns:minmax(0,400px) minmax(0,1fr);
  gap:clamp(3rem,7vw,7rem);align-items:center;
}
.hello__card{
  margin:0;padding:12px 12px 14px;
  background:var(--paper);border-radius:34px;
  box-shadow:0 1px 2px rgba(10,10,10,.06),0 24px 60px -18px rgba(10,10,10,.22),0 60px 120px -40px rgba(10,10,10,.18);
  transform:rotate(-4deg);
  transition:transform .6s var(--ease),box-shadow .6s var(--ease);
}
.hello__card.reveal-up{transform:rotate(-4deg) translateY(20px)}
.is-revealed .hello__card.reveal-up{transform:rotate(-4deg)}
.is-revealed .hello__card.reveal-up:hover{transform:rotate(-1.5deg) translateY(-6px);transition-delay:0s}
.hello__photo{
  position:relative;overflow:hidden;
  aspect-ratio:4/5;border-radius:24px;background:#000;
}
.hello__photo img{display:block;width:100%;height:100%;object-fit:cover}
.hello__card-foot{
  display:flex;align-items:center;justify-content:space-between;gap:.75rem;
  padding:14px 6px 0 8px;
}
.hello__who{display:flex;align-items:center;gap:.6rem;min-width:0}
.hello__handle,.hello__site{display:block;line-height:1.25}
.hello__handle{font-size:.9rem;font-weight:500;color:var(--ink)}
.hello__site{font-size:.8rem;color:var(--muted-strong)}
.hello__connect{
  flex:none;display:inline-flex;align-items:center;gap:.4rem;
  padding:.7rem 1.15rem;border-radius:999px;
  background:var(--ink);color:#fff;text-decoration:none;
  font-size:.9rem;font-weight:500;
  transition:transform .3s var(--ease),background .3s var(--ease);
}
.hello__connect:hover{background:var(--ink-2);transform:translateY(-1px)}
.hello__connect:focus-visible{outline:2px solid var(--ink);outline-offset:3px}

.hello__vh{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.hello__lead{
  margin:0 0 clamp(1.5rem,2.5vw,2.25rem);
  font-weight:500;font-size:clamp(1.5rem,1rem + 1.7vw,2.7rem);
  line-height:1.2;letter-spacing:-.03em;color:var(--ink);
  max-width:24ch;
}
.hello__body,.hello__aside{
  margin:0;max-width:52ch;color:var(--muted-strong);
  font-size:clamp(1rem,.95rem + .25vw,1.15rem);letter-spacing:-.01em;
}
.hello__body{line-height:1.7;margin-bottom:1.5rem}
.hello__aside{line-height:1.6}
.hello__aside b{font-weight:500;color:var(--ink-2)}
.hello__body strong{font-weight:500;color:var(--ink)}
.hello__body a{
  color:var(--ink);text-decoration:underline;text-decoration-color:var(--dot);
  text-underline-offset:.25em;text-decoration-thickness:1px;
  transition:text-decoration-color .25s;
}
.hello__body a:hover{text-decoration-color:var(--ink)}
@media (max-width:760px){
  /* a wider gutter than the page's --pad, so the intro copy reads as a
     narrower, calmer column on a phone */
  .hello{padding-left:calc(var(--pad) + 1rem);padding-right:calc(var(--pad) + 1rem)}
  .hello__inner{grid-template-columns:1fr;gap:3.5rem}
  .hello__card{width:min(100%,340px);margin:0 auto}
}
@media (prefers-reduced-motion:reduce){
  .hello__card,.hello__card.reveal-up,.is-revealed .hello__card.reveal-up:hover{transform:rotate(-4deg);transition:none}
}
html:not([data-pref-intro="beside"]) .hello{padding-top:var(--land,clamp(2rem,4vw,4rem))}
/* the column is as wide as the copy's measure, so the left-aligned block
   sits in the middle of the page rather than hugging the left of a wider box */
html:not([data-pref-intro="beside"]) .hello__inner{display:block;max-width:min(100%,720px)}
html:not([data-pref-intro="beside"]) .hello__card{display:none}
html:not([data-pref-intro="beside"]) .hello__lead,
html:not([data-pref-intro="beside"]) .hello__body,
html:not([data-pref-intro="beside"]) .hello__aside{max-width:none}

/* ========================================================= work life */
/* horizontal scrubber timeline: one bar per role on a year axis. --s/--e
   are start/end years as decimals. The axis runs from --early, but the
   years up to --brk are squeezed to --yr0 each (one long agency stretch,
   not eight years of empty track), then --yr each to --to. Green bars
   are life, not work. Hover (or tap /
   focus) a bar and three cards slide up from behind it and fan out, like
   pulling photos out of a folder: the bar's face is a frosted ::before
   sitting above the cards, with the label above both. */
.tl{
  position:relative;z-index:2;
  --yr:150px;--yr0:46px;--early:2007;--brk:2015;--to:2027;
  padding:clamp(4rem,8vw,7rem) 0 clamp(3rem,6vw,5rem);
}
/* same title as the deck above: a step down from --h2, italic second line */
.tl__head{max-width:1400px;margin:0 auto;padding:0 var(--pad);text-align:center}
.tl__title{
  font-family:var(--sans);font-weight:500;
  font-size:calc(var(--h2) * .78);
  letter-spacing:-.03em;line-height:1.08;
  margin:0 auto;color:var(--ink);
  text-wrap:balance;
}
.tl__hint{margin:.9rem 0 0;font-size:1rem;color:var(--muted-strong)}
.tl__hint .tl__hint--phone{display:none}
.tl__scroller{
  overflow-x:auto;overflow-y:hidden;scrollbar-width:none;
  cursor:grab;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 var(--pad),#000 calc(100% - 6rem),transparent);
          mask-image:linear-gradient(90deg,transparent,#000 var(--pad),#000 calc(100% - 6rem),transparent);
}
.tl__scroller::-webkit-scrollbar{display:none}
.tl__view{position:relative}
.tl__scroller{position:relative;z-index:2}
/* the needle: where you are along the years. A hairline behind the bars
   with a dark pill on the axis reading the month and year under it. */
/* no z-index of its own, so the hairline can sit behind the bars while the
   pill rides over the year labels on the axis */
.tl__needle{position:absolute;top:0;left:0;width:0;height:0;pointer-events:none}
.tl__needle::before{
  content:"";position:absolute;z-index:1;left:-.75px;top:1.4rem;bottom:0;width:1.5px;border-radius:2px;
  background:linear-gradient(var(--ink),rgba(10,10,10,0));
  transform:translateX(var(--walk,0px));
}
.tl__needle-label{
  position:absolute;z-index:8;top:0;left:0;transform:translateX(calc(var(--walk,0px) - 50%));
  padding:.28rem .6rem;border-radius:999px;
  background:var(--ink);color:#fff;
  font-size:.75rem;font-weight:600;letter-spacing:.01em;line-height:1.1;
  font-variant-numeric:tabular-nums;white-space:nowrap;
  box-shadow:0 6px 16px -6px rgba(10,10,10,.45);
}
.tl__needle-label::after{
  content:"";position:absolute;left:50%;bottom:-4px;width:8px;height:8px;
  background:inherit;transform:translateX(-50%) rotate(45deg);border-radius:1px;z-index:-1;
}
.tl__scroller.is-dragging{cursor:grabbing;user-select:none}
.tl__scroller:focus-visible{outline:2px solid var(--ink);outline-offset:-2px}
/* the track is as wide as the needle's whole journey (JS sets --pad-l and
   --pad-r so the needle can stand on today at one end and 2007 at the
   other). The years ride in .tl__inner, which is sticky: scrolling back, it
   stops once 2007 reaches the left edge (JS sets --stick for that), and
   from there the needle walks left instead, so the far end is never a
   screen of empty track. */
.tl__track{
  --w:calc((var(--brk) - var(--early)) * var(--yr0) + (var(--to) - var(--brk)) * var(--yr));
  position:relative;display:flex;align-items:flex-start;
  width:calc(var(--pad-l,0px) + var(--w) + var(--pad-r,0px));
}
/* a spacer, not a margin: a sticky box can't slide into its own margin */
.tl__track::before{content:"";flex:none;width:var(--pad-l,0px)}
.tl__inner{
  position:sticky;right:var(--stick,0px);
  flex:none;width:var(--w);
}
/* x along the years for --y (axis), --s and --e (bars) */
.tl__axis li{--x:calc((clamp(var(--early),var(--y),var(--brk)) - var(--early)) * var(--yr0) + (max(var(--y),var(--brk)) - var(--brk)) * var(--yr))}
.tl__bar{
  --xs:calc((clamp(var(--early),var(--s),var(--brk)) - var(--early)) * var(--yr0) + (max(var(--s),var(--brk)) - var(--brk)) * var(--yr));
  --xe:calc((clamp(var(--early),min(var(--e),var(--to)),var(--brk)) - var(--early)) * var(--yr0) + (max(min(var(--e),var(--to)),var(--brk)) - var(--brk)) * var(--yr));
}
.tl__axis{
  list-style:none;margin:clamp(1.5rem,3vw,2.5rem) 0 0;padding:0;
  position:relative;height:2.6rem;border-bottom:1px solid var(--line);
}
.tl__axis li{
  position:absolute;bottom:0;left:var(--x);
  transform:translateX(-50%);padding-bottom:.9rem;
  font-size:.9rem;color:var(--muted-strong);font-variant-numeric:tabular-nums;
}
.tl__axis li::after{content:"";position:absolute;left:50%;bottom:0;width:1px;height:.4rem;background:var(--line)}
/* the squeezed years: a tick each, no label */
.tl__axis li.tl__minor{padding-bottom:0;width:1px;height:.3rem}
.tl__axis li.tl__minor::after{height:.3rem}
.tl__rows{
  list-style:none;margin:0;padding:170px 0 1rem;
  display:flex;flex-direction:column;gap:10px;
}
.tl__row{position:relative;height:46px}
.tl__bar{
  position:absolute;top:0;bottom:0;
  left:var(--xs);
  width:calc(var(--xe) - var(--xs));
  min-width:max-content;
  display:flex;align-items:center;gap:.6rem;
  padding:0 1rem;border-radius:10px;
  font-size:.95rem;white-space:nowrap;
  outline:none;cursor:default;isolation:isolate;
  /* the open bar comes to the top at once; closing, it stays there until its
     cards have vanished so they never drop behind (or across) a neighbour */
  z-index:0;transition:z-index 0s .12s;
}
.tl__bar.is-open,.tl__bar:focus-within{z-index:6;transition-delay:0s}
.tl__bar::before{
  content:"";position:absolute;inset:0;z-index:1;border-radius:inherit;
  background:rgba(241,239,234,.86);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.7);
  transition:background .25s var(--ease),box-shadow .25s var(--ease);
}
.tl__bar>:not(.tl__fan){position:relative;z-index:2}
.tl__bar.is-open::before,.tl__bar:focus-within::before{background:rgba(233,230,223,.8);box-shadow:inset 0 1px 0 rgba(255,255,255,.7),0 18px 30px -18px rgba(10,10,10,.35)}
.tl__bar:focus-visible::before{box-shadow:0 0 0 2px var(--ink)}
.tl__bar--now::before{
  -webkit-mask-image:linear-gradient(90deg,#000 70%,transparent);
          mask-image:linear-gradient(90deg,#000 70%,transparent);
}
/* a holiday is a moment, not a span: the green block is only as wide as
   the trip (a few px, so a 12px floor), and the
   words hang beside it with no background so nothing reads as duration */
.tl__bar--life{min-width:12px;padding:0;gap:.5rem;overflow:visible}
.tl__bar--life::before{
  right:auto;width:max(12px,100%);border-radius:4px;
  background:#ceead6;box-shadow:inset 0 0 0 1px rgba(30,142,62,.18);
}
.tl__bar--life.is-open::before,.tl__bar--life:focus-within::before{background:#bfe3c9}
.tl__bar--life>.tl__role{margin-left:calc(max(12px,100%) + .7rem);white-space:nowrap}
.tl__logo,.tl__mono{flex:none;width:20px;height:20px;border-radius:5px}
.tl__mono{
  display:grid;place-items:center;
  background:var(--ink);color:#fff;font-size:.62rem;font-weight:700;letter-spacing:-.02em;
}
.tl__role{font-weight:500;color:var(--ink)}
.tl__org{color:var(--muted-strong)}
/* a job leads with the company, the role after it in grey */
.tl__bar:not(.tl__bar--life)>.tl__org{font-weight:500;color:var(--ink)}
.tl__bar:not(.tl__bar--life)>.tl__role{font-weight:400;color:var(--muted-strong)}
.tl__bar>.tl__when{
  position:absolute;left:calc(100% + 1rem);top:50%;transform:translateY(-50%);
  color:var(--muted-strong);font-variant-numeric:tabular-nums;
}
.tl__bar--now .tl__when{display:none}
.tl__now{color:var(--muted-strong);font-variant-numeric:tabular-nums}

/* the fan: cards wait tucked inside the bar, behind its frosted face, then
   pop up over everything with a springy overshoot, and on the way back
   shrink and vanish at once rather than lingering over other rows. */
.tl__fan{position:absolute;z-index:0;left:min(50%,170px);top:50%;width:0;height:0;pointer-events:none}
.tl__card{
  position:absolute;left:-75px;bottom:-40px;
  width:150px;aspect-ratio:4/3;padding:3px;
  background:var(--paper);border-radius:13px;
  box-shadow:0 1px 2px rgba(10,10,10,.08),0 16px 34px -12px rgba(10,10,10,.35);
  opacity:0;transform:scale(.7);transform-origin:50% 100%;
  transition:transform .18s cubic-bezier(.4,0,1,1),opacity .1s linear;
}
.tl__bar.is-open .tl__card,.tl__bar:focus-within .tl__card{
  opacity:1;transition:transform .5s cubic-bezier(.3,1.5,.5,1),opacity .08s;
}
.tl__card img{display:block;width:100%;height:100%;object-fit:cover;border-radius:10px}
.tl__card--txt{
  display:grid;place-items:center;padding:.7rem;text-align:center;white-space:normal;text-wrap:balance;
  font-size:.8rem;font-weight:600;line-height:1.2;letter-spacing:-.01em;color:var(--ink);
  background:var(--paper);
}
.tl__card--list{
  display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:.2rem;padding:.6rem .75rem;
  text-align:left;font-size:.74rem;font-weight:500;line-height:1.25;
}
.tl__card--list b{font-size:.6rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-strong)}
.tl__card--ph{background:repeating-linear-gradient(-45deg,#f6f4ef 0 6px,#eeebe4 6px 12px);color:var(--muted-strong);font-weight:500}
.tl__bar.is-open .tl__card:nth-child(1),.tl__bar:focus-within .tl__card:nth-child(1){transform:translate(-118px,-92px) rotate(-12deg)}
.tl__bar.is-open .tl__card:nth-child(2),.tl__bar:focus-within .tl__card:nth-child(2){transform:translate(0,-120px) rotate(0deg);transition-delay:.05s}
.tl__bar.is-open .tl__card:nth-child(3),.tl__bar:focus-within .tl__card:nth-child(3){transform:translate(118px,-90px) rotate(11deg);transition-delay:.1s}
/* the middle card sits on top of its neighbours */
.tl__card:nth-child(2){z-index:1}
/* list cards are read edge to edge, so their fan spreads wide enough that
   none covers another's words */
.tl__fan--wide{left:min(50%,220px)}
.tl__bar.is-open .tl__fan--wide .tl__card:nth-child(1),.tl__bar:focus-within .tl__fan--wide .tl__card:nth-child(1){transform:translate(-156px,-86px) rotate(-9deg)}
.tl__bar.is-open .tl__fan--wide .tl__card:nth-child(3),.tl__bar:focus-within .tl__fan--wide .tl__card:nth-child(3){transform:translate(156px,-84px) rotate(8deg)}
@media (max-width:760px){
  .tl{--yr:105px;--yr0:32px}
  .tl__card{width:112px;left:-56px;bottom:-30px}
  .tl__bar.is-open .tl__card:nth-child(1),.tl__bar:focus-within .tl__card:nth-child(1){transform:translate(-88px,-80px) rotate(-12deg)}
  .tl__bar.is-open .tl__card:nth-child(2),.tl__bar:focus-within .tl__card:nth-child(2){transform:translate(0,-100px) rotate(0deg)}
  .tl__bar.is-open .tl__card:nth-child(3),.tl__bar:focus-within .tl__card:nth-child(3){transform:translate(88px,-78px) rotate(11deg)}
  .tl__bar.is-open .tl__fan--wide .tl__card:nth-child(1),.tl__bar:focus-within .tl__fan--wide .tl__card:nth-child(1){transform:translate(-116px,-74px) rotate(-9deg)}
  .tl__bar.is-open .tl__fan--wide .tl__card:nth-child(3),.tl__bar:focus-within .tl__fan--wide .tl__card:nth-child(3){transform:translate(116px,-72px) rotate(8deg)}
  .tl__rows{padding-top:150px}
  .tl__hint .tl__hint--desk{display:none}
  .tl__hint .tl__hint--phone{display:inline}
  /* phones: the timeline pins to the screen and scrolling the page travels
     back through the years. The section is a tall runway (JS sets its
     height) with a sticky pin; JS moves the track sideways and the
     staircase up with transforms, springing towards the scroll. The pin
     fills the screen; the staircase rises only as far as it takes to bring
     the last role to the bottom of it, so the journey ends on Ten London
     with the next section straight after, not a screen of empty track. */
  /* z-index 3: the last role now sits right above Beyond the screen, whose
     fade (.beyond::before) reaches up over it; the timeline draws on top */
  .tl.is-pinned{padding:0;z-index:3}
  .tl.is-pinned .tl__pin{
    position:sticky;top:0;height:100vh;height:100svh;
    display:flex;flex-direction:column;overflow:hidden;
    padding-top:calc(var(--tl-top,0px) + 1.5rem);
    transition:padding-top .45s var(--ease);
    touch-action:pan-y;
  }
  .tl.is-pinned .tl__view{flex:1;min-height:0;display:flex;flex-direction:column}
  .tl.is-pinned .tl__scroller{flex:1;min-height:0;overflow:hidden;cursor:auto}
  .tl.is-pinned .tl__track,.tl.is-pinned .tl__rows{will-change:transform}
  /* pinned, nothing scrolls natively: JS holds the years at the left edge */
  .tl.is-pinned .tl__inner{position:relative;right:auto}
  .tl.is-pinned .tl__axis{position:relative;z-index:6;background:linear-gradient(var(--bg) 70%,rgba(250,250,247,0))}
  .tl.is-pinned .tl__needle{z-index:3}
  .tl.is-pinned .tl__axis{margin-top:2.4rem}
}
@media (prefers-reduced-motion:reduce){
  .tl__card{transition:opacity .2s}
}

/* ========================================================= marquee */
.marquee{
  position:relative;z-index:2;
  border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  padding:clamp(1rem,2vw,1.4rem) 0;
  background:rgba(255,255,255,.55);backdrop-filter:blur(6px);overflow:hidden;
}
.marquee__track{display:flex;width:max-content;animation:scroll 42s linear infinite}
.marquee__list{
  display:flex;gap:clamp(1.5rem,4vw,3rem);align-items:center;
  padding:0 clamp(.75rem,2vw,1.5rem);
  font-weight:600;font-size:clamp(1.1rem,.9rem + .9vw,1.6rem);
  color:var(--ink);white-space:nowrap;letter-spacing:-.02em;
}
.marquee__list li:nth-child(even){color:var(--muted);font-weight:400;font-family:var(--serif);font-style:italic}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ============================================= scroll reveals (shared) */
/* One motion language reused across sections: a masked, per-word slide-up
   on big section headings (.reveal-h) plus a gentle fade-up for supporting
   copy (.reveal-up). Both fire when a [data-reveal] ancestor scrolls into
   view (JS adds .is-revealed). Initial hidden state is server-rendered so
   there's no flash — the targeted sections all sit below the fold. */
.reveal-h .rw{
  display:inline-block;overflow:hidden;vertical-align:bottom;
  padding-bottom:.14em;margin-bottom:-.14em;
}
.reveal-h .rw>span{
  display:inline-block;
  transform:translateY(110%);
  transition:transform 1.25s var(--ease);
  will-change:transform;
}
.is-revealed .reveal-h .rw>span{transform:translateY(0)}
.reveal-h .rw:nth-child(2)>span{transition-delay:.1s}
.reveal-h .rw:nth-child(3)>span{transition-delay:.2s}
.reveal-h .rw:nth-child(4)>span{transition-delay:.3s}

.reveal-up{
  opacity:0;transform:translateY(20px);
  transition:opacity 1s var(--ease),transform 1s var(--ease);
}
.is-revealed .reveal-up{
  opacity:1;transform:none;
  transition-delay:calc(.15s + var(--i,0) * .08s);
}
@media (prefers-reduced-motion:reduce){
  .reveal-h .rw{overflow:visible}
  .reveal-h .rw>span{transform:none;transition:none}
  .reveal-up{opacity:1;transform:none;transition:none}
}

/* ============================================================ work */
.work{position:relative;z-index:2;padding:var(--work-pad-top) 0 clamp(3rem,6vw,5rem)}
.work__head{
  padding:var(--work-head-pad-top) var(--pad) clamp(2rem,4vw,3rem);
  text-align:center;
}
/* A jump to #work used to land the section top at the viewport top, which put
   the title exactly its own padding below it — clamp()ed, so 115px on desktop
   (clears the 95px nav) but only 80px on mobile, where the nav then covered it.
   Cancel the section's own padding and land the *title* --anchor-gap below the
   nav instead, so it reads the same at every width. Visual layout untouched. */
#work{scroll-margin-top:calc(var(--nav-h) + var(--anchor-gap) - var(--work-pad-top) - var(--work-head-pad-top))}
.work__title{
  font-family:var(--sans);font-weight:700;
  font-size:clamp(2.45rem,1.3rem + 6.05vw,8.4rem);
  letter-spacing:-.05em;line-height:.9;
  margin:0;color:var(--ink);
}
/* the desktop ramp was eased down to sit alongside the section titles; mobile keeps
   the original scale, where the title is already tuned against a 375px column */
@media (max-width:760px){
  .work__title{font-size:clamp(2.6rem,1.4rem + 6.5vw,9rem)}
}
/* "(scroll to explore)" cue — desktop only; touch users get the dots instead */
.work__hint{
  display:none;margin-top:clamp(1rem,2vw,1.5rem);
  font-size:.85rem;color:var(--muted);
  letter-spacing:.06em;text-transform:uppercase;font-weight:600;
}
@media (min-width:761px){
  .work__hint{display:block}
}
.work__rail{
  display:grid;grid-auto-flow:column;
  grid-auto-columns:clamp(280px, 40vw, 520px);
  gap:clamp(1rem,2.5vw,2rem);
  padding:1rem var(--pad) 3rem;
  overflow-x:auto;overflow-y:visible;
  scroll-snap-type:x mandatory;
  scroll-padding-left:var(--pad);
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
}
.work__rail::-webkit-scrollbar{display:none}

.proj{
  scroll-snap-align:start;display:flex;flex-direction:column;gap:1rem;
  text-decoration:none;color:inherit;
}
/* caption reveals per-card (--i set on each .proj in JS); crumb trails its title */
.is-revealed .proj__crumb.reveal-up{transition-delay:calc(.23s + var(--i,0) * .08s)}
.is-revealed .proj__tags.reveal-up{transition-delay:calc(.31s + var(--i,0) * .08s)}

/* prev/next arrows under the work rail (desktop) */
.work__controls{
  display:flex;justify-content:center;gap:12px;
  padding:clamp(14px,3vw,22px) var(--pad) clamp(2rem,5vw,3rem);
}
.work__arrow{
  width:44px;height:44px;border-radius:50%;
  background:transparent;color:var(--ink);
  border:1px solid var(--line);padding:0;cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;
  transition:background .25s var(--ease), color .25s var(--ease), border-color .25s var(--ease), transform .25s var(--ease), opacity .25s var(--ease);
}
.work__arrow svg{display:block;width:18px;height:18px}
.work__arrow:hover{background:var(--ink);color:var(--paper);border-color:var(--ink);transform:translateY(-1px)}
.work__arrow:active{transform:translateY(0) scale(.96)}
.work__arrow[disabled]{opacity:.3;cursor:not-allowed;pointer-events:none}

/* pagination dots — mobile only */
.work__dots{display:none}
.work__dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--dot);border:0;padding:0;cursor:pointer;
  transition:background .3s var(--ease), transform .3s var(--ease), width .3s var(--ease);
}
.work__dot.is-active{
  background:var(--ink);
  width:22px;border-radius:999px;
}
@media (max-width:760px){
  .work__controls{display:none}
  .work__dots{
    display:flex;justify-content:center;gap:8px;
    padding:clamp(14px,3vw,22px) var(--pad) clamp(2rem,5vw,3rem);
  }
}

/* ===== Apple-style snap carousel on mobile ===== */
@media (max-width:760px){
  .work__rail{
    grid-auto-columns:78vw;
    gap:clamp(.6rem,2vw,1rem);
    padding-left:11vw;
    padding-right:11vw;
    scroll-padding-left:11vw;
    scroll-padding-inline:11vw;
    scroll-behavior:smooth;
    overscroll-behavior-x:contain;
  }
  .proj{
    scroll-snap-align:center;
    scroll-snap-stop:always;
  }
  .proj__media{
    border-radius:28px;
    transform-origin:center;
    will-change:transform;
  }
  /* gooey scale + fade as cards scroll across the viewport */
  @supports (animation-timeline:view()){
    .proj__media{
      animation:projGooey linear both;
      animation-timeline:view(inline);
      animation-range:cover 5% cover 95%;
    }
    @keyframes projGooey{
      0%,100%{
        transform:scale(.86);
        filter:saturate(.8) brightness(.92);
        opacity:.55;
      }
      50%{
        transform:scale(1);
        filter:saturate(1) brightness(1);
        opacity:1;
      }
    }
    .proj__caption,.proj__crumb{
      animation:projGooeyCaption linear both;
      animation-timeline:view(inline);
      animation-range:cover 5% cover 95%;
    }
    @keyframes projGooeyCaption{
      0%,100%{opacity:.45;transform:translateY(4px)}
      50%{opacity:1;transform:translateY(0)}
    }
  }
}
.proj__media{
  position:relative;aspect-ratio:5/4;border-radius:24px;overflow:hidden;
  display:grid;place-items:center;
  transition:transform .5s var(--ease),box-shadow .5s var(--ease);
}
.proj:hover .proj__media{
  transform:translateY(-6px);
  box-shadow:0 50px 80px -40px rgba(0,0,0,.32);
}
.proj__media--01{background:#2563eb}
.proj__video{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;display:block;
}
.proj__media--video{padding:0}
.proj__caption{margin-top:18px}
.proj__media--02{background:#fde68a}
.proj__media--03{background:#7f1d1d}
.proj__media--04{background:#1e293b}
.proj__media--05{background:linear-gradient(135deg,#7132E4 0%,#3a1d8a 100%)}
.proj__media--06{background:linear-gradient(135deg,#0f4d3a 0%,#08291e 100%)}
.proj__media--07{background:linear-gradient(135deg,#f97316 0%,#7c2d12 100%)}

.proj__badge{
  position:absolute;top:18px;right:18px;
  background:#0a0a0a;color:#fff;
  padding:6px 12px;border-radius:999px;
  font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  z-index:4;
  box-shadow:0 4px 10px -2px rgba(0,0,0,.4);
}
/* "Side project" reads the same as "Coming soon" now — kept as a hook */
.proj__badge--side{background:#0a0a0a;color:#fff}
.proj.is-soon .proj__media{
  filter:saturate(.9);
}
/* A work card with no destination yet carries no href, so it is neither
   focusable nor clickable. Suppress the hover lift too — a card that rises
   under the cursor is promising a click it cannot honour. */
.proj:not([href]){cursor:default}
.proj:not([href]):hover .proj__media{transform:none;box-shadow:none}

.proj__logo{
  position:absolute;top:18px;left:18px;
  width:54px;height:54px;border-radius:50%;
  background:#fff;color:var(--ink);
  display:grid;place-items:center;
  font-weight:700;letter-spacing:-.03em;font-size:.95rem;
  border:3px solid #fff;
  box-shadow:0 8px 22px -6px rgba(0,0,0,.45);z-index:3;
}

.laptop{
  width:80%;aspect-ratio:16/10;background:#1a1a1a;
  border-radius:14px 14px 6px 6px;padding:8px 8px 22px;position:relative;
  box-shadow:0 30px 50px -20px rgba(0,0,0,.5);
}
.laptop::after{
  content:"";position:absolute;left:50%;bottom:6px;
  transform:translateX(-50%);width:40%;height:4px;
  border-radius:0 0 6px 6px;background:#0a0a0a;
}
.laptop__screen{
  width:100%;height:100%;border-radius:8px;background:#fff;
  padding:10px;display:flex;flex-direction:column;gap:8px;overflow:hidden;
}
.mock-bar{display:flex;gap:5px;align-items:center}
.mock-bar i{width:7px;height:7px;border-radius:50%}
.mock-bar i:nth-child(1){background:#fca5a5}
.mock-bar i:nth-child(2){background:#fcd34d}
.mock-bar i:nth-child(3){background:#86efac}
.mock-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.mock-grid span{aspect-ratio:1;background:#f3f4f6;border-radius:4px}
.mock-grid span:nth-child(1){background:#dbeafe}
.mock-grid span:nth-child(3){background:#fef3c7}
.mock-line{height:6px;background:#f3f4f6;border-radius:999px}
.mock-line.s{width:50%}
.mock-line.d{background:#0a0a0a;width:30%;height:8px}

.phone{
  width:42%;aspect-ratio:9/19;background:#0a0a0a;
  border-radius:32px;padding:6px;position:relative;
  box-shadow:0 30px 50px -20px rgba(0,0,0,.55);
}
.phone::before{
  content:"";position:absolute;top:14px;left:50%;
  transform:translateX(-50%);width:50px;height:5px;
  border-radius:999px;background:#27272a;z-index:2;
}
.phone__screen{
  width:100%;height:100%;border-radius:26px;
  padding:30px 14px 14px;display:flex;flex-direction:column;gap:8px;
  background:linear-gradient(180deg,#fff,#f8f8f5);
}
.phone__screen.dk{background:linear-gradient(180deg,#1a1a1a,#0a0a0a);color:#fff}
.phone__screen.dk .mock-line{background:#27272a}
.phone__screen.dk .mock-line.d{background:#fff}

.proj__caption{
  display:flex;flex-direction:column;gap:2px;
  padding:0 .25rem;
}
.proj__name{
  font-family:var(--sans);font-weight:600;
  font-size:clamp(1.45rem,1.05rem + .95vw,1.85rem);
  letter-spacing:-.03em;line-height:1.1;
  margin:0;color:var(--ink);
}
/* the "AI app design & build" descriptor, on its own line under the title.
   Inter, not Fraunces — only Fraunces' italic axis is loaded (see `fonts` in
   the front matter), so roman Fraunces would render as a synthesised fallback */
.proj__kind{
  font-family:var(--sans);font-weight:400;
  font-size:clamp(1rem,.92rem + .28vw,1.13rem);
  line-height:1.3;margin:0;color:var(--muted);
}
.proj__crumb{
  font-size:16px;line-height:1.5;color:var(--ink-2);
  padding:0 .25rem;max-width:50ch;
  margin-top:2px;
}
.proj__crumb b{color:var(--ink);font-weight:500}
.proj__crumb .sep{width:3px;height:3px;border-radius:50%;background:var(--dot)}

/* what-I-did facts — a short black rule, then the facts run inline,
   separated by dots. Shown from 960px up rather than the 761px carousel
   breakpoint: cards are clamp(280px,40vw,520px), and the longest run
   (Lifecake, ~366px) only stays on one line once 40vw clears ~374px. Below
   that it wraps and the rules stop lining up across the rail. */
.proj__tags{display:none}
@media (min-width:960px){
  .proj__crumb{margin-bottom:6px}
  .proj__tags{
    display:block;
    /* auto pushes the block to the card's base so the rule lines up across
       the rail whatever the title and description wrap to */
    margin:auto .25rem 0;
  }
  .proj__tags::before{
    content:"";display:block;
    width:34px;height:1px;background:var(--ink);
    margin-bottom:12px;
  }
  /* not interactive — labels, not buttons, so no hover or cursor change.
     Sits between --muted and --ink-2: clearly secondary to the sentence
     above it, but not as faint as the descriptor under the title. */
  .proj__tag{
    font-size:.9rem;line-height:1.6;
    color:#6b665e;white-space:nowrap;
  }
  /* slashes, not middots — the page's dotted background pattern makes a
     middot separator hard to pick out */
  .proj__tag + .proj__tag::before{
    content:"/";color:var(--dot);margin:0 .4em;
  }
}

/* ============================================================ deck */
/* A trial alternative to the work rail: the case studies as a stack of
   overlapping cards. The front card is the active one; the next two peek
   out behind it, up and to the right, and the two already seen peek out up
   and to the left. Drag the front card and it follows the pointer, tilting
   as it goes, while its neighbour slides in to take its place — let go past
   the threshold and the dragged card settles into the fan on the far side,
   otherwise it springs back. Arrows, bars and arrow keys do the same; a
   short press on the front card opens it. Each card wears its case study's
   accent (--c) with text in --on. JS sets --o on every card (its offset
   from the front card) and the stack's --shift while dragging (pointer
   travel in card widths); every card sits in the fan at --o + --shift,
   except the front one, which rides with the pointer. */
.deck{
  position:relative;z-index:2;
  padding:clamp(4rem,8vw,7rem) 0 clamp(4rem,8vw,6rem);
  overflow:hidden;
}
.deck__head{padding:0 var(--pad) clamp(4.5rem,8.5vw,8.5rem);text-align:center}
/* the nav's Work link lands here now: cancel the section's own top padding
   so the title sits --anchor-gap below the fixed nav (same idea as #hello) */
.deck#work{scroll-margin-top:calc(var(--nav-h) + var(--anchor-gap) - clamp(4rem,8vw,7rem))}
.deck__title{
  /* lighter and a step down from --h2: the cards are the headline here */
  font-family:var(--sans);font-weight:500;
  font-size:calc(var(--h2) * .78);
  letter-spacing:-.03em;line-height:1.08;
  margin:0 auto;color:var(--ink);
  text-wrap:balance;
}
.deck__title .it{
  display:block;
  font-family:var(--serif-2);font-style:italic;font-weight:400;
  letter-spacing:-.015em;
}
.deck__cards{
  position:relative;
  /* capped by the screen's height too, so title + card fit a 13" laptop
     (1280x800) in one view; a 1920x1080 screen still gets the full 520 */
  --deck-h:clamp(380px,min(34vw,55vh),520px);
  height:var(--deck-h);
  transform:rotate(-2.5deg);
  touch-action:pan-y;
  user-select:none;-webkit-user-select:none;
  cursor:grab;
}
.deck__cards.is-dragging{cursor:grabbing}
.deck__card{
  position:absolute;inset:0;margin:auto;
  width:min(90vw,860px,calc(var(--deck-h) * 1.66));height:100%;
  display:grid;grid-template-columns:1fr 1.08fr;
  gap:16px;padding:16px;
  border-radius:24px;
  background:var(--c);color:var(--on,#fff);
  box-shadow:0 1px 2px rgba(0,0,0,.06);
  text-decoration:none;
  overflow:hidden;
  --o:0;
  --oe:calc(var(--o) + var(--shift,0));
  --a:max(var(--oe),-1 * var(--oe)); /* distance from the front, either side */
  --sp:1; /* fan spread: 1 at rest, opened up on hover */
  transform:
    /* the spread is mostly sideways, so the back cards never climb into the title */
    translate(calc(var(--oe) * 3.5% * var(--sp)),calc(var(--a) * -5.5% * (1 + (var(--sp) - 1) * .2)))
    rotate(calc(var(--oe) * 3deg * (1 + (var(--sp) - 1) * .4)))
    scale(calc(1 - var(--a) * .03));
  opacity:clamp(0,3 - var(--a),1); /* two peek out each side; the third fades in as it's dealt */
  transition:transform .32s ease,opacity .32s ease;
  will-change:transform;
  -webkit-user-drag:none;
}
.deck__card *{-webkit-user-drag:none}
.deck__cards.is-dragging .deck__card{transition:none}
/* the front card rides with the pointer, a full card width per card width
   of travel, tilting as it goes */
.deck__card.is-active{
  transform:translate(calc(var(--shift,0) * 100%),0) rotate(calc(var(--shift,0) * 12deg));
  opacity:1;
}
.deck__card:not(.is-active){cursor:pointer}
/* the drag hint (see the deck script): a short pull left, a swing over to
   the right, then a spring back to the middle */
.deck__cards.is-nudging-left .deck__card{transition:transform .42s cubic-bezier(.25,.8,.35,1),opacity .32s ease}
.deck__cards.is-nudging-right .deck__card{transition:transform .42s cubic-bezier(.45,0,.35,1),opacity .32s ease}
.deck__cards.is-nudging-back .deck__card{transition:transform .85s cubic-bezier(.3,1.6,.45,1),opacity .32s ease}
/* hover: the fan breathes out — the cards behind spread further apart, the
   front one lifts toward you, and a peeking card you point at slides out a
   little more. Keyed to a card being hovered, not the stack: the stack is
   the full width of the page, so :hover on it fanned the cards while the
   pointer was still well out to the side. Springy overshoot on the way out so it feels alive; the
   plain .32s ease still drives drag-release and card changes. */
@media (hover:hover) and (min-width:761px){
  .deck__cards:not(.is-dragging):has(.deck__card:hover) .deck__card{
    --sp:1.5;
    transition:transform .55s cubic-bezier(.3,1.45,.5,1),opacity .32s ease,box-shadow .45s var(--ease);
  }
  .deck__cards:not(.is-dragging) .deck__card:not(.is-active):hover{--sp:1.85}
  .deck__cards:not(.is-dragging):has(.deck__card:hover) .deck__card.is-active{
    transform:translateY(-10px) rotate(-.6deg) scale(1.015);
    box-shadow:0 34px 60px -24px rgba(0,0,0,.32),0 8px 18px -8px rgba(0,0,0,.14);
  }
}
.deck__body{
  display:flex;flex-direction:column;
  padding:16px 16px 12px;
  min-width:0;
}
.deck__brand{
  display:flex;align-items:center;gap:.6em;
  font-weight:800;font-size:1rem;letter-spacing:-.02em;
}
.deck__brand small{font-weight:500;font-size:.78rem;opacity:.75;letter-spacing:0}
.deck__mark{
  display:inline-grid;place-items:center;
  width:2em;height:2em;border-radius:.55em;
  background:var(--mark-bg,rgba(255,255,255,.92));color:var(--mark-ink,#0a0a0a);
  font-size:.9rem;font-weight:800;letter-spacing:-.04em;
  flex:none;
}
.deck__name{
  /* Inter Medium, a step down from the old Light: the thin strokes went soft
     on the rotated cards. --dn-scale lets the panel's Card title trial
     resize per face without touching the phone size below. */
  font-family:var(--sans);font-weight:500;
  --dn-scale:.85;
  font-size:calc(clamp(1.25rem,.8rem + 1.3vw,2.35rem) * var(--dn-scale));
  line-height:1.12;letter-spacing:-.03em;
  margin:clamp(1.5rem,3.2vw,2.4rem) 0 auto;
  text-wrap:pretty;
}
/* Card title trial (preference panel) — delete once a face is picked */
html[data-pref-cardtitle="serif"] .deck__name{font-family:var(--serif-2);font-weight:400;letter-spacing:-.01em;line-height:1.04;--dn-scale:1.1}
html[data-pref-cardtitle="bold"] .deck__name{font-weight:700;letter-spacing:-.035em;line-height:1.08;--dn-scale:.8}
html[data-pref-cardtitle="light"] .deck__name{font-weight:300;letter-spacing:-.025em;line-height:1.1;--dn-scale:1}
.deck__cta{
  margin-top:1.25rem;
  display:inline-flex;align-items:center;gap:.5em;
  font-size:.92rem;font-weight:600;
}
.deck__cta span{transition:transform .3s var(--ease)}
.deck__card.is-active:hover .deck__cta span{transform:translateX(3px)}
.deck__media{
  position:relative;min-height:0;
  border-radius:16px;overflow:hidden;
  background:#111;
}
.deck__media img{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;display:block;
}
.deck__stats{
  position:absolute;left:0;right:0;bottom:0;
  display:flex;gap:clamp(1rem,2.5vw,1.75rem);
  padding:clamp(1rem,2.5vw,1.5rem);
  color:#fff;
  background:linear-gradient(to top,rgba(0,0,0,.7),rgba(0,0,0,0));
}
.deck__stat{min-width:0}
.deck__stat b{
  display:block;white-space:nowrap;
  font-family:var(--serif-2);font-weight:400;
  font-size:clamp(1.5rem,1rem + 1.8vw,3rem);line-height:.95;
  letter-spacing:-.01em;
}
.deck__stat span{display:block;margin-top:.45em;font-size:.76rem;line-height:1.25;opacity:.88;max-width:14ch}
/* big, thin-stroked arrows pinned to the page edges either side of the
   fan, level with its middle. The stage isn't rotated like the stack, so
   they sit straight. Desktop only: below 1100px the fan needs the width. */
.deck__stage{position:relative}
.deck__arrow{
  position:absolute;top:50%;z-index:20;
  display:none;place-items:center;
  width:112px;height:112px;margin-top:-56px;
  background:none;border:0;padding:0;cursor:pointer;
  color:var(--ink);opacity:.75;
  transition:opacity .3s var(--ease),transform .35s var(--ease);
}
.deck__arrow svg{width:84px;height:42px;overflow:visible}
.deck__arrow--prev{left:60px}
.deck__arrow--next{right:60px}
.deck__arrow:hover,.deck__arrow:focus-visible{opacity:1}
.deck__arrow--prev:hover{transform:translateX(-6px)}
.deck__arrow--next:hover{transform:translateX(6px)}
@media (min-width:1100px){.deck__arrow{display:grid}}
/* pagination: a bar per card, the active one in that card's colour */
.deck__controls{
  display:flex;align-items:center;justify-content:center;
  margin-top:clamp(2.75rem,5.5vw,4.75rem);padding:0 var(--pad);
}
.deck__dots{display:flex;gap:clamp(5px,.6vw,8px);align-items:center}
.deck__bar{
  width:clamp(18px,2.4vw,30px);height:4px;border-radius:999px;
  background:var(--line);border:0;padding:0;cursor:pointer;
  transition:background .4s var(--ease),transform .3s var(--ease);
}
.deck__bar:hover{background:var(--dot)}
.deck__bar.is-active{background:var(--active-c,var(--ink))}
/* phone: a compact portrait card, about three-quarters of the screen wide,
   so the fan reads as a stack of cards with room around it rather than one
   card filling the viewport */
@media (max-width:760px){
  .deck__cards{height:clamp(400px,112vw,480px)}
  .deck__card{
    grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) auto;
    width:min(74vw,330px);border-radius:18px;gap:10px;padding:10px;
    /* one card peeks out each side, tucked in close, so the fan stays
       inside the front card's footprint instead of spreading to the edges */
    transform:
      translate(calc(var(--oe) * 2.5%),calc(var(--a) * -3%))
      rotate(calc(var(--oe) * 3deg))
      scale(calc(1 - var(--a) * .03));
