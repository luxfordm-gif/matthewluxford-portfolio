      <script>
      // The deal gathers every hero card into one pile before fanning out, and
      // the pile spot assumes a 218px card. The sticky note and the definition
      // card size to their text, so nudge them back by half the difference
      // (--wfix, used in the cardDeal keyframes) or they sit off to the right
      // and then jump. A ResizeObserver re-measures whenever a card's width
      // changes (the handwriting font landing changes the sticky note's), and
      // runs before that frame paints, so there's no one-frame flick.
      {
        const dealt = [...document.querySelectorAll(".fan .fcard")];
        const wfix = (c) => {
          if (getComputedStyle(c).getPropertyValue("--stack-tx").trim()) c.style.setProperty("--wfix", (218 - c.offsetWidth) / 2 + "px");
        };
        dealt.forEach(wfix);
        if ("ResizeObserver" in window) {
          const ro = new ResizeObserver((entries) => entries.forEach((e) => wfix(e.target)));
          dealt.forEach((c) => ro.observe(c));
        }
      }
      </script>
