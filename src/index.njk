}
.about__body p{margin:0 0 1em}
.about__body p:last-child{margin-bottom:0}
.about__body em{font-family:var(--serif);font-style:italic;color:var(--ink-2)}

/* inline link with GIF hover-popup */
.gif-link{
  position:relative;
  display:inline;
  color:inherit;
  text-decoration:none;
  background:#ffe600;
  padding:2px 6px;
  margin:0 -2px;
  border-radius:3px;
  -webkit-box-decoration-break:clone;
  box-decoration-break:clone;
  cursor:pointer;
  transition:background .25s var(--ease);
}
.gif-link:hover{background:#ffd900}
.gif-link__pop{
  position:absolute;
  left:50%;bottom:calc(100% + 12px);
  width:440px;height:auto;max-width:none;
  border-radius:8px;padding:5px;
  background:#fff;
  box-shadow:
    0 0 0 1px rgba(0,0,0,.04),
    0 24px 48px -18px rgba(0,0,0,.4),
    0 8px 18px -8px rgba(0,0,0,.18);
  opacity:0;pointer-events:none;
  transform:translate(-50%, 14px) scale(.8) rotate(-4deg);
  transform-origin:bottom center;
  transition:opacity .35s var(--ease), transform .45s cubic-bezier(.34,1.5,.64,1);
  z-index:20;
  display:block;
}
.gif-link:hover .gif-link__pop{
  opacity:1;
  transform:translate(-50%, 0) scale(1) rotate(-4deg);
}
@media (prefers-reduced-motion:reduce){
  .gif-link__pop{display:none}
}
.about__body strong{color:var(--ink);font-weight:600}
.about__body a.dotted-link{
  text-decoration:underline dotted #000;
  text-underline-offset:3px;
}
.about__body a.dotted-link:hover{text-decoration-style:solid}

.about__exp{
  display:grid;
  grid-template-columns:1fr 1fr;
  grid-template-areas:
    "when role"
    ".    desc";
  column-gap:clamp(2rem,5vw,5rem);
  row-gap:.85rem;
  padding:1.75rem 0;
  border-top:1px solid var(--line);
}
.about__exp:last-of-type{border-bottom:1px solid var(--line)}
/* continuation row — same date column, no top border, tighter spacing */
.about__exp--continued{
  border-top:none!important;
  padding-top:1.5rem;
}
.about__exp--continued .about__exp__when{visibility:hidden}
.about__exp__when{
  grid-area:when;
  font-size:clamp(.95rem,.9rem + .2vw,1.1rem);
  color:var(--ink);font-weight:400;letter-spacing:-.005em;
}
.about__exp__role{
  grid-area:role;
  font-size:clamp(.95rem,.9rem + .2vw,1.1rem);
  color:var(--ink);font-weight:600;letter-spacing:-.005em;
  line-height:1.3;
}
.about__exp__role .sep{color:inherit;font-weight:inherit}
.about__exp__loc{display:block;color:var(--ink);font-weight:400;font-size:1em}
.about__exp__desc{
  grid-area:desc;
  font-size:clamp(.95rem,.9rem + .2vw,1.1rem);
  color:var(--ink-2);max-width:55ch;font-weight:400;
  line-height:1.45;letter-spacing:-.005em;
}
.about__exp__desc p{margin:0 0 .85em}
.about__exp__desc p:last-child{margin-bottom:0}
@media (max-width:880px){
  .about__intro{grid-template-columns:1fr}
  /* compact mobile row: when on top, chevron aligns to the company name row */
  .about__exp{
    grid-template-columns:1fr 36px;
    grid-template-areas:
      "when when"
      "role chev"
      "desc desc";
    column-gap:.75rem;row-gap:.25rem;
    padding:1.4rem 0;
    cursor:pointer;
    align-items:start;
  }
  .about__exp__when{
    font-size:.78rem;color:var(--muted);font-weight:500;
    letter-spacing:.02em;
  }
  .about__exp__role{font-size:1rem;line-height:1.2}
  .about__exp__place,
  .about__exp__job{display:block}
  .about__exp__place{
    font-size:1.35rem;
    font-weight:700;
    letter-spacing:-.02em;
    line-height:1.15;
    margin-bottom:.1rem;
  }
  .about__exp__job{
    font-weight:400;
    font-size:.92rem;
    color:var(--ink-2);
    letter-spacing:-.005em;
  }
  /* hide location on mobile per design */
  .about__exp__loc{display:none}
  .about__exp__role .sep{display:none}
  /* description fully hidden until row is tapped */
  .about__exp__desc{
    overflow:hidden;
    max-height:0;
    margin:0;
    transition:max-height .45s var(--ease), margin .45s var(--ease);
  }
  /* chevron toggle replaces "Read more" copy */
  .about__exp__more{
    grid-area:chev;
    align-self:start;
    margin-top:2px;
    width:36px;height:36px;
    border-radius:8px;
    border:1px solid var(--dot);
    background:transparent;
    display:flex;align-items:center;justify-content:center;
    font-size:0;color:transparent;
    text-decoration:none;
    transition:background .25s var(--ease), border-color .25s var(--ease);
  }
  .about__exp__more::before{
    content:"";
    width:9px;height:9px;
    border-right:2px solid var(--ink-2);
    border-bottom:2px solid var(--ink-2);
    transform:rotate(45deg) translate(-1.5px,-1.5px);
    transition:transform .35s var(--ease), border-color .25s var(--ease);
  }
  .about__exp.is-expanded .about__exp__more{
    background:var(--ink);border-color:var(--ink);
  }
  .about__exp.is-expanded .about__exp__more::before{
    border-color:var(--paper);
    transform:rotate(225deg) translate(-1.5px,-1.5px);
  }
  .about__exp.is-expanded .about__exp__desc{
    max-height:60em;
    margin-top:.85rem;
  }
}
@media (min-width:881px){
  .about__exp__more{display:none}
}

/* =========================================================== foot */
.lux-large-footer{
  position:relative;z-index:2;
  margin-top:clamp(3rem,6vw,5rem);
  padding:clamp(4rem,9vw,7rem) var(--pad) 0;
