---
title: "Matthew Luxford — Senior Web Designer"
description: "Matthew Luxford — senior web designer, design lead and creative director with 18+ years crafting digital products for Jaguar Land Rover, Google, BBC and Netflix."
ogDescription: "Senior web designer, design lead and creative director with 18+ years crafting digital products for Jaguar Land Rover, Google, BBC and Netflix."
canonical: "https://matthewluxford.co.uk/"
ogType: "website"
ogImage: "https://matthewluxford.co.uk/assets/og-image.jpg"
ogImageAlt: "Hire me already! — Matthew Luxford"
fonts: "Caveat:wght@500;600&family=Fraunces:ital,wght@1,300..500&family=Inter:wght@400;500;600;700;800;900&family=Caveat+Brush"
navBrandHref: "#top"
navLinkBase: ""
---
{% extends "layouts/base.njk" %}

{% block pageStyles %}
<style>
:root{
  --bg:#fafaf7;
  --paper:#ffffff;
  --ink:#0a0a0a;
  --ink-2:#27272a;
  --muted:#9a958d;
  --line:#eae6dd;
  --dot:#c9c4b9;
  --dark:#0a0a0a;
  --serif:"Fraunces",ui-serif,Georgia,serif;
  --sans:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --hand:"Caveat",ui-serif,Georgia,serif;
  --pad:clamp(1.25rem,4vw,3.5rem);
  --ease:cubic-bezier(.2,.7,.2,1);
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;overflow-x:clip}
html,body{margin:0;padding:0;max-width:100%}
body{
  font-family:var(--sans);
  font-size:clamp(.95rem,.9rem + .25vw,1.05rem);
  line-height:1.55;color:var(--ink);
  overflow-x:clip;
  background:#070707;
  padding-bottom:62vh;
  text-wrap:pretty;
}
h1,h2,h3,h4{text-wrap:balance}
.page{overflow-x:clip}
.hero{overflow-x:clip}
.page{
  position:relative;z-index:2;
  background-color:var(--bg);
  background-image:
    radial-gradient(ellipse 70% 55% at 50% 38%, #ffffff 0%, transparent 70%),
    radial-gradient(circle, var(--dot) 1px, transparent 1.4px);
  background-size:auto, 18px 18px;
  background-attachment:fixed;
  background-position:center top, 0 0;
}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;background:none;border:0;cursor:pointer}
ul,ol{margin:0;padding:0;list-style:none}
::selection{background:var(--ink);color:var(--paper)}
p,li{text-wrap:pretty}

/* ============================================================== nav */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:60;
  display:flex;align-items:center;justify-content:space-between;
  padding:32px var(--pad) 18px;
  transition:transform .45s var(--ease), background .35s var(--ease), border-color .35s var(--ease), backdrop-filter .35s var(--ease), padding .35s var(--ease);
  border-bottom:1px solid transparent;
  mix-blend-mode:difference;
  color:#fff;
}
.nav.is-pinned{
  background:rgba(250,250,247,.0);
  backdrop-filter:none;
  -webkit-backdrop-filter:none;
}
.nav.is-floating{
  background:rgba(250,250,247,.72);
  backdrop-filter:saturate(160%) blur(14px);
  -webkit-backdrop-filter:saturate(160%) blur(14px);
  border-bottom-color:rgba(20,20,20,.06);
  mix-blend-mode:normal;
  color:var(--ink);
  padding-top:14px;padding-bottom:14px;
}
.nav.is-hidden{transform:translateY(-110%)}
.nav__brand{font-weight:700;font-size:1.15rem;letter-spacing:-.02em;color:inherit}
.nav__right{display:flex;align-items:center;gap:clamp(1.5rem,3vw,2.6rem)}
.nav__links{display:flex;gap:clamp(1.25rem,2.6vw,2rem)}
.nav__links a{font-size:1rem;color:inherit;font-weight:500;position:relative}
.nav__links a::after{
  content:"";position:absolute;left:0;right:0;bottom:-3px;height:1.5px;
  background:currentColor;transform:scaleX(0);transform-origin:left;
  transition:transform .35s var(--ease);
}
.nav__links a:hover::after,.nav__links a.is-active::after{transform:scaleX(1)}
.nav__cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:11px 22px;border-radius:999px;
  background:#fff;color:#000;
  font-weight:500;font-size:.95rem;
  transition:transform .25s var(--ease);
}
.nav.is-floating .nav__cta{background:var(--ink);color:var(--paper)}
.nav__cta:hover{transform:translateY(-2px)}
@media (max-width:760px){
  .nav__links{display:none}
  /* mobile: drop mix-blend-mode (flaky w/ position:fixed on iOS) */
  .nav{
    mix-blend-mode:normal;
    color:var(--ink);
  }
  .nav.is-pinned{
    background:rgba(250,250,247,.78);
    backdrop-filter:saturate(160%) blur(10px);
    -webkit-backdrop-filter:saturate(160%) blur(10px);
  }
  .nav__right{gap:0}
  .nav__cta,
  .nav.is-floating .nav__cta{
    background:var(--ink);
    color:var(--paper);
  }
}

/* ============================================================ hero */
.hero{
  position:relative;z-index:2;
  min-height:100vh;
  min-height:100svh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  padding:clamp(4.5rem,8vw,6rem) var(--pad) clamp(2rem,4vw,3rem);
  text-align:center;
}
.hero__title{
  font-family:var(--sans);font-weight:700;
  font-size:clamp(1.9rem,1.2rem + 3.8vw,4.6rem);
  line-height:1.05;letter-spacing:-.035em;
  margin:0 auto;max-width:22ch;color:var(--ink);
  text-wrap:balance;
}
.hero__title .ln{display:block;overflow:visible;padding:.05em 0 .12em;text-wrap:balance}
@media (max-width:760px){
  .hero__title{
    font-size:clamp(2.15rem,1.3rem + 4.6vw,3rem);
    max-width:14ch;
    text-wrap:balance;
    -webkit-text-wrap:balance;
  }
}
.hero__title .ln>span{
  display:inline-block;
  opacity:0;transform:translateY(40%);
  animation:rise 1.1s var(--ease) forwards;will-change:transform,opacity;
}
.hero__title .ln:nth-child(1)>span{animation-delay:.05s}
.hero__title .ln:nth-child(2)>span{animation-delay:.18s}
.hero__title .it{font-family:var(--serif);font-style:italic;font-weight:400;letter-spacing:-.02em}
@keyframes rise{to{transform:translateY(0);opacity:1}}

.hero__prev{
  display:inline-flex;align-items:center;gap:6px;
  margin-top:clamp(2rem,4vw,3rem);
  font-size:.83rem;color:var(--muted);
}
.hero__prev .logo{
  display:inline-flex;align-items:center;
}
.hero__prev .logo img{
  width:36px;height:36px;display:block;object-fit:contain;
  transform:translateY(-2px);
}

/* ===================================================== fanned cards */
.fan{
  position:relative;z-index:2;display:flex;justify-content:center;
  width:100%;
  margin:clamp(2rem,4vw,3rem) auto 0;
  padding:0 var(--pad);
}
.fan__inner{position:relative;width:min(100%,920px);height:clamp(330px,36vw,380px)}
.fcard{
  position:absolute;top:0;width:218px;height:278px;
  border-radius:20px;padding:16px 16px 18px;
  background:var(--paper);
  box-shadow:0 26px 46px -18px rgba(0,0,0,.22),0 6px 14px -4px rgba(0,0,0,.07);
  display:flex;flex-direction:column;gap:7px;
  text-align:left;
  transform:rotate(var(--r, 0deg));
  transition:transform .6s var(--ease),box-shadow .6s var(--ease);
  animation:cardDeal 1.7s cubic-bezier(.4,1.2,.5,1) backwards;
}
@keyframes cardDeal{
  0%{
    opacity:0;
    transform:translate(var(--stack-tx,0), calc(var(--stack-ty,0) + 50px)) rotate(var(--stack-r, 0deg)) scale(.86);
  }
  40%{
    opacity:1;
    transform:translate(var(--stack-tx,0), var(--stack-ty,0)) rotate(var(--stack-r, 0deg)) scale(1);
  }
  100%{
    opacity:1;
    transform:rotate(var(--r));
  }
}
@media (hover:hover){
  .fcard:hover{
    transform:translateY(-18px) rotate(0deg)!important;
    box-shadow:0 50px 80px -25px rgba(0,0,0,.35);z-index:10;
  }
}
/* mobile tap-to-pop — same lift as the desktop hover state.
   JS adds .is-popped on tap and removes it on a second tap or
   outside-tap. Link cards keep their <a> wrapper; only taps on the
   designated link target (the masterclass pill, the AC/DC vinyl)
   follow the link. */
.fcard.is-popped{
  transform:translateY(-18px) rotate(0deg)!important;
  box-shadow:0 50px 80px -25px rgba(0,0,0,.35);z-index:10;
}
.fcard--1{
  left:50%;margin-left:-458px;top:54px;
  width:max-content;min-width:218px;
  --r:-8deg;--stack-tx:349px;--stack-ty:-54px;--stack-r:-2deg;
  background:#fde68a;
  font-family:var(--hand);font-size:1.05rem;line-height:1.3;color:#3a2e0d;
  padding:18px 16px;
}
.fcard--1 .ttl{font-weight:600;font-size:1.05rem;margin-bottom:6px}
.fcard--1 ul{display:flex;flex-direction:column;gap:5px;margin-top:4px}
.fcard--1 ul li{display:flex;gap:5px;font-family:var(--hand);font-size:17px;line-height:1.2}
.fcard--1 ul li b{font-weight:700;margin-right:2px}
.fcard--2{
  left:50%;margin-left:-270px;top:18px;
  --r:-3deg;--stack-tx:161px;--stack-ty:-18px;--stack-r:3deg;
  color:var(--paper);
  padding:0;overflow:hidden;
  background-color:#0a0a0a;
  background-image:
    linear-gradient(180deg, rgba(10,10,10,0) 38%, rgba(10,10,10,.55) 65%, rgba(10,10,10,.95) 100%),
    url("assets/masterclass-hero.jpg");
  background-size:100% 100%, auto 122%;
  background-position:0 0, center 28%;
  background-repeat:no-repeat;
}
.fcard--2 .mc-eyebrow{
  position:absolute;top:11px;left:11px;
  width:32px;height:32px;border-radius:7px;
  background:#0a0a0a;
  display:grid;place-items:center;
  box-shadow:0 4px 10px -2px rgba(0,0,0,.5);
  overflow:hidden;
}
.fcard--2 .mc-eyebrow img{width:22px;height:auto;display:block}
.fcard--2 .mc-body{
  padding:14px;display:flex;flex-direction:column;gap:4px;height:100%;
  justify-content:flex-end;
}
.fcard--2 .mc-watching{
  font-family:var(--hand);font-size:1rem;color:#fff;line-height:1;
  margin-bottom:2px;
}
.fcard--2 .mc-title{
  font-family:var(--sans);font-weight:700;font-size:.85rem;
  letter-spacing:-.01em;line-height:1.2;color:#fff;
  text-shadow:0 2px 14px rgba(0,0,0,.6);
}
.fcard--2 .mc-by{font-size:.7rem;color:#ffffff99;margin-bottom:4px}
.fcard--2 .pill{
  align-self:flex-start;display:inline-flex;align-items:center;gap:6px;
  background:#fff;color:#000;padding:6px 11px;border-radius:999px;
  font-weight:600;font-size:.75rem;
}
.fcard--3{
  left:50%;margin-left:50px;top:-8px;padding:0;overflow:hidden;
  --r:5deg;--stack-tx:-159px;--stack-ty:8px;--stack-r:-3deg;
  background:#1a1a1a;
}
.fcard--3 .ph{
  width:100%;height:100%;
  background-image:url("https://cdn.prod.website-files.com/60e43dce81494cd0946f829e/60fec2712ef38f4ae3a670a4_family-p-1080.jpeg");
  background-size:cover;
  background-position:center;
  filter:grayscale(.15) contrast(1.02);
}
.fcard--4{
  left:50%;margin-left:215px;top:42px;
  width:max-content;min-width:218px;
  --r:7deg;--stack-tx:-362px;--stack-ty:-42px;--stack-r:4deg;
  background:var(--paper);
  padding:16px 16px 18px;
}
.fcard--4 .ttl{font-weight:700;font-size:1rem;margin-bottom:1px;letter-spacing:-.01em}
.fcard--4 .ttl em{font-family:var(--serif);font-style:italic;font-weight:500;font-size:1.05rem}
.fcard--4 .phon{font-family:var(--serif);font-style:italic;color:var(--muted);font-size:.78rem;border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:8px}
.fcard--4 ol{display:flex;flex-direction:column;gap:3px;font-size:.82rem;color:var(--ink-2);counter-reset:fc}
.fcard--4 ol li{counter-increment:fc;line-height:1.35;white-space:nowrap}
.fcard--4 ol li::before{content:"(" counter(fc) ") ";color:var(--muted)}
.fcard--4 ol li em{font-family:var(--serif);font-style:italic;color:var(--muted)}

/* music card — album artwork fills the card, vinyl spins in the middle */
.fcard--5{
  left:50%;margin-left:-110px;top:-2px;
  --r:-3deg;--stack-tx:1px;--stack-ty:2px;--stack-r:-1deg;
  background:#000;color:#fff;
  padding:0;
  text-align:left;
  text-decoration:none;
  overflow:hidden;
}
.fcard--5 .mu-eyebrow{
  position:absolute;top:14px;left:14px;z-index:4;
  display:inline-flex;align-items:center;gap:6px;
  font-size:.62rem;font-weight:600;
  letter-spacing:.1em;text-transform:uppercase;color:#fff;
}
.fcard--5 .mu-eyebrow .heart{
  color:#ef4444;font-size:.85rem;line-height:1;
  display:inline-block;
  animation:heartBeat 1.4s ease-in-out infinite;
}
@keyframes heartBeat{
  0%,100%{transform:scale(1)}
  20%{transform:scale(1.25)}
  40%{transform:scale(1)}
}
.fcard--5 .mu-band-art{
  position:absolute;top:18%;left:50%;
  transform:translateX(-50%);
  z-index:1;
  font-family:Impact,"Arial Black",Haettenschweiler,sans-serif;
  font-size:2.4rem;line-height:.95;
  font-weight:900;letter-spacing:-.02em;
  color:transparent;
  -webkit-text-stroke:1.4px rgba(255,255,255,.95);
  display:inline-flex;align-items:center;white-space:nowrap;
}
.fcard--5 .mu-band-art .bolt{
  -webkit-text-stroke:0;color:rgba(255,255,255,.95);
  font-size:1.85rem;margin:0 2px;transform:translateY(-2px);
}
.fcard--5 .mu-album-art{
  position:absolute;bottom:24%;left:50%;
  transform:translateX(-50%);
  z-index:1;
  font-family:Impact,"Arial Black",sans-serif;
  font-size:.7rem;font-weight:900;letter-spacing:.08em;
  color:rgba(255,255,255,.5);
  white-space:nowrap;
}
.fcard--5 .mu-disc-wrap{
  position:absolute;left:50%;top:50%;
  width:96px;height:96px;
  margin:-48px 0 0 -48px;
  z-index:2;
}
.fcard--5 .mu-disc{
  width:100%;height:100%;border-radius:50%;
  position:relative;
  background:
    repeating-radial-gradient(circle at center,
      transparent 0,transparent 1.4px,
      rgba(255,255,255,.06) 1.4px,rgba(255,255,255,.06) 1.7px),
    radial-gradient(circle at 28% 28%, #2c2c2c 0%, #0a0a0a 70%);
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.1),
    0 14px 26px -6px rgba(0,0,0,.85);
  animation:spinDisc 4s linear infinite;
}
.fcard--5 .mu-disc::before{
  content:"";position:absolute;inset:24%;border-radius:50%;
  background:#0a0a0a url("assets/vinyl-label.jpg") center/cover no-repeat;
  box-shadow:inset 0 0 0 1px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.05);
}
@keyframes spinDisc{to{transform:rotate(360deg)}}
.fcard--5 .mu-hole{
  position:absolute;left:50%;top:50%;
  width:7px;height:7px;
  margin:-3.5px 0 0 -3.5px;
  border-radius:50%;background:#0a0a0a;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.18);
  z-index:3;
}
.fcard--5 .mu-meta{
  position:absolute;left:14px;bottom:12px;z-index:4;
}
.fcard--5 .mu-title{
  display:block;
  font-weight:700;font-size:.78rem;letter-spacing:-.005em;color:#fff;
}
.fcard--5 .mu-artist{
  display:block;
  font-size:.62rem;color:#a3a3a3;
  font-family:var(--serif);font-style:italic;margin-top:1px;
}
@media (max-width:760px){.fan__inner{transform:scale(.85)}}
/* mobile: cards animate stacked → spread vertically (not horizontally)
   so the outermost cards stop clipping off the edge of the viewport.
   each card converges to (top:170, margin-left:-109) at the 40% keyframe,
   then fans up/down to its final position. */
@media (max-width:640px){
  /* anchor hero to the top so the taller fan doesn't shove the title
     off-screen — title stays where it was, fan flows below the fold.
     padding-top is sized in vh to roughly match the old vertically-
     centred title position; cards can extend past the viewport and
     the user scrolls to reach them. */
  .hero{
    min-height:auto;
    justify-content:flex-start;
    padding-top:clamp(8rem, 22vh, 14rem);
    padding-bottom:clamp(4.5rem, 9vw, 6.5rem);
  }
  /* +28px breathing room between the title and the stacked cards */
  .fan{padding:0 10px;margin-top:calc(clamp(2rem,4vw,3rem) + 28px)}
  .fan__inner{
    transform:none;
    width:218px;
    height:600px;
    margin:0 auto;
  }
  .fcard{left:50%}
  .fcard--1{
    margin-left:-129px;top:0;
    --r:-7deg;--stack-tx:20px;--stack-ty:170px;--stack-r:-2deg;
  }
  .fcard--2{
    margin-left:-79px;top:80px;
    --r:5deg;--stack-tx:-30px;--stack-ty:90px;--stack-r:3deg;
  }
  .fcard--5{
    margin-left:-109px;top:170px;
    --r:-2deg;--stack-tx:0;--stack-ty:0;--stack-r:-1deg;
  }
  .fcard--3{
    margin-left:-139px;top:240px;
    --r:-5deg;--stack-tx:30px;--stack-ty:-70px;--stack-r:-3deg;
  }
  .fcard--4{
    margin-left:-89px;top:310px;
    --r:6deg;--stack-tx:-20px;--stack-ty:-140px;--stack-r:4deg;
  }
}

/* ========================================================= marquee */
.marquee{
  position:relative;z-index:2;
  border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  padding:clamp(1rem,2vw,1.4rem) 0;
  background:rgba(255,255,255,.55);backdrop-filter:blur(6px);overflow:hidden;
}
.marquee__track{display:flex;width:max-content;animation:scroll 42s linear infinite}
.marquee__list{
  display:flex;gap:clamp(1.5rem,4vw,3rem);align-items:center;
  padding:0 clamp(.75rem,2vw,1.5rem);
  font-weight:600;font-size:clamp(1.1rem,.9rem + .9vw,1.6rem);
  color:var(--ink);white-space:nowrap;letter-spacing:-.02em;
}
.marquee__list li:nth-child(even){color:var(--muted);font-weight:400;font-family:var(--serif);font-style:italic}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ============================================================ work */
.work{position:relative;z-index:2;padding:clamp(5rem,9vw,8rem) 0 clamp(3rem,6vw,5rem)}
.work__head{
  padding:clamp(2rem,5vw,4rem) var(--pad) clamp(2rem,4vw,3rem);
  text-align:center;
}
.work__title{
  font-family:var(--sans);font-weight:700;
  font-size:clamp(3.5rem,2rem + 11vw,16rem);
  letter-spacing:-.05em;line-height:.9;
  margin:0;color:var(--ink);
}
.work__hint{
  display:block;margin-top:clamp(1rem,2vw,1.5rem);
  font-size:.85rem;color:var(--muted);
  letter-spacing:.06em;text-transform:uppercase;font-weight:600;
}
.work__rail{
  display:grid;grid-auto-flow:column;
  grid-auto-columns:clamp(280px, 40vw, 520px);
  gap:clamp(1rem,2.5vw,2rem);
  padding:1rem var(--pad) 3rem;
  overflow-x:auto;overflow-y:visible;
  scroll-snap-type:x mandatory;
  scroll-padding-left:var(--pad);
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
}
.work__rail::-webkit-scrollbar{display:none}

.proj{
  scroll-snap-align:start;display:flex;flex-direction:column;gap:1rem;
  text-decoration:none;color:inherit;
}

/* prev/next arrows under the work rail (desktop) */
.work__controls{
  display:flex;justify-content:center;gap:12px;
  padding:clamp(14px,3vw,22px) var(--pad) clamp(2rem,5vw,3rem);
}
.work__arrow{
  width:44px;height:44px;border-radius:50%;
  background:transparent;color:var(--ink);
  border:1px solid var(--line);padding:0;cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;
  transition:background .25s var(--ease), color .25s var(--ease), border-color .25s var(--ease), transform .25s var(--ease), opacity .25s var(--ease);
}
.work__arrow svg{display:block;width:18px;height:18px}
.work__arrow:hover{background:var(--ink);color:var(--paper);border-color:var(--ink);transform:translateY(-1px)}
.work__arrow:active{transform:translateY(0) scale(.96)}
.work__arrow[disabled]{opacity:.3;cursor:not-allowed;pointer-events:none}

/* pagination dots — mobile only */
.work__dots{display:none}
.work__dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--dot);border:0;padding:0;cursor:pointer;
  transition:background .3s var(--ease), transform .3s var(--ease), width .3s var(--ease);
}
.work__dot.is-active{
  background:var(--ink);
  width:22px;border-radius:999px;
}
@media (max-width:760px){
  .work__controls{display:none}
  .work__dots{
    display:flex;justify-content:center;gap:8px;
    padding:clamp(14px,3vw,22px) var(--pad) clamp(2rem,5vw,3rem);
  }
}

/* ===== Apple-style snap carousel on mobile ===== */
@media (max-width:760px){
  .work__rail{
    grid-auto-columns:78vw;
    gap:clamp(.6rem,2vw,1rem);
    padding-left:11vw;
    padding-right:11vw;
    scroll-padding-left:11vw;
    scroll-padding-inline:11vw;
    scroll-behavior:smooth;
    overscroll-behavior-x:contain;
  }
  .proj{
    scroll-snap-align:center;
    scroll-snap-stop:always;
  }
  .proj__media{
    border-radius:28px;
    transform-origin:center;
    will-change:transform;
  }
  /* gooey scale + fade as cards scroll across the viewport */
  @supports (animation-timeline:view()){
    .proj__media{
      animation:projGooey linear both;
      animation-timeline:view(inline);
      animation-range:cover 5% cover 95%;
    }
    @keyframes projGooey{
      0%,100%{
        transform:scale(.86);
        filter:saturate(.8) brightness(.92);
        opacity:.55;
      }
      50%{
        transform:scale(1);
        filter:saturate(1) brightness(1);
        opacity:1;
      }
    }
    .proj__caption,.proj__crumb{
      animation:projGooeyCaption linear both;
      animation-timeline:view(inline);
      animation-range:cover 5% cover 95%;
    }
    @keyframes projGooeyCaption{
      0%,100%{opacity:.45;transform:translateY(4px)}
      50%{opacity:1;transform:translateY(0)}
    }
  }
}
.proj__media{
  position:relative;aspect-ratio:5/4;border-radius:24px;overflow:hidden;
  display:grid;place-items:center;
  transition:transform .5s var(--ease),box-shadow .5s var(--ease);
}
.proj:hover .proj__media{
  transform:translateY(-6px);
  box-shadow:0 50px 80px -40px rgba(0,0,0,.32);
}
.proj__media--01{background:#2563eb}
.proj__video{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;display:block;
}
.proj__media--video{padding:0}
.proj__caption{margin-top:18px}
.proj__media--02{background:#fde68a}
.proj__media--03{background:#7f1d1d}
.proj__media--04{background:#1e293b}
.proj__media--05{background:linear-gradient(135deg,#7132E4 0%,#3a1d8a 100%)}
.proj__media--06{background:linear-gradient(135deg,#0f4d3a 0%,#08291e 100%)}
.proj__media--07{background:linear-gradient(135deg,#f97316 0%,#7c2d12 100%)}

.proj__badge{
  position:absolute;top:18px;right:18px;
