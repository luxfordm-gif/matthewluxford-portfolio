---
title: "Matthew Luxford — Senior Web Designer"
description: "Matthew Luxford — senior web designer, design lead and creative director with 18+ years crafting digital products for Jaguar Land Rover, Google, BBC and Netflix."
ogDescription: "Senior web designer, design lead and creative director with 18+ years crafting digital products for Jaguar Land Rover, Google, BBC and Netflix."
canonical: "https://matthewluxford.co.uk/"
ogType: "website"
ogImage: "https://matthewluxford.co.uk/assets/og-image.jpg"
ogImageAlt: "Hire me already! — Matthew Luxford"
fonts: "Caveat:wght@500;600&family=EB+Garamond:ital,wght@0,400..600;1,400..600&family=Fraunces:ital,wght@1,300..500&family=Inter:wght@300;400;500;600;700;800;900&family=Caveat+Brush"
navBrandHref: "#top"
navLinkBase: ""
prefSerif: true
prefDeckTitle: true
prefIntro: true
---
{% extends "layouts/base.njk" %}

{% block pageStyles %}
<style>
:root{
  --bg:#fafaf7;
  --paper:#ffffff;
  --ink:#0a0a0a;
  --ink-2:#27272a;
  --muted:#9a958d;
  --muted-strong:#736e66; /* --muted darkened enough for small text on white (5:1) */
  --line:#eae6dd;
  --dot:#c9c4b9;
  --dark:#0a0a0a;
  --serif:"Fraunces",ui-serif,Georgia,serif;
  /* trial secondary serif — on the snake's key words, the hero's italic line
     and the WIP note, to compare against Fraunces in place */
  --serif-2:"EB Garamond",ui-serif,Georgia,serif;
  --sans:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --hand:"Caveat",ui-serif,Georgia,serif;
  --pad:clamp(1.25rem,4vw,3.5rem);
  --ease:cubic-bezier(.2,.7,.2,1);

  /* Anchor landings. The nav is position:fixed, so it covers the top of the
     page and nothing in normal flow accounts for it. --nav-h is its measured
     height — keep it in step with .nav's padding and CTA size. --anchor-gap is
     the breathing room we want between the nav and a heading we've just landed
     on. The section paddings below are tokens rather than literals because the
     scroll-margin rules subtract them; keeping one copy stops the two drifting
     apart. */
  /* the hero H1 keeps its size; every other section title sits a step
     below it, so on a 13-15" laptop the sections stop shouting. Both land
     within a few px of each other on a 1920 screen. */
  --h1:clamp(32px,20px + 4.05vw,78.4px); /* px: immune to the laptop rem nudge below */
  --h2:clamp(2rem,.9rem + 3.1vw,4.9rem);
  --nav-h:95px;
  --anchor-gap:1.5rem;
  --work-pad-top:clamp(5rem,9vw,8rem);
  --work-head-pad-top:clamp(2rem,5vw,4rem);
}
/* preference panel: Layout → Accent serif (only loads in review, see
   partials/pref-panel.njk) */
html[data-pref-serif="fraunces"]{--serif-2:var(--serif)}
@media (max-width:760px){
  :root{--h1:clamp(2.15rem,1.3rem + 4.6vw,3rem);--h2:clamp(2.15rem,1.3rem + 4.6vw,3rem)}
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;overflow-x:clip}
html,body{margin:0;padding:0;max-width:100%}
body{
  font-family:var(--sans);
  font-size:clamp(.95rem,.9rem + .25vw,1.05rem);
  line-height:1.55;color:var(--ink);
  overflow-x:clip;
  background:#070707;
  padding-bottom:62vh;
  text-wrap:pretty;
}
h1,h2,h3,h4{text-wrap:balance}
.page{overflow-x:clip}
.hero{overflow-x:clip}
/* the glow + dot grid stay put while the page scrolls over them. (A fixed
   ::before layer under a clip-path was tried instead of
   background-attachment:fixed and dropped frames on the snake; leave it.) */
.page{
  position:relative;z-index:2;
  background-color:var(--bg);
  background-image:
    radial-gradient(ellipse 70% 55% at 50% 38%, #ffffff 0%, transparent 70%),
    radial-gradient(circle, var(--dot) 1px, transparent 1.4px);
  background-size:auto, 18px 18px;
  background-attachment:fixed;
  background-position:center top, 0 0;
}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;background:none;border:0;cursor:pointer}
ul,ol{margin:0;padding:0;list-style:none}
::selection{background:var(--ink);color:var(--paper)}
p,li{text-wrap:pretty}

/* ============================================================== nav */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:60;
  display:flex;align-items:center;justify-content:space-between;
  padding:24px var(--pad);
  transition:transform .45s var(--ease), background .35s var(--ease), border-color .35s var(--ease), backdrop-filter .35s var(--ease), padding .35s var(--ease);
  border-bottom:1px solid transparent;
  mix-blend-mode:difference;
  color:#fff;
}
.nav.is-pinned{
  background:rgba(250,250,247,.0);
  backdrop-filter:none;
  -webkit-backdrop-filter:none;
}
.nav.is-floating{
  background:rgba(250,250,247,.72);
  backdrop-filter:saturate(160%) blur(14px);
  -webkit-backdrop-filter:saturate(160%) blur(14px);
  border-bottom-color:rgba(20,20,20,.06);
  mix-blend-mode:normal;
  color:var(--ink);
}
/* Over a dark section the light blurred band reads as a white slab, so invert
   it. Driven by [data-nav-dark] elements + the scroll handler. */
.nav.is-floating.is-on-dark{
  background:rgba(10,10,10,.72);
  border-bottom-color:rgba(255,255,255,.10);
  color:#fff;
}
.nav.is-floating.is-on-dark .nav__cta{background:#fff;color:var(--ink)}
.nav.is-hidden{transform:translateY(-110%)}
.nav__brand{font-weight:700;font-size:1.15rem;letter-spacing:-.02em;color:inherit;display:inline-block;text-decoration:none}
.nav__brand-letters{display:inline-flex}
.nav__brand-letters span{display:inline-block;will-change:transform}
@keyframes navBrandWave{
  0%   {transform:translateY(0)}
  45%  {transform:translateY(-.5em)}
  100% {transform:translateY(0)}
}
.nav__brand.is-waving .nav__brand-letters span{
  animation:navBrandWave .55s cubic-bezier(.22,1,.36,1) both;
  animation-delay:calc(var(--i) * 45ms);
}
@media (prefers-reduced-motion: reduce){
  .nav__brand.is-waving .nav__brand-letters span{animation:none}
}
.nav__right{display:flex;align-items:center;gap:clamp(1.5rem,3vw,2.6rem)}
.nav__links{display:flex;gap:clamp(1.25rem,2.6vw,2rem)}
.nav__links a{font-size:1rem;color:inherit;font-weight:500;position:relative}
.nav__links a::after{
  content:"";position:absolute;left:0;right:0;bottom:-3px;height:1.5px;
  background:currentColor;transform:scaleX(0);transform-origin:left;
  transition:transform .35s var(--ease);
}
.nav__links a:hover::after,.nav__links a.is-active::after{transform:scaleX(1)}
.nav__cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:11px 22px;border-radius:999px;
  background:#fff;color:#000;
  font-weight:500;font-size:.95rem;
  transition:transform .25s var(--ease);
}
.nav.is-floating .nav__cta{background:var(--ink);color:var(--paper)}
.nav__cta:hover{transform:translateY(-2px)}
@media (max-width:760px){
  .nav__links{display:none}
  /* mobile: drop mix-blend-mode (flaky w/ position:fixed on iOS) */
  .nav{
    mix-blend-mode:normal;
    color:var(--ink);
  }
  .nav.is-pinned{
    background:rgba(250,250,247,.78);
    backdrop-filter:saturate(160%) blur(10px);
    -webkit-backdrop-filter:saturate(160%) blur(10px);
  }
  .nav__right{gap:0}
  .nav__cta,
  .nav.is-floating .nav__cta{
    background:var(--ink);
    color:var(--paper);
  }
}

/* ============================================================ hero */
.hero{
  position:relative;z-index:3;
  min-height:100vh;
  min-height:100svh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  padding:clamp(4.5rem,8vw,6rem) var(--pad) clamp(2rem,4vw,3rem);
  text-align:center;
}
.hero__title{
  font-family:var(--sans);font-weight:700;
  font-size:var(--h1);
  line-height:1.05;letter-spacing:-.035em;
  margin:0 auto;max-width:22ch;color:var(--ink);
  text-wrap:balance;
}
.hero__title .ln{display:block;overflow:visible;padding:.05em 0 .12em;text-wrap:balance}
@media (max-width:760px){
  .hero__title{
    font-size:var(--h1);
    max-width:14ch;
    text-wrap:balance;
    -webkit-text-wrap:balance;
  }
}
.hero__title .ln>span{
  display:inline-block;
  opacity:0;transform:translateY(40%);
  animation:rise 1.1s var(--ease) forwards;will-change:transform,opacity;
}
.hero__title .ln:nth-child(1)>span{animation-delay:.05s}
.hero__title .ln:nth-child(2)>span{animation-delay:.18s}
.hero__title .it{font-family:var(--serif-2);font-style:italic;font-weight:400;letter-spacing:-.015em}
@keyframes rise{to{transform:translateY(0);opacity:1}}

.hero__prev{
  display:inline-flex;align-items:center;gap:6px;
  margin-top:clamp(2rem,4vw,3rem);
  font-size:.83rem;color:var(--muted);
}
.hero__prev .logo{
  display:inline-flex;align-items:center;
}
.hero__prev .logo img{
  width:36px;height:36px;display:block;object-fit:contain;
  transform:translateY(-2px);
}

/* ===================================================== fanned cards */
.fan{
  position:relative;z-index:2;display:flex;justify-content:center;
  width:100%;
  margin:clamp(2rem,4vw,3rem) auto 0;
  padding:0 var(--pad);
}
.fan__inner{position:relative;width:min(100%,920px);height:clamp(330px,36vw,380px)}
/* the deck is pixel-positioned, so it scales as a unit rather than having
   every left/top/margin retuned. top-centre origin keeps the gap under the
   title fixed and lets the extra height fall into the hero's bottom pad.
   1100px, not the 761px carousel breakpoint: the scaled deck spans ~1035px,
   so below that the outer two cards would bleed further off the edges than
   they already do. */
@media (min-width:1100px){
  .fan__inner{transform:scale(1.06);transform-origin:top center}
}
.fcard{
  position:absolute;top:0;width:218px;height:278px;
  border-radius:20px;padding:16px 16px 18px;
  background:var(--paper);
  box-shadow:0 26px 46px -18px rgba(0,0,0,.22),0 6px 14px -4px rgba(0,0,0,.07);
  display:flex;flex-direction:column;gap:7px;
  text-align:left;
  transform:rotate(var(--r, 0deg));
  transition:transform .6s var(--ease),box-shadow .6s var(--ease);
  animation:cardDeal 1.7s cubic-bezier(.4,1.2,.5,1) backwards;
}
@keyframes cardDeal{
  0%{
    opacity:0;
    transform:translate(calc(var(--stack-tx,0px) + var(--wfix,0px)), calc(var(--stack-ty,0px) + 50px)) rotate(var(--stack-r, 0deg)) scale(.86);
  }
  40%{
    opacity:1;
    transform:translate(calc(var(--stack-tx,0px) + var(--wfix,0px)), var(--stack-ty,0px)) rotate(var(--stack-r, 0deg)) scale(1);
  }
  100%{
    opacity:1;
    transform:rotate(var(--r));
  }
}
/* phones: a card left alone gives the odd wiggle, a hint they can be
   picked up (JS picks one at random while the hero's idle). Animates the
   rotate property, so it stacks on the card's own transform. */
@keyframes fcWiggle{
  0%,100%{rotate:0deg}
  18%{rotate:-4.5deg}
  40%{rotate:3.5deg}
  62%{rotate:-2deg}
  82%{rotate:.8deg}
}
.fcard.is-wiggling{animation:cardDeal 1.7s cubic-bezier(.4,1.2,.5,1) backwards,fcWiggle .95s cubic-bezier(.36,.07,.19,.97)}
@media (hover:hover){
  .fcard:hover{
    transform:translateY(-18px) rotate(0deg)!important;
    box-shadow:0 50px 80px -25px rgba(0,0,0,.35);z-index:10;
  }
}
/* mobile tap-to-pop — same lift as the desktop hover state.
   JS adds .is-popped on tap and removes it on a second tap or
   outside-tap. Link cards keep their <a> wrapper; only taps on the
   designated link target (the masterclass pill, the AC/DC vinyl)
   follow the link. */
.fcard.is-popped{
  transform:translateY(-18px) rotate(0deg)!important;
  box-shadow:0 50px 80px -25px rgba(0,0,0,.35);z-index:10;
}
/* desktop: the fan stacks left to right, each card over the one to its
   left (1, 2, profile, AC/DC, definition). Phones restack below. */
.fcard--1{
  left:50%;margin-left:-458px;top:54px;z-index:1;
  --r:-8deg;--stack-tx:349px;--stack-ty:-54px;--stack-r:-2deg;
  background:#fde68a;
  font-family:var(--hand);font-size:1.12rem;line-height:1.3;color:#3a2e0d;
  padding:18px 16px;
}
.fcard--1 .ttl{font-weight:600;font-size:1.12rem;margin-bottom:6px}
.fcard--1 ul{display:flex;flex-direction:column;gap:5px;margin-top:4px}
.fcard--1 ul li{display:flex;gap:5px;font-family:var(--hand);font-size:18px;line-height:1.2;text-wrap:balance}
.fcard--1 ul li b{font-weight:700;margin-right:2px}
.fcard--2{
  left:50%;margin-left:-270px;top:18px;z-index:2;
  --r:-3deg;--stack-tx:161px;--stack-ty:-18px;--stack-r:3deg;
  color:var(--paper);
  padding:0;overflow:hidden;
  background-color:#0a0a0a;
  background-image:
    linear-gradient(180deg, rgba(10,10,10,0) 38%, rgba(10,10,10,.55) 65%, rgba(10,10,10,.95) 100%),
    url("assets/masterclass-hero.webp");
  background-size:100% 100%, auto 122%;
  background-position:0 0, center 28%;
  background-repeat:no-repeat;
}
.fcard--2 .mc-eyebrow{
  position:absolute;top:11px;left:11px;
  width:32px;height:32px;border-radius:7px;
  background:#0a0a0a;
  display:grid;place-items:center;
  box-shadow:0 4px 10px -2px rgba(0,0,0,.5);
  overflow:hidden;
}
.fcard--2 .mc-eyebrow img{width:22px;height:auto;display:block}
.fcard--2 .mc-body{
  padding:14px;display:flex;flex-direction:column;gap:4px;height:100%;
  justify-content:flex-end;
}
.fcard--2 .mc-watching{
  font-family:var(--hand);font-size:1.07rem;color:#fff;line-height:1;
  margin-bottom:2px;
}
.fcard--2 .mc-title{
  font-family:var(--sans);font-weight:700;font-size:.92rem;
  letter-spacing:-.01em;line-height:1.2;color:#fff;
  text-shadow:0 2px 14px rgba(0,0,0,.6);
}
.fcard--2 .mc-by{font-size:.75rem;color:#ffffff99;margin-bottom:4px}
.fcard--2 .pill{
  align-self:flex-start;display:inline-flex;align-items:center;gap:6px;
  background:#fff;color:#000;padding:6px 11px;border-radius:999px;
  font-weight:600;font-size:.8rem;
}
/* profile card — a mini of the photo card, centre of the fan, over the
   cards to its left and under AC/DC. On scroll it travels down into the About intro (JS sets
   translate / rotate / scale, which stack with the deal + hover transforms). */
.fcard--3{
  left:50%;margin-left:-110px;top:-2px;padding:7px;gap:0;z-index:5;
  /* dealt leaning a touch right; it straightens as it slides down the page
     (the slide JS rotates by -r as it goes). Never wiggles. */
  --r:4deg;--stack-tx:1px;--stack-ty:2px;--stack-r:2deg;
  background:var(--paper);
  will-change:translate,rotate,scale;
}
.me__photo{position:relative;flex:1;min-height:0;border-radius:14px;overflow:hidden;background:#000}
.me__photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 15%}
.me__foot{display:flex;align-items:center;gap:6px;padding:7px 1px 0 2px}
.me__who{display:flex;flex-direction:column;min-width:0;line-height:1.2}
.me__who span:first-child{font-size:.62rem;font-weight:500;color:var(--ink)}
.me__who span:last-child{font-size:.56rem;color:var(--muted-strong)}
.me__connect{
  margin-left:auto;flex:none;padding:.38rem .62rem;border-radius:999px;
  background:var(--ink);color:#fff;text-decoration:none;font-size:.62rem;font-weight:500;
}
.me__connect:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.fcard--4{
  left:50%;margin-left:215px;top:42px;z-index:7; /* over AC/DC */
  --r:7deg;--stack-tx:-362px;--stack-ty:-42px;--stack-r:4deg;
  background:var(--paper);
  padding:16px 16px 18px;
}
.fcard--4 .ttl{font-weight:700;font-size:1.07rem;margin-bottom:1px;letter-spacing:-.01em}
.fcard--4 .ttl em{font-family:var(--serif);font-style:italic;font-weight:500;font-size:1.12rem}
.fcard--4 .phon{font-family:var(--serif);font-style:italic;color:var(--muted-strong);font-size:.83rem;border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:8px}
.fcard--4 ol{display:flex;flex-direction:column;gap:5px;font-size:.88rem;color:var(--ink-2);counter-reset:fc}
.fcard--4 ol li{counter-increment:fc;line-height:1.35;text-wrap:balance}
.fcard--4 ol li::before{content:"(" counter(fc) ") ";color:var(--muted-strong)}
.fcard--4 ol li em{font-family:var(--serif);font-style:italic;color:var(--muted-strong)}

/* music card — album artwork fills the card, vinyl spins in the middle */
.fcard--5{
  left:50%;margin-left:50px;top:-8px;z-index:6; /* over the profile card */
  --r:5deg;--stack-tx:-159px;--stack-ty:8px;--stack-r:-3deg;
  background:#000;color:#fff;
  padding:0;
  text-align:left;
  text-decoration:none;
  overflow:hidden;
}
.fcard--5 .mu-eyebrow{
  position:absolute;top:14px;left:14px;z-index:4;
  display:inline-flex;align-items:center;gap:6px;
  font-size:.66rem;font-weight:600;
  letter-spacing:.1em;text-transform:uppercase;color:#fff;
}
.fcard--5 .mu-eyebrow .heart{
  color:#ef4444;font-size:.85rem;line-height:1;
  display:inline-block;
  animation:heartBeat 1.4s ease-in-out infinite;
}
@keyframes heartBeat{
  0%,100%{transform:scale(1)}
  20%{transform:scale(1.25)}
  40%{transform:scale(1)}
}
.fcard--5 .mu-band-art{
  position:absolute;top:18%;left:50%;
  transform:translateX(-50%);
  z-index:1;
  font-family:Impact,"Arial Black",Haettenschweiler,sans-serif;
  font-size:2.4rem;line-height:.95;
  font-weight:900;letter-spacing:-.02em;
  color:transparent;
  -webkit-text-stroke:1.4px rgba(255,255,255,.95);
  display:inline-flex;align-items:center;white-space:nowrap;
}
.fcard--5 .mu-band-art .bolt{
  -webkit-text-stroke:0;color:rgba(255,255,255,.95);
  font-size:1.85rem;margin:0 2px;transform:translateY(-2px);
}
.fcard--5 .mu-album-art{
  position:absolute;bottom:24%;left:50%;
  transform:translateX(-50%);
  z-index:1;
  font-family:Impact,"Arial Black",sans-serif;
  font-size:.7rem;font-weight:900;letter-spacing:.08em;
  color:rgba(255,255,255,.5);
  white-space:nowrap;
}
.fcard--5 .mu-disc-wrap{
  position:absolute;left:50%;top:50%;
  width:96px;height:96px;
  margin:-48px 0 0 -48px;
  z-index:2;
}
.fcard--5 .mu-disc{
  width:100%;height:100%;border-radius:50%;
  position:relative;
  background:
    repeating-radial-gradient(circle at center,
      transparent 0,transparent 1.4px,
      rgba(255,255,255,.06) 1.4px,rgba(255,255,255,.06) 1.7px),
    radial-gradient(circle at 28% 28%, #2c2c2c 0%, #0a0a0a 70%);
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.1),
    0 14px 26px -6px rgba(0,0,0,.85);
  animation:spinDisc 4s linear infinite;
}
.fcard--5 .mu-disc::before{
  content:"";position:absolute;inset:24%;border-radius:50%;
  background:#0a0a0a url("assets/vinyl-label.webp") center/cover no-repeat;
  box-shadow:inset 0 0 0 1px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.05);
}
@keyframes spinDisc{to{transform:rotate(360deg)}}
.fcard--5 .mu-hole{
  position:absolute;left:50%;top:50%;
  width:7px;height:7px;
  margin:-3.5px 0 0 -3.5px;
  border-radius:50%;background:#0a0a0a;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.18);
  z-index:3;
}
.fcard--5 .mu-meta{
  position:absolute;left:14px;bottom:12px;z-index:4;
}
.fcard--5 .mu-title{
  display:block;
  font-weight:700;font-size:.83rem;letter-spacing:-.005em;color:#fff;
}
.fcard--5 .mu-artist{
  display:block;
  font-size:.67rem;color:#a3a3a3;
  font-family:var(--serif);font-style:italic;margin-top:1px;
}
@media (max-width:760px){.fan__inner{transform:scale(.85)}}
/* mobile: cards animate stacked → spread vertically (not horizontally)
   so the outermost cards stop clipping off the edge of the viewport.
   each card converges to (top:170, margin-left:-109) at the 40% keyframe,
   then fans up/down to its final position. */
@media (max-width:640px){
  /* anchor hero to the top so the taller fan doesn't shove the title
     off-screen — title stays where it was, fan flows below the fold.
     padding-top is sized in vh to roughly match the old vertically-
     centred title position; cards can extend past the viewport and
     the user scrolls to reach them. */
  .hero{
    min-height:auto;
    justify-content:flex-start;
    padding-top:clamp(8rem, 22vh, 14rem);
    padding-bottom:clamp(4.5rem, 9vw, 6.5rem);
  }
  /* +28px breathing room between the title and the stacked cards */
  .fan{padding:0 10px;margin-top:calc(clamp(2rem,4vw,3rem) + 28px)}
  .fan__inner{
    transform:none;
    width:218px;
    height:600px;
    margin:0 auto;
  }
  .fcard{left:50%}
  .fcard--1,.fcard--2,.fcard--4{z-index:auto}
