}
.proj__crumb b{color:var(--ink);font-weight:500}
.proj__crumb .sep{width:3px;height:3px;border-radius:50%;background:var(--dot)}

/* ========================================================== about */
.about{
  position:relative;z-index:2;
  padding:clamp(5rem,10vw,8rem) var(--pad) clamp(4rem,8vw,6rem);
}
.about__inner{
  max-width:1400px;
  margin:0 auto;
  position:relative;
}
.about__exp{
  cursor:pointer;
  position:relative;
  z-index:1;
}
.about__exp::before{
  content:"";
  position:absolute;
  left:calc(50% - 50vw);right:calc(50% - 50vw);
  top:0;bottom:0;
  background:transparent;
  z-index:-1;
  transition:background .35s var(--ease);
}
.about__exp:hover::before{
  background:rgba(236, 224, 188, .15);
}

/* hover-follow preview image */
.about__hover-img{
  position:fixed;left:0;top:0;
  --w:330px;
  width:var(--w);
  background:#fff;
  border-radius:6px;padding:6px;
  pointer-events:none;
  opacity:0;
  --rot:10deg;
  transform:translate(-50%, -50%) rotate(var(--rot)) scale(.86);
  transform-origin:center;
  transition:opacity .3s var(--ease), transform .4s var(--ease);
  box-shadow:
    0 0 0 1px rgba(0,0,0,.04),
    0 35px 70px -25px rgba(0,0,0,.4),
    0 12px 24px -10px rgba(0,0,0,.18);
  z-index:30;
}
.about__hover-img img{
  width:100%;height:auto;
  display:block;border-radius:3px;
}
.about__hover-img.is-active{
  opacity:1;
  transform:translate(-50%, -50%) rotate(var(--rot)) scale(1);
}
@media (max-width:880px){
  .about__hover-img{display:none}
}
@media (prefers-reduced-motion:reduce){
  .about__hover-img{display:none}
}
.about__title{
  font-family:var(--sans);font-weight:700;
  font-size:clamp(3rem,1.5rem + 6vw,9rem);
  letter-spacing:-.045em;line-height:.9;
  margin:0 0 clamp(5rem,11vw,9rem);
  color:var(--ink);
}
@media (max-width:760px){
  .about__title{
    font-size:clamp(3.3rem,1.65rem + 6.6vw,5rem);
