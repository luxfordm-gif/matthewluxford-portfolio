<script>
(() => {
  // pagination dots for the work rail (mobile)
  const workRail = document.querySelector(".work__rail");
  const workDots = document.querySelector(".work__dots");
  if (workRail && workDots) {
    const projs = [...workRail.querySelectorAll(".proj")];
    projs.forEach((_, i) => {
      const b = document.createElement("button");
      b.className = "work__dot";
      b.type = "button";
      b.setAttribute("aria-label", `Go to slide ${i + 1}`);
      b.addEventListener("click", () => {
        projs[i]?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
      });
      workDots.appendChild(b);
    });
    const dots = [...workDots.querySelectorAll(".work__dot")];
    const updateDots = () => {
      const r = workRail.getBoundingClientRect();
      const center = r.left + r.width / 2;
      let best = 0, dist = Infinity;
      projs.forEach((p, i) => {
        const pr = p.getBoundingClientRect();
        const d = Math.abs(pr.left + pr.width / 2 - center);
        if (d < dist) { dist = d; best = i; }
      });
      dots.forEach((d, i) => d.classList.toggle("is-active", i === best));
    };
    workRail.addEventListener("scroll", updateDots, { passive: true });
    window.addEventListener("resize", updateDots);
    updateDots();
  }

  // prev/next arrows for the work rail (desktop)
  const prevBtn = document.querySelector(".work__arrow--prev");
  const nextBtn = document.querySelector(".work__arrow--next");
  if (workRail && prevBtn && nextBtn) {
    const scrollByCard = (dir) => {
      const card = workRail.querySelector(".proj");
      if (!card) return;
      const style = getComputedStyle(workRail);
      const gap = parseFloat(style.columnGap || style.gap || "0") || 0;
      const step = card.getBoundingClientRect().width + gap;
      workRail.scrollBy({ left: dir * step, behavior: "smooth" });
    };
    prevBtn.addEventListener("click", () => scrollByCard(-1));
    nextBtn.addEventListener("click", () => scrollByCard(1));
    const updateArrows = () => {
      const atStart = workRail.scrollLeft <= 1;
      const atEnd = workRail.scrollLeft + workRail.clientWidth >= workRail.scrollWidth - 1;
      prevBtn.toggleAttribute("disabled", atStart);
      nextBtn.toggleAttribute("disabled", atEnd);
    };
    workRail.addEventListener("scroll", updateArrows, { passive: true });
    window.addEventListener("resize", updateArrows);
    updateArrows();
  }

  // drag-to-scroll on the work rail
  // (vertical wheel is left alone so it scrolls the page; trackpad horizontal swipes
  //  and shift+wheel still scroll the rail natively.)
  document.querySelectorAll(".work__rail").forEach((rail) => {
    let down = false, sx = 0, sl = 0, moved = false;
    rail.addEventListener("pointerdown", (e) => {
      if (e.target.closest("a,button")) { /* allow link clicks */ }
      down = true; moved = false; sx = e.clientX; sl = rail.scrollLeft;
      rail.style.cursor = "grabbing";
    });
    rail.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - sx;
      if (Math.abs(dx) > 4) moved = true;
      rail.scrollLeft = sl - dx;
    });
    rail.addEventListener("click", (e) => {
      if (moved) { e.preventDefault(); e.stopPropagation(); }
    }, true);
    const up = () => { down = false; rail.style.cursor = ""; };
    rail.addEventListener("pointerup", up);
    rail.addEventListener("pointercancel", up);
    rail.addEventListener("pointerleave", up);
  });

  // nav: hide on scroll-down, show w/ blur on scroll-up
  const nav = document.querySelector(".nav");
  let lastY = window.scrollY, ticking = false;
  const updateNav = () => {
    const y = window.scrollY;
    const delta = y - lastY;
    if (y < 24) {
      nav.classList.remove("is-floating", "is-hidden");
      nav.classList.add("is-pinned");
    } else if (delta > 6) {
      nav.classList.add("is-hidden");
      nav.classList.remove("is-floating", "is-pinned");
    } else if (delta < -6) {
      nav.classList.remove("is-hidden", "is-pinned");
      nav.classList.add("is-floating");
    }
    lastY = y;
    ticking = false;
  };
  window.addEventListener("scroll", () => {
    if (!ticking) { requestAnimationFrame(updateNav); ticking = true; }
  }, { passive: true });
  updateNav();

  // active nav underline
  const links = document.querySelectorAll(".nav__links a");
  const sections = [...links].map((a) => document.querySelector(a.getAttribute("href")));
  const setActive = () => {
    const y = window.scrollY + 140;
    let i = -1;
    sections.forEach((s, idx) => { if (s && s.offsetTop <= y) i = idx; });
    links.forEach((l, idx) => l.classList.toggle("is-active", idx === i));
  };
  window.addEventListener("scroll", setActive, { passive: true });
  setActive();

  // about: collapsible rows on mobile (≤880px)
  const mqMobile = window.matchMedia("(max-width: 880px)");
  document.querySelectorAll(".about__exp").forEach((row) => {
    const desc = row.querySelector(".about__exp__desc");
    if (!desc) return;
    const more = document.createElement("span");
    more.className = "about__exp__more";
    more.textContent = "Read more →";
    row.appendChild(more);
    row.addEventListener("click", (e) => {
      if (!mqMobile.matches) return;
      if (e.target.closest("a")) return;
      const expanded = row.classList.toggle("is-expanded");
      more.textContent = expanded ? "Show less ←" : "Read more →";
    });
  });

  // about: hover image follows cursor over experience rows
  const hoverImg = document.querySelector(".about__hover-img");
  const hoverPic = hoverImg?.querySelector("img");
  const fallbackSrc = hoverPic?.src;
  if (hoverImg && hoverPic) {
    // preload per-row images so hot-swap is instant; cache promises
    const loaded = new Map();
    const tryLoad = (src) => {
      if (!src) return Promise.resolve(null);
      if (loaded.has(src)) return loaded.get(src);
      const p = new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve(src);
        img.onerror = () => resolve(null);
        img.src = src;
      });
      loaded.set(src, p);
      return p;
    };

    document.querySelectorAll(".about__exp").forEach((row) => {
      const src = row.dataset.img;
      const rot = row.dataset.rot || "10deg";
      const w = row.dataset.w || "330px";
      // warm cache
      tryLoad(src);
      row.addEventListener("mouseenter", async (e) => {
        // set position FIRST so the image doesn't flash at (0,0) on first hover
        hoverImg.style.left = e.clientX + "px";
        hoverImg.style.top = e.clientY + "px";
        hoverImg.style.setProperty("--rot", rot);
        hoverImg.style.setProperty("--w", w);
        const ok = await tryLoad(src);
        hoverPic.src = ok || fallbackSrc;
        hoverImg.classList.add("is-active");
      });
      row.addEventListener("mouseleave", () => hoverImg.classList.remove("is-active"));
      row.addEventListener("mousemove", (e) => {
        hoverImg.style.left = e.clientX + "px";
        hoverImg.style.top = e.clientY + "px";
      });
    });
  }

  // testimonials: inject 5 stars at the top of each, then fade + stagger-in on scroll
  const tCards = [...document.querySelectorAll(".testimonial")];
  tCards.forEach((card) => {
    const stars = document.createElement("div");
    stars.className = "testimonial__stars";
    stars.setAttribute("aria-hidden", "true");
    for (let i = 0; i < 5; i++) {
      const s = document.createElement("span");
      s.className = "testimonial__star";
      s.style.setProperty("--i", i);
      s.textContent = "★";
      stars.appendChild(s);
    }
    card.insertBefore(stars, card.firstChild);
  });
  if ("IntersectionObserver" in window && tCards.length) {
    const tIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            tIO.unobserve(e.target);
          }
        });
      },
      { threshold: 0.18 }
    );
    tCards.forEach((c) => tIO.observe(c));
  } else {
    tCards.forEach((c) => c.classList.add("is-visible"));
  }

  // testimonials: "Read them all" reveals hidden ones (mobile only)
  const tMore = document.querySelector(".testimonials__more");
  tMore?.addEventListener("click", () => {
    document.querySelector(".testimonials")?.classList.add("is-expanded");
  });

  // secret footer reveal: trigger when within 40vh of document end
  const secretEl = document.querySelector(".secret-footer");
  if (secretEl) {
    const checkReveal = () => {
      const docH = document.documentElement.scrollHeight;
      const winH = window.innerHeight;
      const remaining = docH - winH - window.scrollY;
      secretEl.classList.toggle("is-revealed", remaining < winH * 0.18);
    };
    window.addEventListener("scroll", checkReveal, { passive: true });
    window.addEventListener("resize", checkReveal);
    checkReveal();
  }

  // live clock
  const clock = document.getElementById("clock");
  if (clock) {
    const tick = () => {
      const d = new Date();
      const h = d.getHours() % 12 || 12;
      const m = String(d.getMinutes()).padStart(2,"0");
      const s = String(d.getSeconds()).padStart(2,"0");
      const ap = d.getHours() >= 12 ? "PM" : "AM";
      clock.textContent = `${h}:${m}:${s} ${ap}`;
    };
    tick(); setInterval(tick, 1000);
  }

  // Mobile tap-to-pop for the fanned hero cards. On phones (≤640px) the
  // cards are stacked vertically; tapping a card lifts it above the others
  // (.is-popped), tapping again — or tapping outside — drops it back.
  // For the two link cards, only the designated child element follows the
  // link; taps elsewhere on the card just toggle the pop state.
  {
    const mql = window.matchMedia("(max-width:640px)");
    const cards = [...document.querySelectorAll(".fan .fcard")];
    if (cards.length) {
      const linkTarget = (card) => {
        if (card.classList.contains("fcard--2")) return card.querySelector(".pill");
        if (card.classList.contains("fcard--5")) return card.querySelector(".mu-disc-wrap");
        return null;
      };
      const reset = () => cards.forEach((c) => c.classList.remove("is-popped"));
      cards.forEach((card) => {
        card.addEventListener("click", (e) => {
          if (!mql.matches) return;
          const target = linkTarget(card);
          if (target && target.contains(e.target)) return; // let the link follow
          e.preventDefault();
          const wasPopped = card.classList.contains("is-popped");
          reset();
          if (!wasPopped) card.classList.add("is-popped");
        });
      });
      document.addEventListener("click", (e) => {
        if (!mql.matches) return;
        if (e.target.closest(".fan .fcard")) return;
        reset();
      });
    }
  }

  // GA4: case study card clicks
  document.querySelectorAll("a.proj[href]").forEach((a) => {
    a.addEventListener("click", () => {
      if (typeof gtag !== "function") return;
      const project = (a.getAttribute("href") || "").replace(/\.html$/, "");
      gtag("event", "case_study_view", { project });
    });
  });
})();
</script>
