    max-width:24ch;
  }
}
.about__intro{
  display:grid;grid-template-columns:1fr 1fr;
  gap:clamp(2rem,5vw,5rem);
  margin-bottom:clamp(4rem,9vw,7rem);
}
.about__lead{
  font-size:clamp(1.05rem,.95rem + .55vw,1.4rem);
  font-weight:400;line-height:37px;color:var(--ink);
