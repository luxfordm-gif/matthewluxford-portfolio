<script>
(() => {
  // download CTA → triggers print dialog (user picks Save as PDF)
  document.getElementById("cv-download")?.addEventListener("click", () => {
    if (typeof gtag === "function") gtag("event", "cv_download", { method: "print_to_pdf" });
    window.print();
  });

  // nav: hide on scroll down, reveal with blur on scroll up
  const nav = document.querySelector(".nav");
  if (nav) {
    let lastY = window.scrollY, ticking = false;
    const updateNav = () => {
      const y = window.scrollY;
      const delta = y - lastY;
      if (y < 24) {
        nav.classList.remove("is-floating", "is-hidden");
        nav.classList.add("is-pinned");
      } else if (delta > 6) {
        nav.classList.add("is-hidden");
        nav.classList.remove("is-floating", "is-pinned");
      } else if (delta < -6) {
        nav.classList.remove("is-hidden", "is-pinned");
        nav.classList.add("is-floating");
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener("scroll", () => {
      if (!ticking) { requestAnimationFrame(updateNav); ticking = true; }
    }, { passive: true });
    updateNav();
  }

  // secret footer reveal
  const secretEl = document.querySelector(".secret-footer");
  if (secretEl) {
    const checkReveal = () => {
      const docH = document.documentElement.scrollHeight;
      const winH = window.innerHeight;
      const remaining = docH - winH - window.scrollY;
      secretEl.classList.toggle("is-revealed", remaining < winH * 0.18);
      // start fading the floating Download CV CTA + blur a touch earlier
      // so it's gone before the dark reveal becomes visible
      document.body.classList.toggle("near-secret-footer", remaining < winH * 0.4);
    };
    window.addEventListener("scroll", checkReveal, { passive: true });
    window.addEventListener("resize", checkReveal);
    checkReveal();
  }

  // fade the floating Download CV CTA + blur once the Contact section
  // scrolls into view, so it's gone well before the dark footer reveal
  const contactEl = document.getElementById("cv-contact-section");
  if (contactEl && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        document.body.classList.toggle("near-secret-footer", e.isIntersecting);
      });
    }, { rootMargin: "0px 0px -10% 0px", threshold: 0 });
    io.observe(contactEl);
  }
})();
</script>
{% endblock %}
