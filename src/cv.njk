---
title: "CV — Matthew Luxford"
description: "Curriculum Vitae of Matthew Luxford — senior web designer based in Surrey, UK."
ogTitle: "CV — Matthew Luxford, Senior Web Designer"
ogDescription: "Curriculum Vitae of Matthew Luxford — senior web designer based in Surrey, UK with 18+ years of experience."
canonical: "https://matthewluxford.co.uk/cv.html"
ogType: "profile"
ogImage: "https://matthewluxford.co.uk/assets/og-image.jpg"
ogImageAlt: "Hire me already! — Matthew Luxford"
fonts: "Caveat:wght@500;600&family=Fraunces:ital,wght@1,300..500&family=Inter:wght@400;500;600;700;800"
---
{% extends "layouts/base.njk" %}

{% block pageStyles %}
<style>
:root{
  --bg:#fafaf7;
  --paper:#ffffff;
  --ink:#0a0a0a;
  --ink-2:#27272a;
  --muted:#9a958d;
  --line:#eae6dd;
  --dot:#c9c4b9;
  --pill:#494949;
  --serif:"Fraunces",ui-serif,Georgia,serif;
  --sans:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --hand:"Caveat",ui-serif,Georgia,serif;
  --pad:clamp(1.25rem,4vw,3.5rem);
  --ease:cubic-bezier(.2,.7,.2,1);
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;overflow-x:hidden}
html,body{margin:0;padding:0;max-width:100%}
body{
  font-family:var(--sans);
  font-size:15px;line-height:1.55;color:var(--ink);
  overflow-x:hidden;
  background:#070707;
  padding-bottom:62vh;
  text-wrap:pretty;
}
h1,h2,h3,h4{text-wrap:balance}
.page{overflow-x:clip}
.page{
  position:relative;z-index:2;
  background-color:var(--bg);
  background-image:radial-gradient(circle, rgba(201, 196, 185, .3) 1px, transparent 1.4px);
  background-size:18px 18px;
  background-attachment:fixed;
}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
ul,ol{margin:0;padding:0;list-style:none}
::selection{background:var(--ink);color:var(--bg)}
p,li{text-wrap:pretty}

/* ============================================================== nav */
/* close button pinned to the top-right, mirroring the Resume CTA position used across the site */
.nav__close{
  /* 27px, not 32: the button is 40px tall and the nav bar on every other page
     is 95px, so this puts its centre on the same y=47 as their CTA and links */
  position:fixed;top:27px;right:var(--pad);z-index:60;
  display:inline-flex;align-items:center;justify-content:center;
  width:40px;height:40px;border-radius:8px;
  background:var(--ink);color:var(--paper);
  transition:background .25s var(--ease),transform .2s var(--ease);
}
.nav__close:hover{background:var(--ink-2)}
.nav__close:active{transform:scale(.94)}
.nav{display:none}

/* contact block, top-right of hero, aligned with role heading */
.cv-hero__contact{
  display:flex;flex-direction:column;align-items:flex-end;
  text-align:right;
  font-size:.78rem;line-height:1.6;color:var(--ink-2);
  margin:0;
}
.cv-hero__contact b{font-weight:600;color:var(--ink)}
.cv-hero__contact a:hover{color:var(--ink)}
.cv-hero__contact .status{
  display:inline-flex;align-items:center;gap:6px;
  margin-top:4px;font-weight:500;color:var(--ink);
}
.cv-hero__contact .dot{
  width:8px;height:8px;border-radius:50%;background:#3b82f6;
  display:inline-block;
  box-shadow:0 0 0 0 rgba(34,197,94,.55);
  animation:pulse 2s infinite var(--ease);
}
@keyframes pulse{
  0%{box-shadow:0 0 0 0 rgba(34,197,94,.55)}
  70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}
  100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}
}

/* ============================================================ hero */
.cv-hero{
  padding:clamp(2rem,5vw,4rem) var(--pad) clamp(2rem,4vw,3rem);
  border-bottom:1px solid var(--line);
  max-width:1280px;
  margin:0 auto;
  display:grid;
  grid-template-columns:minmax(0,1.85fr) minmax(0,1fr);
  column-gap:clamp(2rem,4vw,4rem);
  align-items:start;
}
.cv-hero__role{grid-column:1;grid-row:1}
.cv-hero__intro{grid-column:1;grid-row:2}
/* full hero width so all four proof items sit on one row */
.cv-proof{grid-column:1 / -1;grid-row:3}
.cv-hero__contact{grid-column:2;grid-row:1;align-self:start;padding-top:1.2rem}
@media (max-width:720px){
  .cv-hero{
    grid-template-columns:1fr;
    /* zero the row-gap on mobile so we can give the meta→role gap and
       the role→intro gap distinct sizes via explicit margins. */
    row-gap:0;
    /* align the contact block with the close button at top:32px */
    padding-top:2rem;
  }
  /* drop the desktop grid-row pins so DOM order wins on mobile —
     contact (first in markup) lands in row 1, then role, then intro. */
  .cv-hero__contact,
  .cv-hero__role,
  .cv-hero__intro,
  .cv-proof{grid-column:1;grid-row:auto}
  .cv-hero__contact{
    align-items:flex-start;text-align:left;padding-top:0;
    font-size:.92rem;line-height:1.7;color:var(--ink);
    margin-top:0;
    /* generous gap before the role title */
    margin-bottom:clamp(4rem, 9vw, 5.5rem);
    /* clear the close button on the right */
    padding-right:60px;
  }
  .cv-hero__contact .status{margin-top:6px;font-weight:500}
  .cv-hero__role{margin-top:0}
  .cv-hero__role .role-main{
    font-size:clamp(2.75rem, 1.5rem + 6vw, 3.75rem);
    line-height:1.05;
  }
  .cv-hero__role .role-sub{
    font-size:clamp(1.5rem, 1rem + 2.5vw, 1.95rem);
    font-weight:500;
    line-height:1.3;
    margin-top:.55em;
  }
  .cv-hero__intro{
    /* tight gap from the italic sub down to the first body paragraph */
    margin-top:clamp(1.5rem, 3.5vw, 2rem);
  }
}
.cv-hero__name{
  font-family:var(--hand);
  font-size:clamp(3.5rem,2rem + 5vw,6rem);
  font-weight:600;
  line-height:.95;letter-spacing:.005em;
  color:var(--ink);
  margin:0;
  display:inline-block;
  transform:rotate(-2deg) translateX(-3px);
  user-select:none;
}
.cv-hero__role{
  margin:.6rem 0 0;
  letter-spacing:-.01em;
}
.cv-hero__role .role-main{
  display:block;
  /* matches .hero__title from the homepage */
  font-family:var(--sans);font-weight:700;
  font-size:clamp(1.9rem,1.2rem + 3.8vw,4.6rem);
  line-height:1.05;letter-spacing:-.035em;
  color:var(--ink);
  text-wrap:balance;
}
.cv-hero__role .role-sub{
  display:block;margin-top:.4em;
  /* plain Inter — this is the job title, not an aside */
  font-family:var(--sans);font-style:normal;font-weight:500;
  font-size:clamp(1rem,.9rem + .55vw,1.35rem);
  letter-spacing:-.01em;
  color:var(--ink-2);
}
.cv-hero__intro{
  margin-top:var(--sp-lg);
  max-width:65ch;
  font-size:1rem;line-height:1.75;color:var(--ink-2);
}
.cv-hero__intro p{margin:0 0 1.5rem}
.cv-hero__intro p:last-child{margin-bottom:0}
.cv-hero__intro strong{color:var(--ink);font-weight:600}
.cv-hero__intro em{font-family:var(--serif);font-style:italic;color:var(--ink-2)}

/* proof strip — the four hard facts, sat above the fold so a six-second
   scan hits evidence before prose. No cards: big number, label, one line
   of context, sat on a hairline. */
.cv-proof{
  margin-top:clamp(2rem,4vw,3rem);
  padding-top:clamp(1.5rem,3vw,2.25rem);
  border-top:1px solid var(--line);
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:clamp(1.5rem,3vw,2.5rem);
}
.cv-proof li{display:flex;flex-direction:column;gap:.5rem}
.cv-proof b{
  /* same treatment as the case-study .outcome__num */
  font-family:var(--sans);font-weight:800;
  font-size:clamp(2rem,1.1rem + 2.6vw,3.25rem);
  line-height:1;letter-spacing:-.04em;color:var(--ink);
}
/* App Store icon standing in for the star on the Apple award fact.
   Sized in em so it tracks the number it sits beside. */
.cv-proof__icon{
  display:inline-block;vertical-align:-.1em;
  width:.88em;height:.88em;margin-right:.1em;
}
.cv-proof__lab{
  font-size:.72rem;font-weight:700;letter-spacing:.12em;
  text-transform:uppercase;color:var(--ink);
}
.cv-proof__desc{font-size:.85rem;line-height:1.45;color:var(--muted)}
@media (max-width:880px){
  .cv-proof{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.75rem 1.5rem}
}
/* phones: one fact per row, hairline between, so the numbers stay big */
@media (max-width:560px){
  .cv-proof{
    grid-template-columns:1fr;
    gap:0;
    padding-top:1.5rem;
  }
  .cv-proof li{gap:.3rem;padding:1.1rem 0}
  .cv-proof li + li{border-top:1px solid var(--line)}
  .cv-proof li:first-child{padding-top:0}
  .cv-proof li:last-child{padding-bottom:0}
}

/* short framing note under a section heading */
.cv-section__note{
  margin:0 0 1.75rem;max-width:62ch;
  font-size:.92rem;line-height:1.7;color:var(--ink-2);
}
.cv-section__note strong{color:var(--ink);font-weight:600}

/* notable achievement — plain block, no card, no rule */
.cv-callout{
  margin:0 0 2.5rem;
}
.cv-callout__lab{
  display:block;
  font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:var(--muted);
  margin-bottom:.5rem;
}
.cv-callout__title{
  font-family:var(--sans);font-weight:700;
  font-size:1.15rem;letter-spacing:-.015em;line-height:1.3;
  margin:0 0 .5rem;
}
.cv-callout__title em{font-family:var(--serif);font-style:italic;font-weight:400}
.cv-callout__desc{
  font-size:.95rem;line-height:1.7;color:var(--ink-2);margin:0;max-width:62ch;
}

/* outside of work */
.cv-outside p{
  font-size:.88rem;line-height:1.5;color:var(--ink-2);margin:0 0 .75rem;
}
.cv-outside p:last-child{margin-bottom:0}
.cv-outside p strong{color:var(--ink);font-weight:600}

.cv-aside__note{
  margin:.65rem 0 0;
  /* matches the body intro size — the small caption felt undersized */
  font-size:1rem;line-height:1.55;color:var(--muted);
}
.cv-aside__note em{font-family:var(--serif);font-style:italic}

/* ============================================================ grid */
.cv-grid{
  display:grid;
  grid-template-columns:minmax(0,1.85fr) minmax(0,1fr);
  gap:clamp(2rem,4vw,4rem);
  padding:clamp(2.5rem,5vw,4rem) var(--pad);
  max-width:1280px;margin:0 auto;
}
@media (max-width:880px){
  .cv-grid{grid-template-columns:1fr;gap:2.5rem}
}

.cv-section__h{
  font-family:var(--sans);font-weight:700;
  font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;
  color:#fff;
  display:inline-block;padding:6px 12px 5px;
  background:var(--pill);
  border-radius:4px;
  margin:0 0 1.5rem;
}
.cv-section + .cv-section{margin-top:3rem}

/* job entries */
.cv-job{
  display:grid;
  grid-template-columns:130px 1fr;
  gap:.5rem 1.5rem;
  padding:1.4rem 0;
  border-top:1px solid var(--line);
}
.cv-job:last-of-type{border-bottom:1px solid var(--line)}
.cv-job__years{
  grid-column:1;grid-row:1 / span 3;
  font-size:.78rem;color:var(--muted);
  font-variant-numeric:tabular-nums;
  padding-top:2px;
}
.cv-job__title{
  grid-column:2;
  font-family:var(--sans);font-weight:600;
  font-size:1rem;letter-spacing:-.005em;
  margin:0;line-height:1.35;
}
.cv-job__title em{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--ink-2);font-size:.95rem;margin-left:4px}
.cv-job__loc{
  grid-column:2;
  font-size:.78rem;color:var(--muted);margin-top:-7px;
}
.cv-job__desc{
  grid-column:2;
  font-size:.95rem;color:var(--ink-2);line-height:1.7;
  margin:.7rem 0 0;max-width:62ch;
}
.cv-job__desc ul{display:flex;flex-direction:column;gap:.25rem;margin:.4rem 0 0}
.cv-job__desc li{padding-left:1em;position:relative}
.cv-job__desc li::before{content:"·";position:absolute;left:.2em;color:var(--muted);font-weight:700}

@media (max-width:560px){
  .cv-job{grid-template-columns:1fr;gap:.25rem}
  .cv-job__years,.cv-job__title,.cv-job__loc,.cv-job__desc{grid-column:1}
}

/* aside */
.cv-aside .cv-section + .cv-section{margin-top:3.25rem}
.cv-tags{
  display:block;
  font-size:.92rem;line-height:1.55;color:var(--ink-2);
}
.cv-tags li{
  display:inline;
  padding:0;border:none;background:none;
}
.cv-tags li::after{content:", "}
.cv-tags li:last-child::after{content:""}
.cv-list{display:flex;flex-direction:column;gap:.65rem}
.cv-list li{
  font-size:.88rem;line-height:1.4;color:var(--ink-2);
  padding-bottom:.65rem;border-bottom:1px solid var(--line);
}
.cv-list li:last-child{border-bottom:0;padding-bottom:0}
.cv-list li b{color:var(--ink);font-weight:600;display:block;margin-bottom:1px}

/* contact block in aside */
.cv-contact{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:14px;padding:1.25rem;
  display:flex;flex-direction:column;gap:.5rem;
  font-size:.85rem;
}
.cv-contact a{color:var(--ink);font-weight:500}
.cv-contact a:hover{color:var(--paper);background:var(--ink);padding:0 4px;border-radius:3px}
.cv-contact .lab{font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:500;margin-bottom:-2px}

/* ===================================================== download CTA */
.cv-download{
  position:fixed;
  right:clamp(1rem,2.5vw,2rem);bottom:clamp(1rem,2.5vw,2rem);
  z-index:55;
  display:inline-flex;align-items:center;gap:8px;
  padding:13px 22px;border-radius:999px;
  background:var(--ink);color:var(--paper);
  border:0;cursor:pointer;
  font-family:var(--sans);font-weight:600;font-size:.92rem;
  box-shadow:0 18px 40px -18px rgba(20,17,15,.5),0 6px 14px -6px rgba(20,17,15,.2);
  transition:transform .35s var(--ease),background .25s var(--ease),opacity .35s var(--ease),visibility .35s var(--ease);
}
/* fade out the floating CTA + its blur once the secret-footer reveal is in view */
body.near-secret-footer .cv-download,
body.near-secret-footer .cv-download-fade{
  opacity:0;visibility:hidden;pointer-events:none;
}
.cv-download:hover{
  transform:translateY(-3px) scale(1.04);
  background:var(--ink-2);
}
.cv-download:active{transform:translateY(-1px) scale(1)}

/* gradient blur backdrop behind the floating Download CV — mobile only */
.cv-download-fade{display:none}
@media (max-width:680px){
  .cv-download-fade{
    display:block;
    transition:opacity .35s var(--ease),visibility .35s var(--ease);
    position:fixed;left:0;right:0;
    /* extend below the safe area so the gradient covers the iOS home indicator
       and any browser chrome, then we offset upward via height */
    bottom:0;
    /* taller fade so the gradient has room to breathe above the button */
    height:calc(env(safe-area-inset-bottom, 0px) + 220px);
    z-index:54;
    pointer-events:none;
    background:linear-gradient(
      to bottom,
      rgba(250,250,247,0) 0%,
      rgba(250,250,247,.55) 55%,
      rgba(250,250,247,.85) 100%
    );
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    /* mask the blur so its strength fades from 0 at the top to 100% at the bottom */
    -webkit-mask-image:linear-gradient(to bottom, transparent 0%, black 100%);
    mask-image:linear-gradient(to bottom, transparent 0%, black 100%);
  }
  .cv-download{
    left:50%;right:auto;
    transform:translateX(-50%);
    /* iOS notched phones report safe-area-inset-bottom = 34px;
       36px above that gives a comfortable visual margin and clears
       Android Chrome's gesture bar */
    bottom:calc(env(safe-area-inset-bottom, 0px) + 36px);
    z-index:55;
  }
  .cv-download:hover{transform:translateX(-50%) translateY(-3px) scale(1.04)}
  .cv-download:active{transform:translateX(-50%) translateY(-1px) scale(1)}
}

/* @shared: secret-footer */
/* ===================================================== secret footer */
.secret-footer{
  position:fixed;left:0;right:0;bottom:0;
  height:62vh;z-index:1;
  background:#070707;
  background-image:
    linear-gradient(to right, rgba(255,255,255,.015) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,.015) 1px, transparent 1px);
  background-size:32px 32px;
  color:#fff;overflow:hidden;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:6vh var(--pad);
  cursor:none;
}
.secret-footer *{
  cursor:none;
}
.secret-cursor{
  position:fixed;left:0;top:0;width:32px;height:32px;
  background:url("data:image/png;base64,") center/contain no-repeat;
  pointer-events:none;z-index:9999;opacity:0;
  transform:translate3d(-100px,-100px,0);will-change:transform;
}
.secret-cursor.is-on{opacity:1}
.secret-footer__eyebrow{
  position:absolute;top:9vh;left:50%;
  width:max-content;max-width:90vw;
  margin-left:auto;
  font-size:.85rem;font-weight:500;
  letter-spacing:.08em;
  color:rgba(255,255,255,.6);
  text-align:center;margin:0;line-height:1.4;
  transform:translateX(-50%) translateY(-15px) scale(.85);
}
.secret-footer__head{
  font-family:var(--serif);
  font-weight:400;font-style:italic;
  font-size:clamp(2.6rem,1.4rem + 7vw,8rem);
  line-height:1;letter-spacing:-.01em;
  margin:0;position:relative;text-align:center;
  opacity:0;transform:scale(.55);
}
.secret-footer__head em{font-style:italic;color:#fff}
.secret-footer__head .nonit{font-style:normal;font-weight:400;font-family:var(--serif)}
.secret-footer.is-revealed .secret-footer__head{
  animation:
    headReveal 1s cubic-bezier(.34,1.5,.64,1) forwards,
    headBounce 4.5s ease-in-out 1.05s infinite;
}
@keyframes headReveal{
  to{opacity:1;transform:scale(1)}
}
@keyframes headBounce{
  0%,100%{transform:scale(1) translateY(0)}
  50%{transform:scale(1) translateY(-10px)}
}
.secret-pill{
  position:absolute;
  display:inline-flex;align-items:center;
  padding:7px 14px;border-radius:999px;
  background:#070707;border:1px solid rgba(255,255,255,.3);
  color:#fff;
  font-family:var(--sans);font-size:.72rem;font-weight:600;letter-spacing:.06em;
  text-transform:uppercase;white-space:nowrap;
  opacity:0;
}
.secret-pill--cmon{top:-30%;left:6%}
.secret-pill--just{top:-12%;left:14%;bottom:auto}
.secret-footer.is-revealed .secret-pill--cmon{
  animation:
    pillIn .6s cubic-bezier(.34,1.6,.64,1) .55s forwards,
    floatA 3.4s ease-in-out 1.2s infinite;
}
.secret-footer.is-revealed .secret-pill--just{
  animation:
    pillIn .6s cubic-bezier(.34,1.6,.64,1) .7s forwards,
    floatB 3.8s ease-in-out 1.35s infinite;
}
@keyframes pillIn{
  from{opacity:0;transform:scale(.4) rotate(0deg)}
  to{opacity:1;transform:scale(1) rotate(var(--pill-r))}
}
.secret-pill--cmon{--pill-r:-9deg}
.secret-pill--just{--pill-r:6deg}
@keyframes floatA{
  0%,100%{transform:translateY(0) rotate(-9deg)}
  50%{transform:translateY(-10px) rotate(-13deg)}
}
@keyframes floatB{
  0%,100%{transform:translateY(0) rotate(6deg)}
  50%{transform:translateY(-7px) rotate(10deg)}
}

.secret-footer__bottom{
  position:absolute;bottom:8vh;left:50%;
  transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:.85rem;
  width:max-content;max-width:90vw;
  text-align:center;
}
.secret-footer__cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:14px 26px;border-radius:999px;
  background:#fff;color:#000;
  text-decoration:none;font-weight:600;font-size:.95rem;
  transition:transform .55s cubic-bezier(.34,1.5,.64,1), background .35s var(--ease), padding .55s cubic-bezier(.34,1.5,.64,1);
  opacity:0;transform:translateY(20px) scale(.85);
}
.secret-footer.is-revealed .secret-footer__cta{
  animation:elemIn .8s cubic-bezier(.34,1.5,.64,1) .55s forwards;
}
.secret-footer__cta:hover{
  transform:translateY(-6px) scale(1.14) rotate(-1deg)!important;
  background:#fde047;
  padding:16px 32px;
  box-shadow:0 18px 40px -12px rgba(253,224,71,.55);
}
.secret-footer__cta:active{
  transform:translateY(-2px) scale(1.06) rotate(0deg)!important;
  transition:transform .12s var(--ease);
}
.secret-footer__cta .arr{
  display:inline-block;
  transition:transform .55s cubic-bezier(.34,1.5,.64,1);
}
.secret-footer__cta:hover .arr{transform:translate(4px,-4px) rotate(8deg)}

.secret-footer__tag{
  font-size:14px;color:rgba(255,255,255,.55);
  margin:0;line-height:1.4;font-family:var(--sans);
  white-space:nowrap;
  opacity:0;transform:translateY(15px);
}
.secret-footer.is-revealed .secret-footer__tag{
  animation:elemIn .8s var(--ease) .8s forwards;
}

.secret-footer__eyebrow{opacity:0}
.secret-footer.is-revealed .secret-footer__eyebrow{
  animation:eyebrowIn .8s cubic-bezier(.34,1.5,.64,1) .35s forwards;
}
@keyframes eyebrowIn{
  from{opacity:0;transform:translateX(-50%) translateY(-15px) scale(.85)}
  to{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}
}

@keyframes elemIn{
  to{opacity:1;transform:translateY(0) scale(1)}
}

/* secret footer mobile fixes */
@media (max-width:720px){
  body{padding-bottom:54vh}
  .secret-footer{
    height:54vh;
    padding:4vh 1rem;
  }
  .secret-footer__eyebrow{
    top:4vh;
    font-size:.7rem;
    letter-spacing:.06em;
    line-height:1.4;
  }
  .secret-footer__head{
    font-size:clamp(1.55rem,7vw,2.4rem);
    line-height:1.1;
    padding:0 1.25rem;
    max-width:100%;
    overflow-wrap:break-word;
  }
  /* faster, snappier reveal so it doesn't sit on a black void */
  .secret-footer.is-revealed .secret-footer__head{
    animation:
      headReveal .55s cubic-bezier(.34,1.6,.64,1) forwards,
      headBounce 4.5s ease-in-out .6s infinite;
  }
  .secret-footer.is-revealed .secret-footer__eyebrow{
    animation:eyebrowIn .5s cubic-bezier(.34,1.6,.64,1) .15s forwards;
  }
  .secret-footer.is-revealed .secret-footer__cta{
    animation:elemIn .55s cubic-bezier(.34,1.6,.64,1) .3s forwards;
  }
  .secret-footer.is-revealed .secret-footer__tag{
    animation:elemIn .55s var(--ease) .45s forwards;
  }
  /* keep the floating pills on mobile for the magic — just reposition
     so they sit clear of the headline */
  .secret-pill{
    display:inline-flex;
    font-size:.62rem;
    padding:6px 12px;
  }
  .secret-pill--cmon{top:-58%;left:4%}
  .secret-pill--just{top:-30%;left:18%;bottom:auto;right:auto}
  .secret-footer.is-revealed .secret-pill--cmon{
    animation:
      pillIn .5s cubic-bezier(.34,1.6,.64,1) .3s forwards,
      floatA 3.4s ease-in-out .85s infinite;
  }
  .secret-footer.is-revealed .secret-pill--just{
    animation:
      pillIn .5s cubic-bezier(.34,1.6,.64,1) .42s forwards,
      floatB 3.8s ease-in-out 1s infinite;
  }
  .secret-footer__bottom{
    bottom:calc(env(safe-area-inset-bottom, 0px) + 36px);
    width:100%;left:0;right:0;transform:none;
    max-width:none;
    align-items:center;
  }
  .secret-footer__cta{
    padding:13px 24px;font-size:.9rem;
  }
  .secret-footer__tag{
    font-size:.7rem;
    white-space:nowrap;text-align:center;
  }
}
