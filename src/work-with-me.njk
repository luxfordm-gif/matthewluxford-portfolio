<script>
/* nav brand wave */
(function(){
  var brand = document.querySelector('.nav__brand');
  if (!brand) return;
  var letters = brand.querySelectorAll('.nav__brand-letters span');
  var last = letters[letters.length - 1];
  if (!last) return;
  var playing = false;
  function start(){ if (playing) return; playing = true; brand.classList.add('is-waving'); }
  last.addEventListener('animationend', function(){
    brand.classList.remove('is-waving');
    playing = false;
  });
  brand.addEventListener('mouseenter', start);
  brand.addEventListener('focus', start);
})();

/* entrance + parallax — bails on reduced motion */
(function(){
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) return;

  // entrance: reveal all .fx-* once the hero is in view, then mark settled
  // so the transform-transition stops chasing parallax updates.
  var fxNodes = document.querySelectorAll('.fx-down,.fx-up,.fx-card');
  var hero = document.querySelector('.hero');
  function settleAll(){
    // longest delay (620ms card) + 900ms transition + small buffer
    setTimeout(function(){
      fxNodes.forEach(function(n){ n.classList.add('is-settled'); });
    }, 1700);
  }
  if (hero && 'IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){
          fxNodes.forEach(function(n){ n.classList.add('is-in'); });
          settleAll();
          io.disconnect();
        }
      });
    }, { threshold: 0.05 });
    io.observe(hero);
  } else {
    fxNodes.forEach(function(n){ n.classList.add('is-in'); });
    settleAll();
  }

  // parallax: translate copy/asset/card at different rates
  var copy  = document.querySelector('.hero__copy');
  var asset = document.querySelector('.hero__asset');
  var card  = document.querySelector('.tcard');
  if (!copy && !asset && !card) return;

  var ticking = false;
  var heroH   = hero ? hero.offsetHeight : window.innerHeight;
  function refreshSize(){ heroH = hero ? hero.offsetHeight : window.innerHeight; }
  addEventListener('resize', refreshSize, { passive: true });

  function apply(y){
    // only parallax while the hero is in viewport — past it, freeze
    var clamped = Math.min(Math.max(y, 0), heroH);
    if (copy)  copy.style.setProperty('--py',  (clamped * -0.12).toFixed(2) + 'px');
    if (asset) asset.style.setProperty('--py', (clamped * -0.22).toFixed(2) + 'px');
    if (card)  card.style.setProperty('--py',  (clamped * -0.04).toFixed(2) + 'px');
  }

  function onScroll(){
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function(){
      apply(window.scrollY || window.pageYOffset || 0);
      ticking = false;
    });
  }
  addEventListener('scroll', onScroll, { passive: true });
  apply(0);
})();

/* how it works — sticky-scroll active step driven by section progress */
(function(){
  if (matchMedia('(prefers-reduced-motion: reduce)').matches){
    document.querySelectorAll('.how__step').forEach(function(s){ s.classList.add('is-active'); });
    return;
  }
  var how = document.querySelector('.how');
  if (!how) return;
  var steps = how.querySelectorAll('.how__step');
  if (!steps.length) return;
  var ticking = false;
  function update(){
    var rect = how.getBoundingClientRect();
    var vh = window.innerHeight;
    var total = rect.height - vh;
    var p = Math.min(Math.max(-rect.top / total, 0), 1);
    // 4 phases: 0–0.25, 0.25–0.5, 0.5–0.75, 0.75–1
    var active = Math.min(Math.floor(p / 0.25), steps.length - 1);
    steps.forEach(function(s, i){
      s.classList.toggle('is-active', i === active);
    });
  }
  function onScroll(){
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function(){ update(); ticking = false; });
  }
  addEventListener('scroll', onScroll, { passive:true });
  addEventListener('resize', onScroll, { passive:true });
  update();
})();

/* services cards — slide-in-from-right + fade, per-card on intersect */
(function(){
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var cards = document.querySelectorAll('.svc__card');
  if (!cards.length || !('IntersectionObserver' in window)){
    cards.forEach(function(c){ c.classList.add('is-in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting){
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
  cards.forEach(function(c){ io.observe(c); });
})();

/* sticky-scroll "Sound familiar?" — progress-driven state, single rAF loop */
(function(){
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var sf = document.querySelector('.sf');
  if (!sf) return;
  var pairs = Array.prototype.slice.call(sf.querySelectorAll('.sf__pair'));
  if (!pairs.length) return;

  // thresholds: pain reveal, pivot, strike. tuned per the brief.
  var revealAt = [0.04, 0.10, 0.18, 0.26, 0.34];
  var pivotAt  = 0.42;
  var strikeAt = [0.50, 0.62, 0.74, 0.86, 0.97];

  var ticking = false;
  function update(){
    var rect = sf.getBoundingClientRect();
    var vh   = window.innerHeight;
    // progress 0 when section top hits viewport top, 1 when section bottom hits viewport bottom
    var total = rect.height - vh;
    var passed = -rect.top;
    var p = Math.min(Math.max(passed / total, 0), 1);

    pairs.forEach(function(el, i){
      el.classList.toggle('is-in',     p >= revealAt[i]);
      el.classList.toggle('is-struck', p >= strikeAt[i]);
    });
    sf.classList.toggle('is-pivoted', p >= pivotAt);
  }

  function onScroll(){
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function(){ update(); ticking = false; });
  }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll, { passive: true });
  update();
})();
</script>

{% endblock %}
