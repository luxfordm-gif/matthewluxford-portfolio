<header class="nav">
  <a class="nav__brand" href="{{ navBrandHref | default('index.html') }}" aria-label="matthew.">
    <span class="nav__brand-letters" aria-hidden="true"><span style="--i:0">m</span><span style="--i:1">a</span><span style="--i:2">t</span><span style="--i:3">t</span><span style="--i:4">h</span><span style="--i:5">e</span><span style="--i:6">w</span><span style="--i:7">.</span></span>
  </a>
  <div class="nav__right">
    <nav class="nav__links" aria-label="Primary">
      <a href="{{ navLinkBase | default('index.html') }}#work">Work</a>
      <a href="{{ navLinkBase | default('index.html') }}#hello">About</a>
      <a href="cv.html">CV</a>
    </nav>
    <button class="nav__theme" type="button" aria-label="Switch to dark theme" aria-pressed="false">{% set iconId = "theme-mask-bar" %}{% include "partials/theme-icon.njk" %}</button>
    <a class="nav__cta" href="{{ navLinkBase | default('index.html') }}#contact">Contact</a>
    <button class="nav__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu"><span></span><span></span><span></span></button>
  </div>
</header>
<nav class="nav__menu" id="nav-menu" aria-label="Menu" hidden>
  <a href="{{ navLinkBase | default('index.html') }}#work">Work</a>
  <a href="{{ navLinkBase | default('index.html') }}#hello">About</a>
  <a href="cv.html">CV</a>
  <a href="{{ navLinkBase | default('index.html') }}#contact">Contact</a>
  <button class="nav__theme nav__theme--row" type="button" aria-label="Switch to dark theme" aria-pressed="false"><span class="to-dark">Dark theme</span><span class="to-light">Light theme</span>{% set iconId = "theme-mask-menu" %}{% include "partials/theme-icon.njk" %}</button>
  <p class="nav__menu-foot"><a href="mailto:luxfordm@gmail.com">luxfordm@gmail.com</a><a href="https://linkedin.com/in/matthewluxford/" target="_blank" rel="noopener">LinkedIn ↗</a></p>
</nav>
<script>
(function(){
  var brand = document.querySelector('.nav__brand');
  if (brand) {
    var letters = brand.querySelectorAll('.nav__brand-letters span');
    var last = letters[letters.length - 1];
    var playing = false;
    function start(){
      if (playing || !last) return;
      playing = true;
      brand.classList.add('is-waving');
    }
    if (last) last.addEventListener('animationend', function(){
      brand.classList.remove('is-waving');
      playing = false;
    });
    brand.addEventListener('mouseenter', start);
    brand.addEventListener('focus', start);
  }

  // Theme toggle: flips html[data-theme], remembers it, keeps the browser
  // chrome colour in step. The head script in layouts/base.njk applies the
  // saved choice before paint; with nothing saved, the system setting rules
  // and a change to it is followed live.
  var toggles = document.querySelectorAll('.nav__theme');
  var root = document.documentElement;
  function paintTheme(t){
    root.setAttribute('data-theme', t);
    var m = document.querySelector('meta[name="theme-color"]');
    var bg = getComputedStyle(root).getPropertyValue('--bg').trim();
    if (m && bg) m.setAttribute('content', bg);
    toggles.forEach(function(b){
      b.setAttribute('aria-pressed', t === 'dark' ? 'true' : 'false');
      b.setAttribute('aria-label', t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    });
  }
  paintTheme(root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light');
  toggles.forEach(function(b){ b.addEventListener('click', function(){
    var t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    paintTheme(t);
    try { localStorage.setItem('theme', t); } catch (e) {}
  }); });
  try {
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e){
      var saved = null; try { saved = localStorage.getItem('theme'); } catch (err) {}
      if (saved !== 'dark' && saved !== 'light') paintTheme(e.matches ? 'dark' : 'light');
    });
  } catch (e) {}

  // Phone menu: the burger opens a full-screen list under the bar. Closes on
  // a link, Escape, or growing past the phone breakpoint.
  var nav = document.querySelector('.nav');
  var burger = document.querySelector('.nav__burger');
  var menu = document.getElementById('nav-menu');
  if (!nav || !burger || !menu) return;
  function setOpen(open){
    nav.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('is-menu-open', open);
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) menu.removeAttribute('hidden'); else menu.setAttribute('hidden', '');
  }
  burger.addEventListener('click', function(){ setOpen(!nav.classList.contains('is-open')); });
  menu.addEventListener('click', function(e){ if (e.target.closest('a')) setOpen(false); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && nav.classList.contains('is-open')) { setOpen(false); burger.focus(); } });
  window.addEventListener('resize', function(){ if (window.innerWidth > 760 && nav.classList.contains('is-open')) setOpen(false); });
})();
</script>
