<header class="nav">
  <a class="nav__brand" href="{{ navBrandHref | default('index.html') }}" aria-label="matthew.">
    <span class="nav__brand-letters" aria-hidden="true"><span style="--i:0">m</span><span style="--i:1">a</span><span style="--i:2">t</span><span style="--i:3">t</span><span style="--i:4">h</span><span style="--i:5">e</span><span style="--i:6">w</span><span style="--i:7">.</span></span>
  </a>
  <div class="nav__right">
    <nav class="nav__links" aria-label="Primary">
      <a href="{{ navLinkBase | default('index.html') }}#work">Work</a>
      <a href="{{ navLinkBase | default('index.html') }}#about">About</a>
      <a href="{{ navLinkBase | default('index.html') }}#contact">Contact</a>
    </nav>
    <a class="nav__cta" href="cv.html">My CV</a>
  </div>
</header>
<script>
(function(){
  var brand = document.querySelector('.nav__brand');
  if (!brand) return;
  var letters = brand.querySelectorAll('.nav__brand-letters span');
  var last = letters[letters.length - 1];
  if (!last) return;
  var playing = false;
  function start(){
    if (playing) return;
    playing = true;
    brand.classList.add('is-waving');
  }
  last.addEventListener('animationend', function(){
    brand.classList.remove('is-waving');
    playing = false;
  });
  brand.addEventListener('mouseenter', start);
  brand.addEventListener('focus', start);
})();
</script>
