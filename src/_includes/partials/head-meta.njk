<meta charset="utf-8" />
<meta name="google-site-verification" content="DCzH4uKTH2r3OzwjbGHr2sC7gLw07BgiEAJQJjVWf18" />
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-QL3LGSTN6Q"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-QL3LGSTN6Q');
</script>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
<meta name="theme-color" content="#fafaf7" />
<link rel="icon" type="image/svg+xml" href="assets/favicon.svg" />
<link rel="canonical" href="{{ canonical }}" />
<meta property="og:type" content="{{ ogType or 'website' }}" />
<meta property="og:site_name" content="Matthew Luxford" />
<meta property="og:locale" content="en_GB" />
<meta property="og:url" content="{{ canonical }}" />
<meta property="og:title" content="{{ ogTitle or title }}" />
<meta property="og:description" content="{{ ogDescription or description }}" />
<meta property="og:image" content="{{ ogImage }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="{{ ogImageAlt }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ twitterTitle or ogTitle or title }}" />
<meta name="twitter:description" content="{{ twitterDescription or ogDescription or description }}" />
<meta name="twitter:image" content="{{ twitterImage or ogImage }}" />
{%- if twitterImageAlt or ogImageAlt %}
<meta name="twitter:image:alt" content="{{ twitterImageAlt or ogImageAlt }}" />
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family={{ fonts }}&display=swap" rel="stylesheet" />
