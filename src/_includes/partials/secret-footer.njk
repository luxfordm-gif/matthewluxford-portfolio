<section class="secret-footer" aria-label="Hidden message">
  <p class="secret-footer__eyebrow">WOAH... YOU REALLY LIKE TO SCROLL<br/>DON'T YOU?</p>

  <h2 class="secret-footer__head">
    <span class="secret-pill secret-pill--cmon">C'mon</span>
    <span class="nonit">Hire</span> <em>me</em> <span class="nonit">Already!</span>
    <span class="secret-pill secret-pill--just">Just</span>
  </h2>

  <div class="secret-footer__bottom">
    <a class="secret-footer__cta" href="mailto:luxfordm@gmail.com">Hire me <span class="arr">↗</span></a>
    <p class="secret-footer__tag">not forcing you btw, you-do-you</p>
  </div>

  <span class="secret-cursor" aria-hidden="true"></span>
</section>

<script>
/* Smiley cursor as a DOM follower, not a CSS cursor: some Chrome/macOS GPU
   configs only repaint custom CSS cursors on mouse-down, so the native trick
   is unreliable. A positioned element tracks the pointer and always shows. */
(() => {
  const sf = document.querySelector(".secret-footer");
  const dot = sf && sf.querySelector(".secret-cursor");
  if (!sf || !dot) return;
  if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;

  const place = (e) => {
    dot.style.transform = "translate(" + (e.clientX - 16) + "px," + (e.clientY - 16) + "px)";
  };
  sf.addEventListener("pointerenter", (e) => { place(e); dot.classList.add("is-on"); });
  sf.addEventListener("pointermove", place);
  sf.addEventListener("pointerleave", () => dot.classList.remove("is-on"));
})();
</script>
