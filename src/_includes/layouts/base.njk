<!doctype html>
<html lang="en">
<head>
{% include "partials/head-meta.njk" %}
{% include "partials/pref-panel.njk" %}
<style>
/* Design tokens — single source of truth for spacing, widths, type scale.
   Defined here so every page inherits the same values. Per-page CSS in
   pageStyles below can reference them (e.g. padding: var(--sp-xl) var(--pad)).
   Hand-tuned clamp() values are still allowed for one-offs; tokens are for
   anything that should stay consistent across components. */
:root{
  /* spacing scale (vertical rhythm + section gaps) */
  --sp-xs:clamp(8px,1.5vw,14px);
  --sp-sm:clamp(14px,3vw,22px);
  --sp-md:clamp(24px,5vw,40px);
  --sp-lg:clamp(40px,8vw,64px);
  --sp-xl:clamp(64px,12vw,96px);
  --sp-2xl:clamp(96px,16vw,144px);

  /* content widths */
  --w-content:1400px;
  --w-prose:62ch;
  --w-narrow:48ch;

  /* typography scale */
  /* case-study title. The vw term dominates on laptops, so the rem nudge
     alone barely moved it (122px at 1280). Lighter rem share brings it to
     ~101px at 1280 and ~111px at 1440; still 144px (the cap) at 1920. */
  --fs-h1:clamp(3rem,1rem + 6.7vw,9rem);
  --fs-h2:clamp(1.6rem,1.2rem + 1.5vw,2.4rem);
  --fs-h3:clamp(1.4rem,1.2rem + .8vw,1.8rem);
  --fs-h4:clamp(1.1rem,1rem + .4vw,1.28rem);
  --fs-body-lg:clamp(1.1rem,1rem + .5vw,1.4rem);
  --fs-body:clamp(.95rem,.9rem + .25vw,1.05rem);
  --fs-body-sm:14px;
  --fs-caption:12px;
}

/* 13-15" laptops (761-1599px wide): nudge the rem base down so copy, gaps
   and paddings on every page come in ~6% without retuning each clamp().
   HD (1600+) and phones keep the 16px base. Anything that must not move
   (the homepage hero H1) is sized in px. */
@media (min-width:761px) and (max-width:1599px){
  html{font-size:93.75%}
}

/* Mobile tap highlight — kill the grey/blue box iOS and Android flash over
   anything tappable on touch. Set on html (the property inherits) and repeated
   on the interactive elements for older Android WebViews that don't inherit it.
   Press feedback comes from the :active styles on individual components
   instead; focus rings are a separate property and are untouched. */
html,
a, button, summary, label,
input, select, textarea,
[role="button"], [tabindex]{
  -webkit-tap-highlight-color:transparent;
}
</style>
{% block pageStyles %}{% endblock %}
</head>
<body id="top">
{# delete this one line to remove the page transition entirely #}
{% include "partials/page-transition.njk" %}
{% block content %}{% endblock %}
</body>
</html>
