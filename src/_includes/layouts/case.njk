{% extends "layouts/base.njk" %}

{% block pageStyles %}
<style>
:root{
  --bg:#fafaf7;--paper:#ffffff;--ink:#0a0a0a;--ink-2:#27272a;
  --muted:#9a958d;--line:#eae6dd;--dot:#c9c4b9;--dark:#0a0a0a;
  --hl:#ffe600;
  --accent:{{ accent or '#0a0a0a' }};
  --accent-2:{{ accent2 or '#a7c1b1' }};
  --serif:"Fraunces",ui-serif,Georgia,serif;
  --sans:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --hand:"Caveat",ui-serif,Georgia,serif;
  --pad:clamp(1.25rem,4vw,3.5rem);
  --ease:cubic-bezier(.2,.7,.2,1);
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
html,body{margin:0;padding:0}
body{
  font-family:var(--sans);font-size:clamp(.95rem,.9rem + .25vw,1.05rem);
  line-height:1.55;color:var(--ink);overflow-x:hidden;
  background:#070707;
  padding-bottom:62vh;
  text-wrap:pretty;
}
.page{
  position:relative;z-index:2;
  background-color:var(--bg);
  background-image:radial-gradient(circle, rgba(201, 196, 185, .3) 1px, transparent 1.4px);
  background-size:18px 18px;
  background-attachment:fixed;
}
h1,h2,h3,h4{text-wrap:balance}
a{color:inherit;text-decoration:none}
img,svg{display:block;max-width:100%}

/* nav */
.nav{
  position:fixed;top:0;left:0;right:0;z-index:60;
  display:flex;align-items:center;justify-content:space-between;
  padding:32px var(--pad) 18px;
  transition:transform .45s var(--ease), background .35s var(--ease), border-color .35s var(--ease), backdrop-filter .35s var(--ease), padding .35s var(--ease);
  border-bottom:1px solid transparent;
}
.nav.is-pinned{background:transparent;backdrop-filter:none;-webkit-backdrop-filter:none}
.nav.is-floating{
  background:rgba(250,250,247,.78);
  backdrop-filter:saturate(160%) blur(14px);
  -webkit-backdrop-filter:saturate(160%) blur(14px);
  border-bottom-color:rgba(20,20,20,.06);
  padding-top:14px;padding-bottom:14px;
}
.nav.is-hidden{transform:translateY(-110%)}
.nav__brand{font-weight:700;font-size:1.15rem;letter-spacing:-.02em;color:var(--ink)}
.nav__right{display:flex;align-items:center;gap:clamp(1.5rem,3vw,2.6rem)}
.nav__links{display:flex;gap:clamp(1.25rem,2.6vw,2rem)}
.nav__links a{font-size:1rem;color:var(--ink);font-weight:500}
.nav__cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:11px 22px;border-radius:999px;
  background:var(--ink);color:var(--paper);
  font-weight:500;font-size:.95rem;
  transition:transform .25s var(--ease);
}
.nav__cta:hover{transform:translateY(-2px)}
@media (max-width:760px){.nav__links{display:none}}

/* back */
.back{
  position:relative;z-index:5;
  padding:clamp(7rem,10vw,9rem) var(--pad) 0;
  max-width:1400px;margin:0 auto;
}
.back a{
  display:inline-flex;align-items:center;gap:8px;
  font-size:.95rem;color:var(--muted);
  transition:color .25s var(--ease);
}
.back a:hover{color:var(--ink)}

/* head */
.case__head{
  padding:clamp(2rem,4vw,3rem) var(--pad) clamp(3rem,6vw,4rem);
  display:grid;grid-template-columns:1fr 1.4fr;
  gap:clamp(2rem,5vw,5rem);align-items:start;
  max-width:1400px;margin:0 auto;
}
@media (min-width:760px){
  .case__head{margin-bottom:clamp(32px,5.8vw,72px)}
}

/* head variant — split:
   title sits big on top (use <br> in caseTitle to control the wrap);
   below it: lead on the left, role+timeline stacked in the middle,
   scope on the right — all bottom-aligned. */
.case__head--split{
  grid-template-columns:1fr;
  gap:clamp(3rem,7vw,7rem);
}
.case__head--split .case__title{
  font-size:clamp(3.5rem,2rem + 10vw,13rem);
  letter-spacing:-.05em;line-height:.92;
}
.case__head--split .case__intro{
  display:grid;
  grid-template-columns:4fr 1fr;
  gap:clamp(2rem,4vw,4rem);
  align-items:end;
}
.case__head--split .case__lead{
  max-width:none;margin:0;
}
.case__head--split .case__meta{
  display:grid;
  grid-template-areas:
    "role  scope"
    "time  scope";
  grid-template-columns:1fr 1fr;
  gap:.6rem clamp(1.5rem,2vw,2.5rem);
  align-items:end;
}
.case__head--split .case__meta > div:nth-child(1){grid-area:role;grid-column:auto}
.case__head--split .case__meta > div:nth-child(2){grid-area:time;grid-column:auto}
.case__head--split .case__meta > div:nth-child(3){grid-area:scope;grid-column:auto}
@media (max-width:880px){
  .case__head--split .case__intro{
    display:flex;flex-direction:column;align-items:flex-start;gap:1.5rem;
  }
  .case__head--split .case__meta{display:flex;flex-direction:column;gap:1rem}
  .case__head--split .case__meta > div{grid-area:auto !important}
  .case__head--split .case__title{font-size:clamp(3rem,2rem + 7vw,9rem)}
}

.case__title{
  font-family:var(--sans);font-weight:700;
  font-size:clamp(3rem,2rem + 7vw,9rem);
  letter-spacing:-.045em;line-height:.95;margin:0;
}
.case__title em{font-family:var(--serif);font-style:italic;font-weight:400}
.case__intro{display:flex;flex-direction:column;gap:2rem}
.case__lead{
  font-size:clamp(1.1rem,1rem + .5vw,1.4rem);
  color:var(--ink-2);line-height:1.45;max-width:48ch;
}
.case__lead strong{color:var(--ink);font-weight:600}
.case__meta{
  display:grid;
  grid-template-columns:repeat(2,auto);
  gap:clamp(1.25rem,2.5vw,1.75rem) clamp(2rem,5vw,4rem);
}
.case__meta > div:nth-child(3){grid-column:1 / -1}
.case__meta dt{
  font-size:.75rem;color:var(--muted);
  letter-spacing:.08em;text-transform:uppercase;
  margin-bottom:.4rem;font-weight:500;
}
.case__meta dd{margin:0;font-weight:600;font-size:1.05rem}
@media (max-width:880px){.case__head{grid-template-columns:1fr}}
@media (max-width:760px){.case__meta{grid-template-columns:1fr;gap:1.25rem}}

/* award badge (Lifecake) */
.award-badge{
  display:inline-flex;align-items:center;gap:8px;
  padding:8px 14px;border-radius:999px;
  background:var(--ink);color:#ffe600;
  font-size:.78rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;
  margin-bottom:1rem;width:max-content;
}
.award-badge svg{width:14px;height:14px;color:#ffe600}

/* hero — image variant */
.case__hero-img{
  max-width:1400px;
  margin:0 auto;padding:0 var(--pad);
}
.case__hero-img img{
  width:100%;
  border-radius:24px;
  display:block;
  aspect-ratio:16/9;object-fit:cover;
  box-shadow:0 60px 90px -40px rgba(0,0,0,.18);
}
@media (max-width:760px){
  .case__hero-img{padding:0;max-width:none}
  .case__hero-img img{border-radius:0}
}

/* hero — coloured card variant (Reps, Skate Farm) */
.case__hero{
  position:relative;
  border-radius:32px;
  background:#0d0d0d;
  padding:clamp(3rem,7vw,6rem) clamp(2rem,5vw,4rem);
  overflow:hidden;
  display:grid;place-items:center;
  max-width:1400px;margin:0 auto;
  color:#fff;
}
.case__hero::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(800px 400px at 80% 0%, rgba(167,193,177,.18), transparent 65%),
    radial-gradient(600px 400px at 0% 100%, rgba(242,237,230,.06), transparent 60%);
  pointer-events:none;
}
.case__hero-grid{
  position:relative;z-index:2;
  display:grid;grid-template-columns:1.3fr 1fr;
  gap:clamp(2rem,5vw,4rem);align-items:center;
  width:100%;max-width:1100px;
}
.case__hero h2{
  font-family:var(--sans);font-weight:800;
  font-size:clamp(1.6rem,1rem + 2.5vw,2.6rem);
  line-height:1.05;letter-spacing:-.02em;
  margin:0 0 1rem;color:#fff;
}
.case__hero h2 em{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--accent-2)}
.case__hero p{
  margin:0;color:rgba(255,255,255,.75);
  font-size:clamp(.95rem,.9rem + .3vw,1.1rem);line-height:1.55;
  max-width:50ch;
}
.case__hero-stats{display:grid;grid-template-columns:1fr;gap:.85rem}
.hero-stat{
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.12);
  border-radius:14px;padding:1.1rem 1.25rem;
  backdrop-filter:blur(8px);
}
.hero-stat__num{
  font-family:var(--sans);font-weight:500;
  font-size:clamp(1.6rem,1rem + 1.5vw,2.4rem);
  line-height:1.05;letter-spacing:-.02em;color:#fff;
}
.hero-stat__num em{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--accent-2)}
.hero-stat__lab{font-size:.78rem;color:rgba(255,255,255,.65);margin-top:.45rem}
@media (max-width:760px){.case__hero-grid{grid-template-columns:1fr}}

/* editorial image features */
.case__feature{
  max-width:1400px;
  margin:clamp(3rem,5vw,5rem) auto;
  padding:0 var(--pad);
}
.case__feature img{width:100%;border-radius:20px;display:block}
.case__feature--full{max-width:none;padding:0;margin-left:0;margin-right:0}
.case__feature--full img{border-radius:0}

.case__split{
  max-width:1400px;
  margin:clamp(3rem,5vw,5rem) auto;
  padding:0 var(--pad);
  display:grid;grid-template-columns:1fr 1fr;
  gap:clamp(.75rem,1.5vw,1.5rem);
}
.case__split img{width:100%;border-radius:20px;display:block;aspect-ratio:4/3;object-fit:cover}
@media (max-width:760px){.case__split{grid-template-columns:1fr}}

.case__caption{
  font-size:.78rem;letter-spacing:.04em;text-transform:uppercase;
  color:var(--muted);margin:.85rem 0 0;
}

/* full-bleed images / videos */
.case__bleed{
  margin:calc(clamp(5rem,9vw,7rem) + 40px) 0 0;
  padding:0;
}
.case__bleed--top{margin-top:0}
.case__bleed img{
  width:100%;margin:0 auto;display:block;
  border-radius:0;
  box-shadow:0 40px 80px -40px rgba(0,0,0,.25);
}
.case__bleed--flat{margin:calc(clamp(5rem,9vw,7rem) + 28px) auto calc(clamp(5rem,9vw,7rem) + 40px);max-width:1400px;padding:0}
.case__bleed--flat img,.case__bleed--flat video{max-width:100%}
.case__bleed--flat img{box-shadow:none}
.case__bleed--flat video{width:100%;margin:0 auto;display:block;border-radius:clamp(8px,1vw,14px);box-shadow:0 40px 80px -40px rgba(0,0,0,.25)}
.case__bleed--flat figcaption{margin-top:clamp(.9rem,1.4vw,1.25rem);text-align:center;font-family:var(--serif);font-style:italic;font-size:clamp(.85rem,.8rem + .2vw,.95rem);color:var(--muted);letter-spacing:.01em}
.case__bleed--flat + .case__body{padding-top:0}
@media (max-width:760px){
  .case__bleed{padding:0 var(--pad)}
  .case__bleed img{border-radius:clamp(16px,2vw,28px);max-width:1600px}
  .case__bleed--top,.case__bleed--flat{padding:0}
  .case__bleed--top img{border-radius:0;max-width:none}
  .case__bleed--flat video{border-radius:0}
}

/* 2-up gallery */
.case__gallery{
  max-width:1400px;margin:calc(clamp(5rem,9vw,7rem) + 40px) auto 0;
  padding:0 var(--pad);
  display:grid;grid-template-columns:1fr 1fr;
  gap:clamp(1rem,2.5vw,2rem);
}
.case__gallery img{
  width:100%;height:100%;object-fit:cover;display:block;
  border-radius:clamp(16px,2vw,24px);
  box-shadow:0 30px 60px -35px rgba(0,0,0,.22);
}
@media (max-width:760px){
  .case__gallery{grid-template-columns:1fr}
  .case__gallery img:nth-child(2){display:none}
}

/* body */
.case__body{
  padding:clamp(6rem,11vw,9rem) var(--pad) 0;
  display:grid;grid-template-columns:1fr 2fr;
  gap:clamp(2rem,5vw,5rem);
  max-width:1400px;margin:0 auto;
}
.case__body + .case__body{padding-top:clamp(5rem,9vw,7rem)}
.case__body h2{
  font-family:var(--sans);font-weight:700;
  font-size:clamp(1.6rem,1.2rem + 1.5vw,2.4rem);
  letter-spacing:-.025em;line-height:1.05;margin:0;
}
.case__body h2 em{font-family:var(--serif);font-style:italic;font-weight:400}
.case__body__copy{
  display:flex;flex-direction:column;gap:1.85rem;
  font-size:clamp(1.05rem,1rem + .35vw,1.2rem);
  color:var(--ink-2);line-height:1.7;max-width:62ch;
}
.case__body__copy p{margin:0}
.case__body__copy strong{color:var(--ink);font-weight:600}
.case__body__copy em{font-family:var(--serif);font-style:italic}
.case__body__copy ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:calc(.65rem - 2px)}
@media (min-width:881px){.case__body__copy{line-height:29px}.case__body__copy ul{gap:calc(.65rem - 6px)}}
.case__body__copy ul li{padding-left:1em;position:relative}
.case__body__copy ul li::before{content:"·";position:absolute;left:0;color:var(--accent);font-weight:800}
.case__body__copy .case__sub{
  margin-top:2.6rem;margin-bottom:-1.1rem;
  font-size:clamp(1.1rem,1rem + .4vw,1.28rem);
  letter-spacing:-.01em;
  color:var(--ink);font-weight:700;
}
.case__body__copy .case__sub:first-child{margin-top:-.4rem}
@media (max-width:880px){.case__body{grid-template-columns:1fr}}

/* outcomes */
.outcomes{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:clamp(1rem,2.5vw,2rem);
  padding:clamp(4rem,8vw,7rem) var(--pad);
  max-width:1400px;margin:0 auto;
}
.outcome{
  background:var(--paper);border:1px solid var(--line);
  border-radius:24px;padding:clamp(1.5rem,2.5vw,2rem);
  display:flex;flex-direction:column;gap:.75rem;
}
.outcome__num{
  font-family:var(--sans);font-weight:800;
  font-size:clamp(2.5rem,1.5rem + 3.5vw,4.5rem);
  line-height:1;letter-spacing:-.04em;color:var(--ink);
}
.outcome__num em{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--accent)}
.outcome__lab{font-size:.95rem;color:var(--muted)}
@media (max-width:760px){.outcomes{grid-template-columns:1fr}}

/* next */
.next{
  padding:clamp(4rem,8vw,7rem) var(--pad);
  text-align:center;border-top:1px solid var(--line);
}
.next__eyebrow{
  font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);margin-bottom:1rem;font-weight:500;
}
.next__title{
  font-family:var(--sans);font-weight:700;
  font-size:clamp(2.5rem,1.5rem + 5vw,6rem);
  letter-spacing:-.04em;line-height:1;margin:0;
}
.next__title em{font-family:var(--serif);font-style:italic;font-weight:400}
.next a.next__cta{
  display:inline-flex;align-items:center;gap:8px;
  margin-top:2rem;padding:14px 26px;border-radius:999px;
  background:var(--ink);color:var(--paper);
  font-weight:500;
  transition:transform .25s var(--ease);
}
.next a.next__cta:hover{transform:translateY(-2px)}

/* pull quote — for occasional editorial breaks between body sections */
.case__quote{
  max-width:1400px;
  margin:clamp(4rem,8vw,7rem) auto;
  padding:0 var(--pad);
  text-align:center;
}
.case__quote p{
  font-family:var(--serif);font-style:italic;font-weight:400;
  font-size:clamp(1.6rem,1.2rem + 1.4vw,2.6rem);
  line-height:1.3;letter-spacing:-.01em;
  color:var(--ink);
  margin:0 auto;max-width:32ch;
}
.case__quote cite{
  display:block;margin-top:1.25rem;
  font-style:normal;font-family:var(--sans);
  font-size:.85rem;letter-spacing:.04em;color:var(--muted);
}

/* scroll-reveal animation for body sections */
.reveal{opacity:0;transform:translate3d(0,18px,0);transition:opacity .9s var(--ease), transform .9s var(--ease);will-change:opacity,transform}
.reveal.is-in{opacity:1;transform:translate3d(0,0,0)}
@media (prefers-reduced-motion: reduce){.reveal{opacity:1;transform:none;transition:none}}

/* mobile rhythm — editorial spacing */
@media (max-width:760px){
  .case__body{padding-top:clamp(4.5rem,10vw,6rem)}
  .case__body + .case__body{padding-top:clamp(4rem,9vw,5.5rem)}
  .case__hero{border-radius:0;margin-top:clamp(4rem,9vw,5.5rem) !important}
  .case__bleed--flat{margin:clamp(4rem,9vw,5.5rem) auto clamp(4.5rem,10vw,6rem)}
  .case__gallery{margin-top:clamp(4rem,9vw,5.5rem)}
  .outcomes{padding:clamp(3.5rem,8vw,5rem) var(--pad)}
}

/* @shared: terms-footer */
.terms-footer{padding:clamp(3rem,6vw,5rem) var(--pad) 2rem;border-top:1px solid var(--line);max-width:1400px;margin:0 auto}
.terms-footer__bottom{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;font-size:.85rem;color:var(--muted)}
@media (max-width:760px){.terms-footer__bottom{justify-content:center;text-align:center;gap:.25rem}}
/* @end-shared */

/* @shared: secret-footer */
/* ===================================================== secret footer */
.secret-footer{
  position:fixed;left:0;right:0;bottom:0;
  height:62vh;z-index:1;
  background:#070707;
  background-image:
    linear-gradient(to right, rgba(255,255,255,.05) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,.05) 1px, transparent 1px);
  background-size:32px 32px;
  color:#fff;overflow:hidden;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:6vh var(--pad);
  cursor:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><circle cx='16' cy='16' r='13' fill='%23fde047' stroke='%23000' stroke-width='1.6'/><circle cx='12' cy='13' r='1.6' fill='%23000'/><circle cx='20' cy='13' r='1.6' fill='%23000'/><path d='M10.5 18.5 Q16 24 21.5 18.5' stroke='%23000' stroke-width='1.8' fill='none' stroke-linecap='round'/></svg>") 16 16, default;
}
.secret-footer *{
  cursor:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><circle cx='16' cy='16' r='13' fill='%23fde047' stroke='%23000' stroke-width='1.6'/><circle cx='12' cy='13' r='1.6' fill='%23000'/><circle cx='20' cy='13' r='1.6' fill='%23000'/><path d='M10.5 18.5 Q16 24 21.5 18.5' stroke='%23000' stroke-width='1.8' fill='none' stroke-linecap='round'/></svg>") 16 16, pointer;
}
.secret-footer__eyebrow{
  position:absolute;top:9vh;left:50%;
  width:max-content;max-width:90vw;
  margin-left:auto;
  font-size:.85rem;font-weight:500;
  letter-spacing:.08em;
  color:rgba(255,255,255,.6);
  text-align:center;margin:0;line-height:1.4;
  transform:translateX(-50%) translateY(-15px) scale(.85);
}
.secret-footer__head{
  font-family:var(--serif);
  font-weight:400;font-style:italic;
  font-size:clamp(2.6rem,1.4rem + 7vw,8rem);
  line-height:1;letter-spacing:-.01em;
  margin:0;position:relative;text-align:center;
  opacity:0;transform:scale(.55);
}
.secret-footer__head em{font-style:italic;color:#fff}
.secret-footer__head .nonit{font-style:normal;font-weight:400;font-family:var(--serif)}
.secret-footer.is-revealed .secret-footer__head{
  animation:
    headReveal 1s cubic-bezier(.34,1.5,.64,1) forwards,
    headBounce 4.5s ease-in-out 1.05s infinite;
}
@keyframes headReveal{
  to{opacity:1;transform:scale(1)}
}
@keyframes headBounce{
  0%,100%{transform:scale(1) translateY(0)}
  50%{transform:scale(1) translateY(-10px)}
}
.secret-pill{
  position:absolute;
  display:inline-flex;align-items:center;
  padding:7px 14px;border-radius:999px;
  background:#070707;border:1px solid rgba(255,255,255,.3);
  color:#fff;
  font-family:var(--sans);font-size:.72rem;font-weight:600;letter-spacing:.06em;
  text-transform:uppercase;white-space:nowrap;
  opacity:0;
}
.secret-pill--cmon{top:-30%;left:6%}
.secret-pill--just{top:-12%;left:14%;bottom:auto}
.secret-footer.is-revealed .secret-pill--cmon{
  animation:
    pillIn .6s cubic-bezier(.34,1.6,.64,1) .55s forwards,
    floatA 3.4s ease-in-out 1.2s infinite;
}
.secret-footer.is-revealed .secret-pill--just{
  animation:
    pillIn .6s cubic-bezier(.34,1.6,.64,1) .7s forwards,
    floatB 3.8s ease-in-out 1.35s infinite;
}
@keyframes pillIn{
  from{opacity:0;transform:scale(.4) rotate(0deg)}
  to{opacity:1;transform:scale(1) rotate(var(--pill-r))}
}
.secret-pill--cmon{--pill-r:-9deg}
.secret-pill--just{--pill-r:6deg}
@keyframes floatA{
  0%,100%{transform:translateY(0) rotate(-9deg)}
  50%{transform:translateY(-10px) rotate(-13deg)}
}
@keyframes floatB{
  0%,100%{transform:translateY(0) rotate(6deg)}
  50%{transform:translateY(-7px) rotate(10deg)}
}

.secret-footer__bottom{
  position:absolute;bottom:8vh;left:50%;
  transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:.85rem;
  width:max-content;max-width:90vw;
  text-align:center;
}
.secret-footer__cta{
  display:inline-flex;align-items:center;gap:8px;
  padding:14px 26px;border-radius:999px;
  background:#fff;color:#000;
  text-decoration:none;font-weight:600;font-size:.95rem;
  transition:transform .55s cubic-bezier(.34,1.5,.64,1), background .35s var(--ease), padding .55s cubic-bezier(.34,1.5,.64,1);
  opacity:0;transform:translateY(20px) scale(.85);
}
.secret-footer.is-revealed .secret-footer__cta{
  animation:elemIn .8s cubic-bezier(.34,1.5,.64,1) .55s forwards;
}
.secret-footer__cta:hover{
  transform:translateY(-6px) scale(1.14) rotate(-1deg)!important;
  background:#fde047;
  padding:16px 32px;
  box-shadow:0 18px 40px -12px rgba(253,224,71,.55);
}
.secret-footer__cta:active{
  transform:translateY(-2px) scale(1.06) rotate(0deg)!important;
  transition:transform .12s var(--ease);
}
.secret-footer__cta .arr{
  display:inline-block;
  transition:transform .55s cubic-bezier(.34,1.5,.64,1);
}
.secret-footer__cta:hover .arr{transform:translate(4px,-4px) rotate(8deg)}

.secret-footer__tag{
  font-size:14px;color:rgba(255,255,255,.55);
  margin:0;line-height:1.4;font-family:var(--sans);
  white-space:nowrap;
  opacity:0;transform:translateY(15px);
}
.secret-footer.is-revealed .secret-footer__tag{
  animation:elemIn .8s var(--ease) .8s forwards;
}

.secret-footer__eyebrow{opacity:0}
.secret-footer.is-revealed .secret-footer__eyebrow{
  animation:eyebrowIn .8s cubic-bezier(.34,1.5,.64,1) .35s forwards;
}
@keyframes eyebrowIn{
  from{opacity:0;transform:translateX(-50%) translateY(-15px) scale(.85)}
  to{opacity:1;transform:translateX(-50%) translateY(0) scale(1)}
}

@keyframes elemIn{
  to{opacity:1;transform:translateY(0) scale(1)}
}

/* secret footer mobile fixes */
@media (max-width:720px){
  body{padding-bottom:54vh}
  .secret-footer{
    height:54vh;
    padding:4vh 1rem;
  }
  .secret-footer__eyebrow{
    top:4vh;
    font-size:.7rem;
    letter-spacing:.06em;
    line-height:1.4;
  }
  .secret-footer__head{
    font-size:clamp(1.55rem,7vw,2.4rem);
    line-height:1.1;
    padding:0 1.25rem;
    max-width:100%;
    overflow-wrap:break-word;
  }
  /* faster, snappier reveal so it doesn't sit on a black void */
  .secret-footer.is-revealed .secret-footer__head{
    animation:
      headReveal .55s cubic-bezier(.34,1.6,.64,1) forwards,
      headBounce 4.5s ease-in-out .6s infinite;
  }
  .secret-footer.is-revealed .secret-footer__eyebrow{
    animation:eyebrowIn .5s cubic-bezier(.34,1.6,.64,1) .15s forwards;
  }
  .secret-footer.is-revealed .secret-footer__cta{
    animation:elemIn .55s cubic-bezier(.34,1.6,.64,1) .3s forwards;
  }
  .secret-footer.is-revealed .secret-footer__tag{
    animation:elemIn .55s var(--ease) .45s forwards;
  }
  /* keep the floating pills on mobile for the magic — just reposition
     so they sit clear of the headline */
  .secret-pill{
    display:inline-flex;
    font-size:.62rem;
    padding:6px 12px;
  }
  .secret-pill--cmon{top:-58%;left:4%}
  .secret-pill--just{top:-30%;left:18%;bottom:auto;right:auto}
  .secret-footer.is-revealed .secret-pill--cmon{
    animation:
      pillIn .5s cubic-bezier(.34,1.6,.64,1) .3s forwards,
      floatA 3.4s ease-in-out .85s infinite;
  }
  .secret-footer.is-revealed .secret-pill--just{
    animation:
      pillIn .5s cubic-bezier(.34,1.6,.64,1) .42s forwards,
      floatB 3.8s ease-in-out 1s infinite;
  }
  .secret-footer__bottom{
    bottom:calc(env(safe-area-inset-bottom, 0px) + 36px);
    width:100%;left:0;right:0;transform:none;
    max-width:none;
    align-items:center;
  }
  .secret-footer__cta{
    padding:13px 24px;font-size:.9rem;
  }
  .secret-footer__tag{
    font-size:.7rem;
    white-space:nowrap;text-align:center;
  }
}
/* @end-shared */
</style>
{% endblock %}

{% block content %}
<div class="page">

{% include "partials/nav.njk" %}

<nav class="back" aria-label="Back navigation">
  <a href="index.html#work">← Back to work</a>
</nav>

<header class="case__head{% if headVariant %} case__head--{{ headVariant }}{% endif %}">
  <h1 class="case__title">{{ caseTitle | safe }}</h1>
  <div class="case__intro">
    {%- if caseAward %}
    <span class="award-badge">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l2.39 4.84L19.6 7.6l-3.8 3.7.9 5.24L12 14.08l-4.7 2.46.9-5.24-3.8-3.7 5.21-.76z"/></svg>
      {{ caseAward }}
    </span>
    {%- endif %}
    <p class="case__lead">{{ caseLead | safe }}</p>
    <dl class="case__meta">
      <div><dt>Role</dt><dd>{{ meta.role | safe }}</dd></div>
      <div><dt>Timeline</dt><dd>{{ meta.timeline }}</dd></div>
      <div><dt>Scope</dt><dd>{{ meta.scope | safe }}</dd></div>
    </dl>
  </div>
</header>

{{ content | safe }}
{% block caseBody %}{% endblock %}

{% if prev or next %}
{%- if prev %}
<section class="next">
  <p class="next__eyebrow">Previous project</p>
  <h2 class="next__title">{{ prev.title | safe }}</h2>
  <a class="next__cta" href="{{ prev.slug }}">← View case study</a>
</section>
{%- endif %}
{%- if next %}
<section class="next" style="border-top:none;padding-top:calc(clamp(4rem,8vw,7rem) - 30px)">
  <p class="next__eyebrow">Next project</p>
  <h2 class="next__title">{{ next.title | safe }}</h2>
  <a class="next__cta" href="{{ next.slug }}">View case study →</a>
</section>
{%- endif %}
{% endif %}

{% include "partials/terms-footer.njk" %}
</div><!-- /.page -->

{% include "partials/secret-footer.njk" %}

<script>
(() => {
  const nav = document.querySelector(".nav");
  if (!nav) return;
  let lastY = window.scrollY, ticking = false;
  const updateNav = () => {
    const y = window.scrollY;
    const delta = y - lastY;
    if (y < 24) {
      nav.classList.remove("is-floating", "is-hidden");
      nav.classList.add("is-pinned");
    } else if (delta > 6) {
      nav.classList.add("is-hidden");
      nav.classList.remove("is-floating", "is-pinned");
    } else if (delta < -6) {
      nav.classList.remove("is-hidden", "is-pinned");
      nav.classList.add("is-floating");
    }
    lastY = y;
    ticking = false;
  };
  window.addEventListener("scroll", () => {
    if (!ticking) { requestAnimationFrame(updateNav); ticking = true; }
  }, { passive: true });
  updateNav();
})();

(() => {
  const targets = document.querySelectorAll(".case__bleed:not(.case__bleed--top), .case__body, .case__hero, .case__hero-img, .case__gallery, .case__feature, .case__split, .outcomes, .next");
  targets.forEach(el => el.classList.add("reveal"));
  if (!("IntersectionObserver" in window)) {
    targets.forEach(el => el.classList.add("is-in"));
    return;
  }
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.classList.add("is-in");
        io.unobserve(e.target);
      }
    }
  }, { rootMargin: "0px 0px -10% 0px", threshold: 0.08 });
  targets.forEach(el => io.observe(el));
})();

(() => {
  const secretEl = document.querySelector(".secret-footer");
  if (!secretEl) return;
  const checkReveal = () => {
    const docH = document.documentElement.scrollHeight;
    const winH = window.innerHeight;
    const remaining = docH - winH - window.scrollY;
    secretEl.classList.toggle("is-revealed", remaining < winH * 0.18);
  };
  window.addEventListener("scroll", checkReveal, { passive: true });
  window.addEventListener("resize", checkReveal);
  checkReveal();
})();
</script>
{% endblock %}
